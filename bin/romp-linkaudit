#!/usr/bin/env python3
"""romp-linkaudit — a rigorous, read-only audit of feed/ledger → chat deep-links.

For every goal node of a session it computes the SAME deep-link anchor build_feed emits
(the trail segment's reply/work uuid) and resolves WHERE that anchor lands in the parsed
transcript, then flags the failure modes that make a click land on the wrong place — so a
mislink is something you SEE in a report, not something you eyeball in the UI.

Flags per node:
  NULL_ANCHOR  — no anchorUuid (build_feed couldn't resolve the seg) → the chat would fall
                 back to nearest-TIME, i.e. a heuristic guess (the thing we want to kill).
  ORPHAN_UUID  — anchorUuid is set but not present in the parsed transcript → scrollToAnchor
                 finds no matching turn → same time fallback.
  COARSE_TURN  — the anchor lands in a turn that packs >1 segment, so a turn-granularity
                 scroll can land on the WRONG segment within the right-ish turn.
  ok           — anchor resolves to a single-segment turn (the precise, trustworthy case).

Usage:
  romp-linkaudit                # audit every LIVE tmux session
  romp-linkaudit <sid|name>     # audit one session
  romp-linkaudit --flagged      # only print nodes that are not 'ok'
No writes, no network. Snippets are truncated; this is a local debugging tool.
"""
import os, sys, time, subprocess
from importlib.machinery import SourceFileLoader

HERE = os.path.dirname(os.path.realpath(__file__))
km = SourceFileLoader("romp_kernel", os.path.join(HERE, "romp-kernel")).load_module()
jd = SourceFileLoader("romp_judge", os.path.join(HERE, "romp-judge")).load_module()
em = SourceFileLoader("romp_event_model", os.path.join(HERE, "romp-event-model")).load_module()


def _live_sids():
    try:
        out = subprocess.run(["tmux", "list-sessions", "-F", "#{@romp-session-id}"],
                             capture_output=True, text=True, timeout=5).stdout
    except Exception:
        return []
    return [l.strip() for l in out.splitlines() if l.strip()]


def _atom_text(atom):
    msg = atom.get("message") or {}
    c = msg.get("content")
    parts, img = [], False
    if isinstance(c, str):
        parts.append(c)
    elif isinstance(c, list):
        for b in c:
            if not isinstance(b, dict):
                continue
            t = b.get("type")
            if t == "text":
                parts.append(b.get("text", ""))
            elif t == "image":
                img = True; parts.append("[IMAGE]")
            elif t == "tool_use":
                parts.append("[tool:%s]" % b.get("name"))
            elif t == "tool_result":
                parts.append("[tool_result]")
    return " ".join(parts)[:64].replace("\n", " "), img


def audit_session(sid, flagged_only=False):
    path = next((str(p) for f, p, a, n in jd.discover(int(time.time())) if f == sid), None)
    if not path:
        print("  (no transcript in the discover window)"); return (0, 0)
    now = int(time.time())
    sess = km._parse(path, sid, now)
    # uuid -> (turn#, role, has_image, snippet); seg_count per turn for the COARSE flag
    uuid_loc, seg_count = {}, {}
    for ti, turn in enumerate(sess["turns"]):
        segs = em.segments(turn)
        seg_count[ti] = len(segs)
        for atom in turn["atoms"]:
            u = atom.get("uuid")
            if u:
                snip, img = _atom_text(atom)
                uuid_loc[u] = (ti, atom.get("type"), img, snip)
    # seg_id -> anchor uuid, exactly as build_feed (reply preferred, else work)
    seg_uuid = {}
    for turn in sess["turns"]:
        for seg in em.segments(turn):
            w, r = km._seg_anchors(seg["atoms"])
            seg_uuid[seg["id"]] = r or w
    store = jd.load_goals(sid)
    nodes = store.get("nodes", {})
    tally = {"ok": 0, "NULL_ANCHOR": 0, "ORPHAN_UUID": 0, "COARSE_TURN": 0}
    for nid, nd in nodes.items():
        if nd.get("cleared"):
            continue
        blocked, done = nd.get("blocked"), nd.get("nodeComplete")
        st = "question" if blocked else ("done" if done else "open")
        trail = nd.get("trail") or []
        aseg = (trail[-1] if st in ("done", "question") else trail[0]) if trail else None
        auuid = seg_uuid.get(aseg)
        if not auuid:
            flag, loc = "NULL_ANCHOR", None
        elif auuid not in uuid_loc:
            flag, loc = "ORPHAN_UUID", None
        else:
            loc = uuid_loc[auuid]
            flag = "COARSE_TURN" if seg_count.get(loc[0], 1) > 1 else "ok"
        tally[flag] += 1
        if flagged_only and flag == "ok":
            continue
        print("  [%-11s] %-9s %r" % (flag, st, nd.get("text", "")[:48]))
        if loc:
            print("                 -> turn#%d %s seg/turn=%d %s%r"
                  % (loc[0], loc[1], seg_count.get(loc[0], 1), "IMAGE " if loc[2] else "", loc[3]))
    return tally


def main():
    args = [a for a in sys.argv[1:] if not a.startswith("--")]
    flagged_only = "--flagged" in sys.argv[1:]
    if args:
        target = args[0]
        sid = target if "-" in target and len(target) > 20 else \
            next((s for s in _live_sids() if km._name_of(s) == target), target)
        targets = [sid]
    else:
        targets = _live_sids()
    grand = {"ok": 0, "NULL_ANCHOR": 0, "ORPHAN_UUID": 0, "COARSE_TURN": 0}
    for sid in targets:
        print("\n=== %s (%s) ===" % (km._name_of(sid) or sid[:8], sid[:8]))
        t = audit_session(sid, flagged_only)
        if isinstance(t, dict):
            for k in grand:
                grand[k] += t.get(k, 0)
    total = sum(grand.values()) or 1
    print("\n=== TOTALS: %d nodes | ok=%d  NULL_ANCHOR=%d  ORPHAN_UUID=%d  COARSE_TURN=%d"
          % (total, grand["ok"], grand["NULL_ANCHOR"], grand["ORPHAN_UUID"], grand["COARSE_TURN"]))
    print("    (%d%% of links would fall back to a time/heuristic guess or land coarsely)"
          % round(100 * (total - grand["ok"]) / total))


if __name__ == "__main__":
    main()
