#!/usr/bin/env python3
"""romp-summarize-backfill — fill in the Haiku summaries that the hook can't.

The romp-summarize.sh hook fires on UserPromptSubmit (typed prompts) + Stop (the
last reply). It MISSES: queued prompts (Claude Code doesn't fire UserPromptSubmit
for them) and the intermediate replies of a drained queue. It also doesn't touch
inter-session messages. This watcher reads the source of truth — each session's
transcript and the postal message log — and backfills every missing summary, so
the timeline shows a Haiku phrase for EVERY prompt (typed or queued) and every
message, not the raw text.

It writes the SAME per-session history the hook/timeline already use
(~/.local/state/romp/summaries/<sid>.jsonl, keyed at the event's transcript
timestamp so it binds to the right dot), plus a message-summary cache
(~/.local/state/romp/timeline/message-summaries.jsonl: {id, summary}). It only
generates what's missing (dedup by timestamp/id), so it complements the hook
rather than duplicating it.

It is also the SINGLE WRITER of the request registry (~/.local/state/romp/requests/)
— the intent layer's store: the user's asks (roots), agent→agent delegations (internal
nodes), and reply→request links. Capture and linking FUSE into the same three model
calls above (request / reply / message); zero extra calls. Schema + read-time fold
rules: ~/.local/state/romp/REQUESTS.md (feed_design's spec).

Usage:
  romp-summarize-backfill            # daemon: loop, backfilling, until idle
  romp-summarize-backfill --once     # a single pass (used by the Stop hook)
  romp-summarize-backfill --ensure   # spawn the daemon if not already running
"""
import json, os, re, sys, time, subprocess, signal, select
import importlib.machinery, importlib.util
from pathlib import Path

# The ONE boundary extractor (shared with the timeline). We no longer parse transcripts here:
# events_for() gives the same work-period events the timeline draws, each with a stable id and
# its reply-summary record — so summaries key by event id and bind by id (no time windows).
_evld = importlib.machinery.SourceFileLoader("romp_events", str(Path(__file__).resolve().parent / "romp-events"))
_evsp = importlib.util.spec_from_loader("romp_events", _evld)
romp_events = importlib.util.module_from_spec(_evsp); _evld.exec_module(romp_events)
events_for = romp_events.events_for
_is_peer_banner = romp_events._is_peer_banner
_proj_dir = romp_events._proj_dir   # realpath-first launch-dir → transcript-project-dir munge

HOME    = Path.home()
STATE   = Path(os.environ.get("XDG_STATE_HOME", str(HOME / ".local/state"))) / "romp"
NAMES   = STATE / "names"
SUMDIR  = STATE / "summaries"
MSGLOG  = STATE / "timeline" / "messages.jsonl"
MSGSUM  = STATE / "timeline" / "message-summaries.jsonl"
PROJECTS = HOME / ".claude" / "projects"
PIDFILE = STATE / "summarize-backfill.pid"
LOGFILE = STATE / "summarize-backfill.log"

WINDOW    = 6 * 3600     # only backfill turns/messages from the last N hours
INTERVAL  = 5            # poll-fallback seconds (kqueue wakes us instantly on a write; this is the backstop)
DEDUP     = 20           # a summary within this many seconds of an item = already done (same
                         # event is keyed within ~1-2s by the hook/backfill; >20s apart = a
                         # DISTINCT event that must get its own summary, not be merged away)
PER_PASS  = 16           # max Haiku calls gathered per pass
PER_SESSION = 5          # …of which at most this many from any ONE session, so a backlogged
                         # session can't hog the whole pass and starve the others
CONCURRENCY = 10         # Haiku calls run this many at a time (parallel)
FINAL_FALLBACK = 120     # only if @claude-state is unavailable: treat a turn idle this long as done (deep backstop)
DEBOUNCE  = 0.8          # min seconds between passes, so a burst of writes coalesces into one pass
IDLE_EXIT = 20 * 60      # daemon exits after this long with no romp session activity
SUMMARY_MODEL = "claude-sonnet-4-6"   # The user's call: Sonnet across the whole pipeline (was Haiku)
BRIEF_MODEL = "claude-opus-4-8"       # the auditor (2026-06-11): ~30 calls/day vs ~470 for the
                                      # per-turn callers, and it DEMOTES with authority — worth Opus

# Eager feed-detail: keep each deliverable's expand-paragraph warm BEFORE the user expands it.
# Generation is delegated to romp-feed-detail as a DETACHED subprocess so its ~6-10s Sonnet call
# never blocks the as-you-go summary loop (the user's priority). Bounded per pass; drains newest-first.
FEED_DETAIL_SCRIPT = Path(__file__).resolve().parent / "romp-feed-detail"
FEED_DETAIL_DIR = STATE / "feed-detail"
FEED_DETAIL_WINDOW = 24 * 3600   # only pre-warm deliverables this recent (the feed's display horizon)
FEED_DETAIL_MAX_INFLIGHT = 4     # cap CONCURRENT feed-detail gens (passes fire faster than a gen finishes,
                                 # so this bounds total in-flight, not just per-pass — no thundering herd)
FEED_DETAIL_COOLDOWN = 90        # don't re-spawn the same id within this window (a gen call is in flight)

# Decision briefs: when a link lands with relevance=DECISION, prewarm a brief telling the user
# WHAT to decide (context from the request-DAG chain + the asking reply) instead of a list of
# events. Same detached-generator pattern as feed-detail; the generator is THIS script in
# --brief <reply_id> mode, so all registry/llm plumbing stays in one brain. Consumers:
# vs_chat's decision sub-card, romp-feed --asks.
SELF_SCRIPT = Path(__file__).resolve()
BRIEF_DIR = STATE / "decision-brief"
BRIEF_WINDOW = 24 * 3600         # sweep horizon for missed/pre-crash briefs (matches feed-detail)
BRIEF_MAX_INFLIGHT = 3           # DECISIONs are a few/hour — small cap is plenty
BRIEF_COOLDOWN = 90

# Request registry (the intent layer): requests/ is the request-DAG store this daemon
# single-writes — the user's asks (roots), agent→agent delegations (internal nodes), and
# reply→request links. Surfaces fold these tiny jsonl files by id at read time; the ONLY
# user-facing resolution is the user's Clear (cleared.jsonl, written by the feed UI, read
# here just to drop cleared asks from candidate sets). All sid fields are ANCHOR session
# ids (@romp-session-id); event-derived ids (turn_id/reply_id) embed transcript fsids.
REQDIR  = STATE / "requests"
NODESF  = REQDIR / "nodes.jsonl"        # ask | internal | parents | amend records (this daemon only)
LINKSF  = REQDIR / "links.jsonl"        # reply→request link records (this daemon only)
CLEARF  = REQDIR / "cleared.jsonl"      # The user's Clear — UI-owned; READ-ONLY here
DECLOG  = REQDIR / "decision-log.jsonl" # every link/parents decision + its candidate set
REQUESTS_FLOOR = 1781036800  # ship-time floor (2026-06-09): no nodes/links for earlier work
CAND_CAP   = 12              # newest open received-requests offered to the linker
DECLOG_MAX = 2_000_000       # rotate the decision log past this size (~30-50KB/day)


