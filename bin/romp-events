#!/usr/bin/env python3
"""romp-events — the SINGLE source of truth for a romp session's work-period events.

Every consumer (the romp -g Python timeline, the vault-code Obsidian/VS Code timeline,
and the Haiku summary backfill) reads ITS boundaries from here instead of re-parsing the
transcript. That collapses what used to be three byte-identical parsers into one, and —
because each event carries a STABLE ID — lets summaries bind by id-equality instead of a
fuzzy time window (which is what caused the forward-bleed + dedup bugs).

A transcript is parsed into PROCESS-START events: the moments work actually began on the
single thread. Each is a work period [t, next.t). Boundary kinds:
  typed     — a typed prompt (idle → processed immediately)
  queued    — a queued prompt dequeued into a standalone turn
  absorbed  — an enqueue folded mid-turn (queue `remove`); process-start = the fold ts
  drain     — a Stop-hook-drained inbound message ('Stop hook feedback:' line)
  decision  — a mid-turn user decision (AskUserQuestion answer / ExitPlanMode approve|reject), which
              steers like a new prompt; process-start = the tool_result ts (when the user decided)
plus `pending` = still-queued enqueues (a dot that rides `now`, no bar yet).

CLI:
  romp-events --emit                 # JSON {sid: {name, events, pending}} for live sessions
  romp-events --test <sid> <path>    # human dump of one transcript's events
"""
import json, os, re, sys, time, hashlib, subprocess
from datetime import datetime
from pathlib import Path

HORIZON  = 48 * 3600                 # how far back to read transcripts (matches the slider max)
IDLE_GAP = 15 * 60                   # a silence this long between a period's assistant lines = the session
                                     # went idle/dead; lines after it belong to a later turn, so clip there
REPLY_MEAT = 160                     # replyUuid prefers the last text block at least this long — a click on a
                                     # deliverable should land on its prose, not a closing one-liner
HOME     = Path.home()
STATE    = Path(os.environ.get("XDG_STATE_HOME", str(HOME / ".local/state"))) / "romp"
NAMES    = STATE / "names"
PROJECTS = HOME / ".claude" / "projects"

def _proj_dir(d):
    """Claude's transcript project dir for a launch dir. realpath() first: a session launched
    in a SYMLINKED dir (e.g. ~/Vault → ~/GitRepos/Vault) writes transcripts under the PHYSICAL
    cwd's mangled path, so mangling the raw symlink would point at a dir that doesn't exist."""
    return PROJECTS / re.sub(r"[/.]", "-", os.path.realpath(d))

def parse_z(s):                      # transcript timestamps: ISO-8601 UTC ("…Z")
    if not s:
        return None
    s = s.strip().replace("Z", "+0000")
    for fmt in ("%Y-%m-%dT%H:%M:%S.%f%z", "%Y-%m-%dT%H:%M:%S%z"):
        try: return int(datetime.strptime(s, fmt).timestamp())
        except Exception: pass
    return None

def _text_of(c):
    if isinstance(c, str):
        return c
    if isinstance(c, list):
        return " ".join(b.get("text", "") for b in c if isinstance(b, dict) and b.get("type") == "text")
    return ""

def _eid(sid, t, text):
    """A stable, unique event id: session + process-start ts + a short content hash (so two
    boundaries in the same one-second tick can't collide). Same event → same id, always."""
    h = hashlib.sha1((text or "").encode("utf-8", "replace")).hexdigest()[:8]
    return "%s:%d:%s" % (sid, t, h)

def _is_peer_banner(flat):
    """A pushed-mail banner (drawn as an inter-session connector, not its own prompt dot)."""
    return ("romp-msg-id" in flat or flat.startswith("####################") or "\U0001F4EC" in flat)

def _strip_banner(t):
    """Cosmetic strip of a pushed-mail banner from a boundary's DISPLAY text: drop the #### rules, the
    '📬 from <sender> · <time>' header, the romp-msg-id marker, and the '(to reply: …)' hint, leaving
    the message body. The event id + mids are taken from the RAW text upstream (see the events loop),
    so this only changes what's SHOWN and the summary input — never the id, so existing summaries stay
    bound. This is the cosmetic floor for unlogged/fallback turns; a logged-message consumer can still
    swap in the exact structured body by joining on mids."""
    if "####" not in t and "\U0001F4EC" not in t:           # not a banner — leave it alone
        return t
    # maildir-fallback drain: 'Stop hook feedback: 📬 New message(s) … — from <sender> (<ISO>): <body>'
    t = re.sub(r"Stop hook feedback:\s*\U0001F4EC\s*New message\(s\).*?from\s+\S+\s*\([^)]+\):\s*", " ", t)
    t = re.sub(r"<!--\s*romp-msg-id:[^>]*-->", " ", t)       # the id marker (if inside the window)
    t = re.sub(r"\(to reply:[^)]*\)?", " ", t)               # the reply hint
    t = re.sub(r"#{2,}", " ", t)                             # the rule lines + header '##'
    t = re.sub(r"\U0001F4EC\s*from\s+\S+\s*·\s*\d{1,2}:\d{2}", " ", t)  # 'from <sender> · 10:19' (stop AT the time so the FYI/ASK/Q intent label survives)
    return " ".join(t.split()).strip()

def _is_harness_injected(flat):
    """Harness plumbing that rides the enqueue→remove queue like a typed mid-turn message but is
    NOT a user ask — a background Task/Agent completion (`<task-notification>`). It must produce
    neither a prompt dot (absorbed boundary) nor a pending dot: the session's response to it is a
    continuation of the ask that spawned the task, so it folds into the adjacent work period."""
    return flat.lstrip().startswith("<task-notification>")

def _reply_record(user, blocks):
    """The reply-summary input for a period: what the user asked + the assistant's prose +
    tools used. The Haiku reply summarizer turns this into one past-tense phrase. None if the
    period has no assistant activity yet (nothing to summarize)."""
    if not blocks:
        return None
    a_text = " ".join(b[1] for b in blocks if b[1]).strip()   # block = (ts, text, tools, uuid)
    rec = "USER ASKED: " + (user or "")[:300]
    if a_text:
        rec += "\nASSISTANT SAID: " + a_text[-1500:]
    tools = []
    for b in blocks:
        for t in b[2]:
            if t not in tools:
                tools.append(t)
    if tools:
        rec += "\nTOOLS USED: " + ", ".join(tools[:12])
    return rec

# A user decision made through one of these tools mid-turn is, semantically, a NEW prompt: the
# answer / approved-or-rejected plan steers everything after it. So we split the turn there (see
# extract_events) and emit a synthetic boundary, which the dot/summary/digest machinery then
# handles exactly like a typed prompt — no downstream special-casing. (Permission allow/deny is
# deliberately NOT here: there's no post-choice transcript line to anchor, and it's low-signal.)
DECISION_TOOLS = ("AskUserQuestion", "ExitPlanMode")

def _result_content_str(block):
    """A tool_result's content flattened to a string (usually already a str; sometimes text blocks)."""
    c = block.get("content")
    if isinstance(c, str):
        return c
    if isinstance(c, list):
        return " ".join(x.get("text", "") for x in c if isinstance(x, dict))
    return ""

def _plan_headline(plan):
    """First non-empty, de-hashed line of an ExitPlanMode plan — its title."""
    for ln in (plan or "").splitlines():
        s = ln.strip().lstrip("#").strip()
        if s:
            return s
    return "plan"

def _decision_text(name, tinput, block, tur):
    """The synthetic prompt text for a user decision: the chosen AskUserQuestion answer(s), or an
    ExitPlanMode approve (plan title) / reject (the user's redirect). Past the existing 140-char clip."""
    if name == "AskUserQuestion":
        # toolUseResult.answers is the authoritative {question: answer} map (multiSelect → joined
        # string or list; free-text "Other" → the typed words). Pair each with its question header.
        answers = tur.get("answers") if isinstance(tur, dict) else None
        if isinstance(answers, dict) and answers:
            hdr = {q["question"]: q.get("header") for q in (tur.get("questions") or [])
                   if isinstance(q, dict) and q.get("question")}
            parts = []
            for q, a in answers.items():
                a = ", ".join(map(str, a)) if isinstance(a, list) else str(a)
                h = hdr.get(q)
                parts.append("%s=%s" % (h, a) if h else a)
            return "Chose " + "; ".join(parts)
        return "Dismissed question"                       # is_error / cleared with no answer
    if name == "ExitPlanMode":
        if block.get("is_error"):                        # rejected → the user's words steer next
            txt = _result_content_str(block)
            tail = txt.split("the user said:", 1)[1].strip() if "the user said:" in txt else ""
            return ("Rejected plan: " + tail) if tail else "Rejected plan"
        return "Approved plan: " + _plan_headline((tinput or {}).get("plan", ""))   # accepted → plan is the directive
    return "Decision"

SUMDIR = STATE / "summaries"
def attach_summaries(fsid, events):
    """Bind each event's request + reply Haiku phrase from summaries/<fsid>.jsonl by EXACT
    (id, kind) lookup — no time window, so a summary can NEVER bind to the wrong event. Sets
    event['summary'] (the ask) and event['reply'] (what the period did). Idempotent."""
    by_id = {}
    p = SUMDIR / (fsid + ".jsonl")
    try:
        for line in p.read_text(errors="replace").splitlines():
            try: o = json.loads(line)
            except Exception: continue
            if o.get("id") and o.get("text"):
                by_id[(o["id"], o.get("kind"))] = o["text"]
    except OSError:
        pass
    for e in events:
        e["summary"] = by_id.get((e["id"], "request"))
        e["reply"] = by_id.get((e["id"], "reply"))
    return events

# ───────────────────────── the one extractor ─────────────────────────
def extract_events(sid, transcript, now):
    """Parse one transcript into {events:[…], pending:[…]} (last HORIZON only).
    events: [{id, t, end, kind, text, mids, open}] — one per work-period boundary, ordered.
    pending: [{id, t, text}] — still-queued enqueues (ride `now`). [] on any error."""
    try:
        p = Path(transcript)
        if not p.exists():
            return {"events": [], "pending": [], "compactions": []}
        cutoff = now - HORIZON
        tid = p.stem                           # source transcript basename (fork fsid) — for click-to-open
        bnds, asst, qops, stops = [], [], [], []   # boundaries (ts,text,kind,mids,uuid) / asst (ts,..,uuid) / queue-ops / (ts, stop_reason)
        dec_uses = {}                          # open decision tool_use ids → {name, input}, joined to their tool_result
        compactions, last_real = [], None      # context-compaction MARKERS + last real conversational ts
        parent_of, leaf = {}, None             # uuid→parentUuid + the leaf, to reconstruct the active path
        for line in p.open(errors="replace"):
            line = line.strip()
            if not line:
                continue
            try: r = json.loads(line)
            except Exception: continue
            ts = parse_z(r.get("timestamp"))
            if ts is None or ts < cutoff:
                continue
            _u = r.get("uuid")
            if _u:                             # build the parent chain as we go (leaf = last line w/ a uuid)
                # compact-boundary records carry parentUuid:null + logicalParentUuid:
                # <pre-compaction leaf> — stitch through them so the active path (and
                # therefore anchor uuids) survives compaction instead of orphaning
                # every pre-compaction turn. Forks/rewinds still prune: normal lines
                # always have parentUuid set.
                parent_of[_u] = r.get("parentUuid") or r.get("logicalParentUuid"); leaf = _u
            # A context compaction stamps the summary message with isCompactSummary:true. It's a
            # MARKER (a point annotation), NOT a work-period boundary — nothing was asked, so it gets
            # no reply summary; the render textures the [prev, t] window or a dot at t.
            if r.get("isCompactSummary") is True:
                compactions.append({"t": ts, "prev": last_real if last_real is not None else ts,
                                    "meta": r.get("compactMetadata")})
                continue
            typ = r.get("type")
            if typ == "assistant":
                c = (r.get("message") or {}).get("content")
                atext = " ".join(_text_of(c).split())
                tools = [b.get("name", "tool") for b in c
                         if isinstance(b, dict) and b.get("type") == "tool_use"] if isinstance(c, list) else []
                asst.append((ts, atext, tools, r.get("uuid")))   # (ts, text, tools, uuid)
                # stop_reason of the LAST assistant line per period → the event's
                # `ended` flag: the transcript's OWN end-of-turn signal (same one
                # chat-view's working indicator uses). The summarizer requires it
                # before treating an open turn as finished — the tmux state var
                # alone has three non-hook writers and got silently flipped
                # mid-turn (the 2026-06-11 'found it' post-mortem).
                stops.append((ts, (r.get("message") or {}).get("stop_reason")))
                last_real = ts
                if isinstance(c, list):           # stash decision tool_uses; the matching tool_result splits the turn
                    for b in c:
                        if isinstance(b, dict) and b.get("type") == "tool_use" and b.get("name") in DECISION_TOOLS:
                            dec_uses[b.get("id")] = {"name": b.get("name"), "input": b.get("input") or {}}
            elif typ == "user":
                ps = r.get("promptSource")
                content = (r.get("message") or {}).get("content")
                # A decision tool's result (joined by tool_use_id) is a mid-turn synthetic prompt: the
                # user's answer/approval steers what follows, so it opens its own work period. It anchors
                # on THIS user line; the tool_result carries no prose, so the text-skip below drops it.
                if isinstance(content, list):
                    for b in content:
                        if isinstance(b, dict) and b.get("type") == "tool_result" and b.get("tool_use_id") in dec_uses:
                            du = dec_uses.pop(b["tool_use_id"])
                            dtext = _decision_text(du["name"], du["input"], b, r.get("toolUseResult"))
                            bnds.append((ts, dtext[:140], "decision", [], r.get("uuid"), dtext[:4000]))
                            last_real = ts
                text = _text_of(content)
                if not (text and text.strip()):
                    continue
                flat = " ".join(text.split())
                last_real = ts
                mids = re.findall(r'romp-msg-id:\s*(\S+)', text)
                if ps in ("typed", "queued"):
                    bnds.append((ts, flat[:140], ps, mids, r.get("uuid"), flat[:4000]))   # anchor = this user line
                elif ps is None and flat.startswith("Stop hook feedback"):
                    bnds.append((ts, flat[:140], "drain", mids, None, flat[:4000]))       # anchor = 1st assistant of the period
            elif typ == "queue-operation":
                op = r.get("operation")
                if op == "enqueue":
                    c = r.get("content")
                    if isinstance(c, str) and c.strip():
                        qops.append((ts, "enqueue", " ".join(c.split()), r.get("uuid")))
                elif op in ("dequeue", "remove"):       # resolution ops (content is null)
                    qops.append((ts, op, None, None))
        # FIFO-pair enqueues to their resolution: remove = folded mid-turn (a boundary at the
        # fold ts); dequeue = re-surfaced as its `queued` user line (already a boundary above).
        # the leaf→root ACTIVE path: vs_chat renders only this, so an off-path (rewound/orphaned-
        # branch) anchor uuid would silently no-op its scroll. Only emit uuids that are on it.
        active = set(); _u = leaf; _g = 0
        while _u is not None and _u not in active and _g < 200000:
            active.add(_u); _u = parent_of.get(_u); _g += 1
        enqueues, fifo = [], []
        for qts, qop, qtext, quuid in qops:
            if qop == "enqueue":
                e = {"ts": qts, "text": qtext or "", "proc": None, "restype": None, "uuid": quuid}
                enqueues.append(e); fifo.append(e)
            elif fifo:
                r0 = fifo.pop(0); r0["proc"] = qts; r0["restype"] = qop
        pending = []
        for e in enqueues:
            flat = e["text"]
            if _is_harness_injected(flat):               # task-notification etc. → not an ask; no dot
                continue
            if e["proc"] is None:                        # still queued → rides `now`
                if not _is_peer_banner(flat):
                    puid = e["uuid"] if e["uuid"] in active else None
                    pending.append({"id": _eid(sid, e["ts"], flat), "t": e["ts"], "text": flat[:140],
                                    "tid": tid, "uuid": puid})
            elif e["restype"] == "remove":               # folded mid-turn → its own boundary
                bnds.append((e["proc"], flat[:140], "absorbed",
                             re.findall(r'romp-msg-id:\s*(\S+)', flat), None, flat[:4000]))
        bnds.sort(key=lambda b: b[0])
        events = []
        for i, (ts, text, kind, mids, buid, full) in enumerate(bnds):
            nxt = bnds[i+1][0] if i + 1 < len(bnds) else now
            blocks = [b for b in asst if ts <= b[0] < nxt]   # assistant work in THIS period (chronological)
            # Clip at a large idle gap between consecutive assistant lines: a multi-minute silence means
            # the session went idle/dead, so lines after it belong to a LATER turn (e.g. after a revive an
            # hour later), not this one. Without this, a session that dies mid-turn and is revived sweeps
            # the revived first line into the dead turn — its bar spans the whole gap and its summary
            # conflates the two. Keep only the contiguous run from the period's first response. (A precise
            # fix would read the @claude-state idle log; this timestamp heuristic needs no extra input.)
            clipped = []
            for b in blocks:
                if clipped and b[0] - clipped[-1][0] > IDLE_GAP:
                    break
                clipped.append(b)
            blocks = clipped
            end = max([b[0] for b in blocks], default=ts)
            if end <= ts:
                end = min(nxt, ts + 5)                   # tiny stub if no assistant reply recorded
            work_uid = next((b[3] for b in blocks if b[3] in active), None)   # period's 1st active-path ASSISTANT line
            # replyUuid = the turn's READABLE reply: the last SUBSTANTIAL text block
            # (b[1] non-empty — thinking blocks extract as empty text). Plain
            # last-text landed clicks on closing one-liners and mid-work status
            # lines ("render.ts keeps its own copy…" — the user, 2026-06-11); the
            # deliverable prose is the last LONG block, so prefer that, falling
            # back to the longest text in the period, then to any last text. The
            # first assistant line is usually a thinking block, so a "show me
            # this deliverable" click anchored on work_uid would land on thinking.
            texted = [b for b in blocks if b[1] and b[3] in active]
            reply_uid = (next((b[3] for b in reversed(texted) if len(b[1]) >= REPLY_MEAT), None)
                         or (max(texted, key=lambda b: len(b[1]))[3] if texted else None))
            # uuid = the boundary/prompt line when anchorable; the SUBSTITUTE when it
            # isn't is the turn's readable reply — never work_uid (the first assistant
            # line is usually a THINKING block, and a "prompt" click landing on
            # internal reasoning was exactly the user's bug). None is fine: the chat's
            # time-fallback then lands on the nearest non-thinking turn.
            uid = buid if buid in active else reply_uid
            disp = _strip_banner(text)                    # cosmetic display text; id + mids stay from the RAW text
            # text_full: untruncated prompt text for the request summarizer's ask extraction —
            # the id hash and display `text` stay on the 140-char cut (ids must never change).
            # peer: computed from the RAW text (banner frame / 📬 / msg-id) + mids BEFORE the
            # cosmetic strip — `text`/`disp` lose those markers, so downstream consumers can't
            # re-derive this. A peer-prompted turn must never mint a user-ask.
            # ended = the period's last assistant line closed the turn (end_turn /
            # stop_sequence). Interrupted or still-streaming turns read False; a
            # later boundary closing the period makes the flag moot (open=False).
            last_stop = next((sr for sts, sr in reversed(stops) if ts <= sts < nxt), None)
            events.append({"id": _eid(sid, ts, text), "t": ts, "end": min(end, now),
                           "ended": last_stop in ("end_turn", "stop_sequence"),
                           "kind": kind, "text": disp, "text_full": _strip_banner(full),
                           "peer": bool(mids) or _is_peer_banner(text) or _is_peer_banner(full),
                           "mids": mids, "tid": tid,
                           "uuid": uid,                   # prompt-dot / message anchor (the boundary line)
                           "workUuid": work_uid,          # BAR anchor → the period's RESPONSE (first reply line)
                           "replyUuid": reply_uid,        # the turn's READABLE reply (last text line) — chat-open anchor for deliverables
                           "open": i == len(bnds) - 1,    # the last period is the still-open one
                           "rec": _reply_record(disp, blocks)})   # summary input (stripped before --emit)
        return {"events": events, "pending": pending, "compactions": compactions}
    except OSError:
        return {"events": [], "pending": [], "compactions": []}

EVCACHE = STATE / "events-cache"
CACHE_VERSION = 12       # bump whenever extract_events' output shape changes (forces re-extract)
def events_for(sid, transcript, now):
    """extract_events, memoized on disk by the transcript's (mtime, size). Repeated --emit
    calls (Obsidian polls ~1s while visible) spawn a FRESH process each time, so the cache
    must be on disk to survive — this is what keeps us from re-parsing unchanged transcripts
    (including the 14MB ones) every second. The in-process Python consumers benefit too."""
    try:
        st = os.stat(transcript)
    except OSError:
        return {"events": [], "pending": [], "compactions": []}
    key = [st.st_mtime, st.st_size, CACHE_VERSION]   # version invalidates the cache when the event shape changes
    cf = EVCACHE / (Path(transcript).stem + ".json")
    try:
        o = json.loads(cf.read_text())
        if o.get("key") == key and o.get("sid") == sid:
            return o["data"]
    except Exception:
        pass
    data = extract_events(sid, transcript, now)
    try:
        EVCACHE.mkdir(parents=True, exist_ok=True)
        tmp = cf.with_suffix(".tmp.%d" % os.getpid())
        tmp.write_text(json.dumps({"key": key, "sid": sid, "data": data}))
        tmp.rename(cf)                   # atomic publish, no torn reads
    except Exception:
        pass
    return data

# ───────────────────────── session discovery (for --emit) ─────────────────────────
def _custom_title(p):
    try:
        with open(p, "rb") as fh:
            head = fh.read(65536).decode("utf-8", "replace")
        for line in head.split("\n"):
            if "custom-title" not in line:
                continue
            try: o = json.loads(line)
            except Exception: continue
            if o.get("type") == "custom-title" and o.get("customTitle"):
                return o["customTitle"]
    except OSError:
        pass
    return None

def _session_sids(work_dir, sid, name, now):
    """Every transcript UUID for a romp session: its anchor sid + any forked UUID in the same
    project dir with the matching customTitle (a skill/`/clear`/resume forks a fresh id)."""
    sids = [sid] if sid else []
    if not work_dir:
        return sids
    proj = _proj_dir(work_dir)
    cutoff = now - HORIZON
    try:
        for fp in proj.iterdir():
            if fp.suffix != ".jsonl" or fp.stem == sid:
                continue
            try:
                if fp.stat().st_mtime < cutoff:
                    continue
            except OSError:
                continue
            if name and _custom_title(fp) == name:
                sids.append(fp.stem)
    except Exception:
        pass
    return sids

def _live_sessions():
    """[(name, sid, work_dir)] for live romp tmux sessions."""
    out = []
    try:
        p = subprocess.run(["tmux", "list-sessions", "-F",
                            "#{@romp}|#{session_name}|#{@romp-session-id}|#{@claude-dir}"],
                           capture_output=True, text=True, timeout=5)
    except Exception:
        return out
    for line in (p.stdout or "").splitlines():
        f = line.split("|")
        if len(f) < 3 or f[0] != "1" or not f[1]:
            continue
        name, sid = f[1], f[2]
        cdir = f[3] if len(f) > 3 else ""
        try:                                             # launch dir from the names registry
            parts = (NAMES / sid).read_text().rstrip("\n").split("\t")
            if len(parts) > 1 and parts[1]:
                cdir = parts[1]
        except Exception:
            pass
        out.append((name, sid, cdir))
    return out

def _name_color(sid):
    try:
        parts = (NAMES / sid).read_text().rstrip("\n").split("\t")
        if len(parts) > 2 and parts[2].startswith("#"):
            return parts[2]
    except Exception:
        pass
    return "#888888"

def _ended_sessions(now, live_sids):
    """romp sessions (from the names/ registry) ACTIVE within HORIZON but not live now — the
    faded historical lanes. (name, sid, dir, color). A session is 'active' if its anchor or any
    customTitle-matched fork transcript was touched within HORIZON."""
    out = []
    if not NAMES.is_dir():
        return out
    cutoff = now - HORIZON
    for f in NAMES.iterdir():
        sid = f.name
        if sid in live_sids:
            continue
        try:
            parts = f.read_text().rstrip("\n").split("\t")
        except Exception:
            continue
        name = parts[0] if parts and parts[0] else sid[:6]
        cdir = parts[1] if len(parts) > 1 else ""
        color = parts[2] if len(parts) > 2 and parts[2].startswith("#") else "#888888"
        if not cdir:
            continue
        proj = _proj_dir(cdir)
        anchor = proj / (sid + ".jsonl")
        active = False
        try:
            active = anchor.exists() and anchor.stat().st_mtime >= cutoff
        except OSError:
            pass
        if not active:                                   # a forked session: anchor stale, fork live
            try:
                for fp in proj.iterdir():
                    if fp.suffix == ".jsonl" and fp.stem != sid:
                        try: fresh = fp.stat().st_mtime >= cutoff
                        except OSError: continue
                        if fresh and _custom_title(fp) == name:
                            active = True; break
            except Exception:
                pass
        if active:
            out.append((name, sid, cdir, color))
    return out

def _session_stream(sid, name, cdir, now, live, color):
    """One romp session's merged, summary-bound event stream (all its forks)."""
    merged = {"events": [], "pending": [], "compactions": []}
    for fsid in _session_sids(cdir, sid, name, now):
        tp = _proj_dir(cdir) / (fsid + ".jsonl")
        ev = events_for(fsid, str(tp), now)              # ids namespaced by the FORK (self-contained)
        attach_summaries(fsid, ev["events"])             # bind request/reply by id, host-side, once
        merged["events"].extend(ev["events"])
        merged["pending"].extend(ev["pending"])
        merged["compactions"].extend(ev.get("compactions", []))
    merged["events"].sort(key=lambda e: e["t"])
    merged["pending"].sort(key=lambda e: e["t"])
    merged["compactions"].sort(key=lambda e: e["t"])
    for e in merged["events"]:
        e.pop("rec", None)                               # summary input — consumers don't need it
        e.pop("text_full", None)                         # summarizer input — same: display uses `text`
    return {"name": name, "color": color, "live": live, **merged}

def emit():
    """{sid: {name, color, live, events, pending}} for every live AND recently-ended romp session,
    each event already bound to its request/reply summary by id. The vault-code JS renders this
    verbatim — no transcript parsing, no session resolution, no summary binding on its side."""
    now = int(time.time())
    live = _live_sessions()
    live_sids = {sid for _, sid, _ in live}
    live_names = {name for name, _, _ in live}
    out = {}
    consumed = set()                                 # every fork fsid already folded into an emitted lane
    for name, sid, cdir in live:
        out[sid] = _session_stream(sid, name, cdir, now, True, _name_color(sid))
        consumed.update(_session_sids(cdir, sid, name, now))
    for name, sid, cdir, color in _ended_sessions(now, live_sids):
        # The timeline keys lanes by NAME, so a DEAD session that shares a live session's name
        # would clobber the live lane (faded, no turns). A live session owns its name — skip the
        # ghost. (A distinct dead session that merely reused a now-live name is not this session.)
        if name in live_names:
            continue
        # Fork-chain dedup: a renamed/forked session keeps a names/ entry per fork fsid, and EACH
        # entry's _session_sids() resolves to the SAME merged fork set — so without this we emit the
        # identical lane once per entry (the obsidian b9c6e270/f7399ff5 + romp 473763a8/9d0a07d1
        # duplicate-lane bug). Emit a chain ONCE: skip an entry whose fork set is already folded into
        # a lane we emitted. A genuinely distinct session that merely reused the name has a DISJOINT
        # fork set, so it still gets its own lane (e.g. the separate ce8eda51 "obsidian").
        fsids = _session_sids(cdir, sid, name, now)
        if any(fs in consumed for fs in fsids):
            continue
        out[sid] = _session_stream(sid, name, cdir, now, False, color)
        consumed.update(fsids)
    return out

def main():
    arg = sys.argv[1] if len(sys.argv) > 1 else "--emit"
    if arg == "--emit":
        sys.stdout.write(json.dumps({"now": int(time.time()), "sessions": emit()}))
    elif arg == "--test" and len(sys.argv) >= 4:
        ev = extract_events(sys.argv[2], sys.argv[3], int(time.time()))
        def hh(t): return datetime.fromtimestamp(t).strftime("%H:%M:%S")
        for e in ev["events"]:
            print("  %s-%s [%-8s] %s :: %s" % (hh(e["t"]), hh(e["end"]), e["kind"],
                                               "open" if e["open"] else "    ", e["text"][:46]))
        for e in ev["pending"]:
            print("  %s [pending ] %s" % (hh(e["t"]), e["text"][:46]))
    else:
        sys.stderr.write("usage: romp-events [--emit | --test <sid> <transcript>]\n"); sys.exit(2)

if __name__ == "__main__":
    main()
