#!/usr/bin/env bash
# romp-mail-clear — clear the Romp Postal Service "incoming mail" status-bar badge for
# a session. Called by the tmux `client-session-changed` hook when you switch to
# a session (you've now seen it), and usable by hand. The badge itself is set by
# scripts/romp-postal (_set_mail_badge) when mail arrives; romp-postal also
# auto-expires it after ROMP_POSTAL_BADGE_TTL as a backstop.
#
# Clear by setting each option to empty (not `set -u`, which prints a spurious
# "invalid option" on some tmux builds). The status format hides the badge when
# @romp-mail-from is empty: #{?@romp-mail-from,<badge>,}.
set -uo pipefail
sess="${1:?usage: romp-mail-clear <session>}"
for opt in @romp-mail-from @romp-mail-bg @romp-mail-fg @romp-mail-token; do
    tmux set -t "$sess" "$opt" "" 2>/dev/null || true
done
tmux refresh-client -S 2>/dev/null || true
