_GEAR_JS = r"""(function(){var g=document.getElementById('rgear'),p=document.getElementById('rsettings'),
b=document.getElementById('rsver'),cc=document.getElementById('rs-compact');
function load(){try{return Object.assign({compact:false},JSON.parse(localStorage.getItem('romp:settings')||'null'));}catch(e){return {compact:false};}}
cc.addEventListener('change',function(){var s=load();s.compact=cc.checked;try{localStorage.setItem('romp:settings',JSON.stringify(s));}catch(e){}});
function lv(){var t=document.querySelector('script[src*="feed.js"]');
var m=t&&t.getAttribute('src').match(/[?&]v=(\d+)/);return m?+m[1]:0;}
function fill(){fetch('/version',{cache:'no-store'}).then(function(r){return r.json();}).then(function(v){
var x=lv();b.innerHTML='kernel '+(v.kernel_sha||'?')+'\nserving v'+
v.dist_ver+'\nthis tab v'+(x||'?');
}).catch(function(){b.textContent='(version unavailable)';});}
g.onclick=function(e){e.stopPropagation();if(p.hidden){p.hidden=false;cc.checked=!!load().compact;fill();}else p.hidden=true;};
document.addEventListener('click',function(e){if(!p.hidden&&e.target!==g&&!p.contains(e.target))p.hidden=true;});})();"""


