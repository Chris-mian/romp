border-radius:50%;background:#e6edf3;cursor:pointer;}
.romp-tl-wrap{overflow-x:auto;}.romp-tl-wrap svg{display:block;}
/* Touch devices: the view forces a >=640px-wide SVG, which on a ~390px phone overflowed into a NATIVE
   horizontal scroller that competed with (and beat) the one-finger pan gesture. Fit the SVG to the screen
   instead (uniform scale via its viewBox) and kill the overflow scroller, so the touch handlers own all
   horizontal motion and pinch-zoom is the way to get detail (the user 2026-06-16). */
@media (pointer:coarse){.romp-tl-wrap{overflow-x:hidden;touch-action:pan-y;}
.romp-tl-wrap svg{width:100%;height:auto;}}
.romp-tl-tip{position:fixed;pointer-events:none;z-index:1000;max-width:320px;background:#1c2430;
border:1px solid #ffffff1f;border-radius:8px;padding:7px 9px;font-size:12px;color:#e6edf3;
box-shadow:0 8px 24px #00000066;opacity:0;transform:translateY(4px);transition:opacity .1s,transform .1s;}
.romp-tl-tip.show{opacity:1;transform:translateY(0);}
.romp-tl-tip .r{display:flex;align-items:center;gap:6px;}
.romp-tl-tip .chip{width:9px;height:9px;border-radius:50%;display:inline-block;}
.romp-tl-tip .who{font-weight:650;}.romp-tl-tip .ar{color:#6e7681;}
