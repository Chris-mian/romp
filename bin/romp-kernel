#!/usr/bin/env python3
"""romp-kernel — the merged read-side kernel (design/read-side.md). One always-on process:
the Layer-1 parser + Layer-2 judges (producer) co-located with an HTTP+WebSocket server,
single writer. It serves the HUMAN'S TUNED chat-view UI (render.js/feed.js bundles, reused
verbatim) and pushes reshaped payloads built ONLY from the new records (captions/ goals/
archive/). The Python projection here is the SINGLE view-builder; the bundles only render.

Transport is the SAME WebSocket postMessage protocol the bundles already speak (the
`shimJs` bridge is reused verbatim), so the VS Code extension repoints to this kernel with
zero protocol change at switchover. WS is hand-rolled on the stdlib socket (no dependency).

Sits beside the untouched chat-view Node kernel during the minimal phase (extension stays on
old). Port status (KEEP/ADAPT/DROP) tracked in design/ui-parity.md + backlog.md.

Run:  python3 ~/GitRepos/romp-event-model/bin/romp-kernel   → opens http://127.0.0.1:7878
"""
import json, os, sys, time, threading, traceback, base64, hashlib, struct, subprocess
from pathlib import Path
from datetime import datetime
from importlib.machinery import SourceFileLoader
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from urllib.parse import urlparse, parse_qs

HERE = Path(__file__).resolve().parent
ROOT = HERE.parent
em = SourceFileLoader("romp_event_model", str(HERE / "romp-event-model")).load_module()
jd = SourceFileLoader("romp_judge", str(HERE / "romp-judge")).load_module()
cm = SourceFileLoader("romp_colormap", str(HERE / "romp_colormap.py")).load_module()  # age → recency tint
CHAT_VIEW = ROOT / "chat-view"               # the tuned UI, current in this worktree via `git merge main`
DIST = CHAT_VIEW / "dist"                    # bundles built from CHAT_VIEW/src (the human's tuned render layer)
MEDIA = CHAT_VIEW / "media"
OBSIDIAN = ROOT / "obsidian"
NAMES = jd.STATE / "names"
PORT = int(os.environ.get("ROMP_KERNEL_PORT", "7878"))
BIND = os.environ.get("ROMP_SERVE_HOST", "127.0.0.1")   # set 0.0.0.0 to reach the kernel over the tailnet / a phone


def _load_token():
    """The serve token, baked into launch so the human never passes --token: ROMP_SERVE_TOKEN if
    set, else a stable random token persisted under the state dir. Required only for NON-local
    reach; local clients pass on the Origin check + auto-injected cookie."""
    t = (os.environ.get("ROMP_SERVE_TOKEN") or "").strip()
    if t:
        return t
    f = jd.STATE / "serve-token"
    try:
        v = f.read_text().strip()
        if v:
            return v
    except OSError:
        pass
    v = base64.urlsafe_b64encode(os.urandom(18)).decode().rstrip("=")
    try:
        jd.STATE.mkdir(parents=True, exist_ok=True)
        f.write_text(v)
        os.chmod(f, 0o600)
    except OSError:
        pass
    return v

TOKEN = _load_token()

_clients = []                                # connected WS clients: {app, wid, send, alive}
_clients_lock = threading.Lock()
_client_seen = [0.0]


# ───────────────────────── helpers ─────────────────────────
def iso(t):
    try:
        return datetime.fromtimestamp(t).strftime("%Y-%m-%dT%H:%M:%S")
    except Exception:
        return ""


def _name_color(sid):
    """Session display color {bg,fg} from the names registry (3rd tab field), or null."""
    try:
        parts = (NAMES / sid).read_text().rstrip("\n").split("\t")
        if len(parts) > 2 and parts[2].startswith("#"):
            return {"bg": parts[2], "fg": "#ffffff"}
    except Exception:
        pass
    return None


def _name_of(sid):
    """Session display name from the names registry (1st tab field), or None. The event model gives a
    postal atom's peer as the sender's rompUuid (sid), so a postal card resolves it to a name + color."""
    try:
        return (NAMES / sid).read_text().rstrip("\n").split("\t")[0] or None
    except Exception:
        return None


def _rgb(color):
    """The card's recency-tint [r,g,b] — the session color (the old hawaii recency colormap is
    a later refinement), defaulting to a neutral slate."""
    h = (color or {}).get("bg", "#7088aa").lstrip("#")
    try:
        return [int(h[0:2], 16), int(h[2:4], 16), int(h[4:6], 16)]
    except Exception:
        return [112, 136, 170]


def _sessions(now):
    out = []
    for fsid, path, anchor, name in jd.discover(now):
        try:
            mtime = os.stat(path).st_mtime
        except OSError:
            mtime = 0
        out.append({"sid": fsid, "name": name or fsid[:8], "path": str(path), "mtime": mtime})
    out.sort(key=lambda s: s["mtime"], reverse=True)
    return out


def _alive_sessions(now, tmux):
    """The sessions shown on EVERY surface (feed / timeline / chat tabs): only those alive in tmux
    right now. The hard liveness filter (the user 2026-06-15) — ignore everything that isn't a living
    session: a dead session's transcript stays in discover()'s window but is dropped from all
    surfaces. A living session is shown FULLY — the event model re-parses its whole transcript with
    the new core each build, so old-system sessions are reprocessed. Empty tmux (rare headless run) →
    fall back to discover so the surfaces aren't blank on a transient tmux miss."""
    alive = [s for s in _sessions(now) if s["sid"] in tmux]
    return alive if tmux else _sessions(now)


def _session_order():
    """The shared session order (SID list), persisted by a tab-drag (reorderTabs) or a lane-drag
    (writeOrder). Chat tabs AND timeline lanes both order by it, so dragging either reorders both
    (parity with the old UI's session-order.json). [] when unset."""
    try:
        a = json.loads((jd.STATE / "session-order.json").read_text())
        return [x for x in a if isinstance(x, str)] if isinstance(a, list) else []
    except Exception:
        return []


def _write_session_order(order):
    if not isinstance(order, list):
        return
    p = jd.STATE / "session-order.json"
    p.parent.mkdir(parents=True, exist_ok=True)
    tmp = p.with_name("session-order.json.tmp.%d" % os.getpid())
    tmp.write_text(json.dumps([x for x in order if isinstance(x, str)]))
    tmp.rename(p)                                     # atomic publish


def _ordered_alive(now, tmux):
    """Living sessions in the SHARED order (session-order.json first, then the rest newest-first) —
    used for chat tabs AND timeline lanes so the two stay in lockstep."""
    alive = _alive_sessions(now, tmux)
    idx = {sid: i for i, sid in enumerate(_session_order())}
    n = len(idx)
    alive.sort(key=lambda s: (idx.get(s["sid"], n), -s["mtime"]))
    return alive


def _hidden_tabs():
    """SIDs the user closed (×) from the chat tab strip — hidden from the tabs but NOT killed: the
    session keeps running, and clicking it in the feed/timeline (openSession) reopens the tab. A view
    preference, deliberately not a session kill."""
    try:
        a = json.loads((jd.STATE / "hidden-tabs.json").read_text())
        return set(x for x in a if isinstance(x, str)) if isinstance(a, list) else set()
    except Exception:
        return set()


def _set_hidden_tab(sid, hidden):
    cur = _hidden_tabs()
    cur.add(sid) if hidden else cur.discard(sid)
    p = jd.STATE / "hidden-tabs.json"
    p.parent.mkdir(parents=True, exist_ok=True)
    tmp = p.with_name("hidden-tabs.json.tmp.%d" % os.getpid())
    tmp.write_text(json.dumps(sorted(cur)))
    tmp.rename(p)


TMUX_FMT = ("#{@romp}|#{@romp-session-id}|#{@claude-state}|#{@claude-state-since}|"
            "#{@claude-model}|#{@claude-effort}|#{@claude-context}|#{@claude-compact-pct}|#{@identity-bg}")


def _num(x):
    x = (x or "").strip()
    return int(x) if x.lstrip("-").isdigit() else None


def _tmux_sessions():
    """Live lane metadata from tmux @claude-* vars (state / model / effort / context% / compaction% /
    state-since / identity color), keyed by romp-session-id. This is the ONE source that isn't a file
    — everything else the kernel reads is file-derived. The kernel runs on the HOST (where the tmux
    sessions + Claude live), so tmux is present; the phone reaches it through its browser → this host
    kernel → tmux (no Claude runs on the phone). Best-effort {} when tmux is absent (rare headless
    run); the builders then fall back to file-derived state. Canonical @claude-state values:
    working | waiting | idle | permission | compacting (hooks/tmux-status.sh)."""
    try:
        r = subprocess.run(["tmux", "list-sessions", "-F", TMUX_FMT],
                           capture_output=True, text=True, timeout=2.5)
    except Exception:
        return {}
    if r.returncode != 0:
        return {}
    out = {}
    for line in r.stdout.splitlines():
        p = line.split("|")
        if len(p) < 9 or p[0] != "1" or not p[1]:           # p[0]=@romp tag (1 = a romp session)
            continue
        out[p[1]] = {"state": p[2].strip(), "since": _num(p[3]), "model": p[4].strip(),
                     "effort": p[5].strip(), "context": _num(p[6]), "compactPct": _num(p[7]),
                     "color": p[8].strip() if p[8].startswith("#") else None}
    return out


def _tmux_send(name, text, model_cmd=False, _async=True):
    """Inject text into a session's tmux pane — set-buffer + bracketed paste-buffer + Enter, the old
    TmuxBackend.send sequence (a 250ms gap lets the bracketed paste land before Enter submits). name =
    the tmux session name. Drives the chat composer, /compact, and the model/effort pickers. Runs in a
    daemon thread so the WS recv loop isn't blocked by the gaps. model_cmd: /model opens a confirm that
    needs a second Enter."""
    if not name or not text:
        return

    def run(args, t=3):
        try:
            return subprocess.run(["tmux"] + args, capture_output=True, text=True, timeout=t)
        except Exception:
            return None

    def go():
        r = run(["display-message", "-p", "-t", name, "#{pane_in_mode}"], 2)
        if r and r.stdout.strip() == "1":
            run(["send-keys", "-t", name, "-X", "cancel"], 2)        # exit copy-mode so paste+Enter land
        run(["set-buffer", "-b", "rompkernel", text])
        run(["paste-buffer", "-b", "rompkernel", "-d", "-p", "-t", name])   # -p bracketed, -d delete buf
        time.sleep(0.25)
        run(["send-keys", "-t", name, "Enter"])
        if model_cmd:
            time.sleep(0.85)
            run(["send-keys", "-t", name, "Enter"])                 # accept the hookless /model confirm
    threading.Thread(target=go, daemon=True).start() if _async else go()


def _captions(fsid):
    out = {}
    try:
        for line in (jd.CAPDIR / (fsid + ".jsonl")).read_text(errors="replace").splitlines():
            try:
                o = json.loads(line)
            except Exception:
                continue
            if o.get("id"):
                out[o["id"]] = o
    except OSError:
        pass
    return out


# ───────────────────────── view-builder: atoms → chat ChatEvent[] (parity: chat = KEEP) ─────────────────────────
def _edit_diff(inp):
    """A minimal unified-ish diff string for an Edit/MultiEdit tool_use input (the render folds it)."""
    edits = inp.get("edits") or ([{"old_string": inp.get("old_string", ""),
                                   "new_string": inp.get("new_string", "")}] if "old_string" in inp else [])
    lines = []
    for e in edits:
        for ln in str(e.get("old_string", "")).splitlines():
            lines.append("- " + ln)
        for ln in str(e.get("new_string", "")).splitlines():
            lines.append("+ " + ln)
    return "\n".join(lines)


def _split_reminders(text):
    """Split a user message into (prompt, [reminders]): harness-injected <system-reminder>…
    </system-reminder> blocks become folded reminders (render.ts shows them as a 'ⓘ N system
    reminders' fold); the rest is the real prompt. Precise — keys on the exact wrapper, not a guess."""
    OPEN, CLOSE = "<system-reminder>", "</system-reminder>"
    if OPEN not in text:
        return text, []
    reminders, out, i = [], [], 0
    while True:
        j = text.find(OPEN, i)
        if j < 0:
            out.append(text[i:]); break
        out.append(text[i:j])
        k = text.find(CLOSE, j)
        if k < 0:
            reminders.append(text[j + len(OPEN):].strip()); break
        reminders.append(text[j + len(OPEN):k].strip())
        i = k + len(CLOSE)
    return " ".join("".join(out).split()), [r for r in reminders if r]


def build_session(sid, now, tmux=None):
    """A {type:"session"} message the render.js bundle consumes: the event tree reshaped to
    ChatEvent[], plus the TOC ledger (archiver headline + turn captions) and a status chip."""
    if tmux is None:
        tmux = _tmux_sessions()
    sess = next((s for s in _sessions(now) if s["sid"] == sid), None)
    if not sess:
        return None
    session = em.parse_session(sess["path"], rompuuid=sid, candidate_files=[sess["path"]],
                               postal_log=str(jd.MESSAGES), now=now)
    caps = _captions(sid)
    events, by_tool = [], {}                  # by_tool: tool_use_id → its tool event (fill output later)
    last_t = None
    for turn in session["turns"]:
        for a in turn["atoms"]:
            t = a.get("t"); ts = iso(t) if t else None
            last_t = t or last_t
            msg = a.get("message") or {}
            blocks = msg.get("content", []) if isinstance(msg.get("content"), list) else []
            if a["type"] == "user":
                author = a.get("author")
                trs = [b for b in blocks if isinstance(b, dict) and b.get("type") == "tool_result"]
                if isinstance(author, dict):                     # peer message → postal card
                    text = " ".join(b.get("text", "") for b in blocks if b.get("type") == "text")
                    psid = author.get("peer")        # the SENDER's rompUuid (sid), per the event model
                    events.append({"kind": "postal", "direction": "in",
                                   "peer": _name_of(psid) or psid or "peer",
                                   "color": _name_color(psid) if psid else None,
                                   "body": text, "uuid": a.get("uuid"), "ts": ts, "t": t, "status": "delivered"})
                elif trs:                                        # tool_result → fill the matching tool event's output
                    for tr in trs:
                        ev = by_tool.get(tr.get("tool_use_id"))
                        if ev is not None:
                            c = tr.get("content")
                            ev["output"] = (c if isinstance(c, str) else json.dumps(c))[:16000]
                            ev["isError"] = bool(tr.get("is_error"))
                            ev["resultUuid"] = a.get("uuid")
                else:                                            # genuine prompt
                    text = " ".join(b.get("text", "") for b in blocks if b.get("type") == "text").strip() \
                           if blocks else (msg.get("content") if isinstance(msg.get("content"), str) else "")
                    if text:
                        prompt, reminders = _split_reminders(text)
                        if prompt or reminders:
                            events.append({"kind": "user", "md": prompt, "uuid": a.get("uuid"), "ts": ts,
                                           "human": author == "human", "reminders": reminders})
            elif a["type"] == "assistant":
                for b in blocks:
                    if not isinstance(b, dict):
                        continue
                    if b.get("type") == "thinking":
                        events.append({"kind": "thinking", "text": b.get("thinking", ""),
                                       "encrypted": bool(b.get("signature")), "uuid": a.get("uuid"), "ts": ts})
                    elif b.get("type") == "text" and b.get("text", "").strip():
                        events.append({"kind": "assistant", "md": b["text"], "uuid": a.get("uuid"), "ts": ts})
                    elif b.get("type") == "tool_use":
                        inp = b.get("input") or {}
                        ev = {"kind": "tool", "name": b.get("name", "tool"),
                              "desc": str(inp.get("description") or "")[:200],
                              "input": json.dumps(inp)[:4000], "output": "", "isError": False,
                              "uuid": a.get("uuid"), "ts": ts,
                              "file": inp.get("file_path") or inp.get("path") or "",
                              "diff": _edit_diff(inp) if b.get("name") in ("Edit", "MultiEdit", "Write") else ""}
                        by_tool[b.get("id")] = ev
                        events.append(ev)
            elif a["type"] == "system" and a.get("subtype") == "compact_boundary":
                events.append({"kind": "assistant", "md": "✦ Compacted", "uuid": a.get("uuid"), "ts": ts})
    # TOC ledger: archiver headline + turn captions (click-to-jump via the turn's anchor uuid)
    arch = jd.load_archive(sid) or {}
    bullets = []
    for turn in session["turns"]:
        cap = caps.get(turn["id"], {}).get("caption")
        anchor = next((x.get("uuid") for x in turn["atoms"] if x.get("uuid")), None)
        if cap:
            bullets.append({"text": cap, "t": turn["t"], "id": anchor, "sid": sid})
    ledger = {"summary": arch.get("headline", ""), "bullets": bullets}
    last_turn = session["turns"][-1] if session["turns"] else None
    open_now = bool(last_turn and not last_turn["ended"]
                    and not any(x["type"] == "idle" for x in last_turn["atoms"]))
    # work-timer base, in MILLISECONDS (render's elapsedMs does Date.now()ms - sinceEpoch; a seconds
    # value showed ~494,000h — the user's "400,000 hours" bug): the current open turn's start while
    # working, else the last activity; None when unknown (render then shows no timer).
    work_start = last_turn["t"] if (open_now and last_turn) else last_t
    since_ms = int(work_start * 1000) if work_start else None
    tm = tmux.get(sid)
    if tm:
        # WORKING comes from the event model (open turn, no idle atom) — a stable, transcript-derived
        # signal — NOT @claude-state, which lags/flips between hook events (the user saw the chip go
        # blue mid-work + flicker). tmux supplies only what the transcript can't see: permission
        # (awaiting) and compacting, plus the model/effort/ctx metadata.
        st = tm["state"]
        chip = ("awaiting" if st == "permission" else "compacting" if st == "compacting"
                else "working" if open_now else "ready")
        faded = chip == "ready" and bool(tm["since"]) and now - tm["since"] > 3600
        status = {"state": chip, "sinceEpoch": since_ms, "faded": faded,
                  "model": tm["model"], "effort": tm["effort"],
                  "ctx": str(tm["context"]) if tm["context"] is not None else ""}
    elif tmux:                                         # tmux present but this session isn't running → closed
        status = {"state": "closed", "sinceEpoch": since_ms, "faded": True}
    else:                                              # no tmux (rare headless) → event-model fallback
        status = {"state": "working" if open_now else "idle", "sinceEpoch": since_ms, "faded": not open_now}
    return {"type": "session", "id": sid, "name": sess["name"], "color": _name_color(sid),
            "events": events, "status": status, "ledger": ledger, "firstSeen": session["turns"][0]["t"]
            if session["turns"] else now}


# ───────────────────────── feed clear / undo (inbox-zero) ─────────────────────────
def _cleared_ids():
    """The set of currently-cleared feed itemIds (asks + stream), replayed from the append-only
    cleared.jsonl: a 'clear' row adds an id, an 'undo' row removes it (newest-wins). Mirrors the old
    kernel's shared cleared.jsonl so one Clear hides both an ask card and its stream deliverable."""
    cur = {}
    try:
        for line in (jd.STATE / "cleared.jsonl").read_text().splitlines():
            try:
                o = json.loads(line)
            except Exception:
                continue
            iid = o.get("id")
            if not iid:
                continue
            if o.get("op") == "undo":
                cur.pop(iid, None)
            else:
                cur[iid] = o.get("t", 0)
    except OSError:
        pass
    return cur


def _clear_ask(item_id):
    """Clear one feed card (inbox-zero) — a batch of one (see _clear_all)."""
    _clear_all([item_id])


def _clear_all(item_ids):
    """Clear every given card in ONE batch (shared float timestamp = the batch key) so a single
    UndoClear restores the whole batch. Append-only + single-writer (the kernel) → crash-safe; an
    undo just appends 'undo' rows. Used by the feed's Clear-all and by single-card clears."""
    item_ids = [i for i in item_ids if i]
    if not item_ids:
        return
    p = jd.STATE / "cleared.jsonl"
    p.parent.mkdir(parents=True, exist_ok=True)
    t = time.time()
    with p.open("a") as f:
        for iid in item_ids:
            f.write(json.dumps({"id": iid, "t": t, "op": "clear"}) + "\n")


def _undo_clear():
    """Restore the most-recent clear BATCH — every id cleared at the latest timestamp. So one
    UndoClear undoes a Clear-all as a unit, and a single-card clear restores just that card."""
    cur = _cleared_ids()
    if not cur:
        return
    newest = max(cur.values())
    with (jd.STATE / "cleared.jsonl").open("a") as f:
        for iid in [i for i, ct in cur.items() if ct == newest]:
            f.write(json.dumps({"id": iid, "t": time.time(), "op": "undo"}) + "\n")


# ───────────────────────── view-builder: goals → feed (parity: feed = ADAPT; minimal here) ─────────────────────────
def build_feed(now, tmux=None):
    """The {type:"feed"} message the tuned feed.js bundle consumes (ui-parity.md: feed = ADAPT).
    Goals map onto the AskItem/AskTreeNode shape the render already speaks: the goal tree IS the
    card's tree, rolled-up status → the Working/Blocked/Completed column, dead-concept fields
    (relevance/liveness/suspects/openQuestions/decision-briefs) left empty so the render's
    conditional paths hide them — no edits to the tuned card code. Stream = turn captions."""
    if tmux is None:
        tmux = _tmux_sessions()
    cleared = _cleared_ids()
    asks, stream, working = [], [], []
    for s in _alive_sessions(now, tmux):             # hard filter: living sessions only
        fsid, name = s["sid"], s["name"]
        color = _name_color(fsid)
        tm = tmux.get(fsid); live = tm is not None
        who_working = bool(tm and tm["state"] == "working")
        if who_working:
            working.append(name)
        store = jd.load_goals(fsid)
        nodes, status = store.get("nodes", {}), store.get("status", {})
        children = {}
        for nid, nd in nodes.items():
            children.setdefault(nd.get("parentId"), []).append(nid)

        def node_status(nd):
            return "done" if nd.get("nodeComplete") else ("question" if nd.get("blocked") else "open")

        def flatten(nid, out):                       # AskTreeNode flat list, root first; nest via children ids
            nd = nodes[nid]
            kids = sorted(children.get(nid, []), key=lambda c: nodes[c]["t"])
            out.append({"id": nid, "kind": "ask", "text": nd["text"], "who": name, "whoSid": fsid,
                        "whoColor": color, "whoWorking": who_working, "status": node_status(nd),
                        "t": nd["t"], "last": nd["t"], "trgb": list(cm.age_rgb(now - nd["t"])),
                        "children": kids, "rows": []})
            for c in kids:
                flatten(c, out)
            return out
        for nid in children.get(None, []):
            col = status.get(nid, "working")
            if col == "cleared" or nid in cleared:
                continue
            asks.append({
                "itemId": nid, "sid": fsid, "name": name, "color": color, "text": nodes[nid]["text"],
                "t": nodes[nid]["t"], "created": nodes[nid]["t"], "live": live,
                "trgb": list(cm.age_rgb(now - nodes[nid]["t"])),
                "done": 0, "needsYou": 0, "linked": [], "turnId": nid, "turnIds": [nid],
                "column": ("needs_input" if col == "blocked" else "completed" if col == "completed" else "working"),
                "openQuestions": [], "openPaths": [], "tree": flatten(nid, [])})
        for c in _captions(fsid).values():
            if c.get("grain") == "turn" and c["id"] not in cleared:
                stream.append({"itemId": c["id"], "sid": fsid, "name": name, "color": color,
                               "did": c["caption"], "t": c["t"], "trgb": list(cm.age_rgb(now - c["t"])),
                               "relevance": "DETAILS", "live": live, "standalone": True})
    stream.sort(key=lambda c: c["t"], reverse=True)
    return {"type": "feed", "asks": asks, "items": stream[:200], "blocked": [], "now": now,
            "working": working, "dismissedCount": len(cleared), "showDismissed": False,
            "canUndoClear": len(cleared) > 0}


# ───────────────────────── view-builder: segments → timeline (parity: timeline = ADAPT) ─────────────────────────
TL_HORIZON = 48 * 3600                        # how far back stripes/connectors are read (slider max)
MSG_INFLIGHT_MAX = 1800                        # a message older than this isn't "in flight" (30 min)


def _state_intervals(sid, want, now):
    """Every [start,end] the session sat in `want` ('permission' → awaiting candy-stripes,
    'compacting' → cross-hatch), from states/<sid>.jsonl: an entry runs until the next transition
    (or `now` if still in it). Forward-only — periods predating the log don't appear. File-based
    port of the obsidian timeline's stateIntervals (the kernel reads states/, never tmux)."""
    try:
        text = (jd.STATE / "states" / (sid + ".jsonl")).read_text(errors="replace")
    except OSError:
        return []
    ev = []
    for line in text.splitlines():
        if not line:
            continue
        try:
            o = json.loads(line)
        except Exception:
            continue
        if o.get("t") and o.get("state"):
            ev.append((o["t"], o["state"]))
    ev.sort()
    cutoff, out = now - TL_HORIZON, []
    for i, (t, st) in enumerate(ev):
        if st != want:
            continue
        end = ev[i + 1][0] if i + 1 < len(ev) else now
        if end < cutoff:
            continue
        out.append([max(t, cutoff), end])
    return out


def _usage():
    """The /usage rate-limit bars (5h + weekly) from usage.json, or None. File-based, like the
    obsidian timeline's readUsage."""
    try:
        o = json.loads((jd.STATE / "usage.json").read_text())
    except Exception:
        return None

    def seg(s):
        if isinstance(s, dict) and isinstance(s.get("pct"), (int, float)):
            ra = s.get("resets_at")
            return {"pct": max(0, min(100, round(s["pct"]))),
                    "resetsAt": ra if isinstance(ra, (int, float)) else None}
        return None
    five, seven = seg(o.get("five_hour")), seg(o.get("seven_day"))
    if not five and not seven:
        return None
    t = o.get("t")
    return {"fiveHour": five, "sevenDay": seven, "t": t if isinstance(t, (int, float)) else None}


def _postal_messages(now, alive_sids, id2name):
    """Inter-session connectors for the timeline, from the postal log (timeline/messages.jsonl): each
    'sent' row joined to its 'exec' by id → a [sent,exec] arrow between two lanes. File-based (the old
    romp-timeline-data.readMessages, trimmed): BOTH ends must be alive lanes, recent only, no
    self-messages. Connectors that need true process-start binding (the courier) come later."""
    try:
        lines = (jd.STATE / "timeline" / "messages.jsonl").read_text(errors="replace").splitlines()
    except OSError:
        return []
    sent, execd = {}, {}
    for ln in lines:
        try:
            o = json.loads(ln)
        except Exception:
            continue
        if o.get("ev") == "sent" and o.get("id"):
            sent[o["id"]] = o
        elif o.get("ev") == "exec" and o.get("id"):
            execd[o["id"]] = o.get("t")
    cutoff, out = now - TL_HORIZON, []
    for mid, e in sent.items():
        f, t, st = e.get("from_id"), e.get("to_id"), e.get("t")
        if f not in alive_sids or t not in alive_sids or f == t or not st or st < cutoff:
            continue
        ex = execd.get(mid)
        out.append({"id": mid, "fromId": f, "toId": t,
                    "from": id2name.get(f, e.get("from", "")), "to": id2name.get(t, ""),
                    "fromOrig": e.get("from", id2name.get(f, f)),
                    "sent": st, "exec": ex if ex else st, "hasExec": ex is not None,
                    "pending": ex is None and (now - st) < MSG_INFLIGHT_MAX,
                    "text": (e.get("body", "") or "").strip()[:240], "summary": None, "parked": False})
    out.sort(key=lambda m: m["sent"])
    return out


def _pending_mail(sid):
    """Unread/parked postal count for a lane (the 📬 flag, esp. on dead lanes), from
    postal/mail-pending/<sid> (presence gate) + postal/mail/<sid>/new (count)."""
    try:
        base = jd.STATE / "postal"
        if not (base / "mail-pending" / sid).exists():
            return 0
        return sum(1 for f in (base / "mail" / sid / "new").iterdir() if not f.name.startswith("."))
    except Exception:
        return 0


def _seg_anchors(atoms):
    """(workUuid, replyUuid) deep-link anchors for a segment: workUuid = the FIRST assistant atom
    (the bar → response, often a thinking block); replyUuid = the LAST assistant atom carrying
    text (the readable reply, preferred work anchor) — parallel to the obsidian timeline."""
    work = reply = None
    for a in atoms:
        if a.get("type") != "assistant":
            continue
        if work is None:
            work = a.get("uuid")
        blocks = (a.get("message") or {}).get("content", [])
        if isinstance(blocks, list) and any(
                isinstance(b, dict) and b.get("type") == "text" and b.get("text", "").strip()
                for b in blocks):
            reply = a.get("uuid")
    return work, reply


def _seg_prompt(seg):
    """The segment's request text (its trigger/opener atom) for the prompt-dot tooltip."""
    trig = seg.get("trigger")
    atoms = seg["atoms"]
    a = next((x for x in atoms if x.get("uuid") == trig), None) if trig else None
    if a is None:
        a = next((x for x in atoms if x.get("type") == "user"), None)
    if a is None:
        return ""
    blocks = (a.get("message") or {}).get("content", [])
    if isinstance(blocks, list):
        return " ".join(b.get("text", "") for b in blocks
                        if isinstance(b, dict) and b.get("type") == "text").strip()
    return blocks if isinstance(blocks, str) else ""


def build_timeline(now, tmux=None):
    """A {type:"timeline"} message the ported timeline bundle consumes (ui-parity.md: timeline =
    ADAPT). Lanes per session; work bars are SEGMENTS [t,end] from the event model (not the deleted
    `romp-events --emit`); prompt dots at segment starts; tooltips from the captioner; awaiting/
    compacting stripes from states/; compaction markers from compact_boundary atoms; usage from
    usage.json; live state + model/effort/context%/compaction% per lane from tmux @claude-* vars.
    Message connectors (need the courier) and cross-pane focus/hover are later increments — emitted
    empty/null so the render's conditional paths hide them."""
    if tmux is None:
        tmux = _tmux_sessions()
    alive = _ordered_alive(now, tmux)                # living sessions only, in the shared lane/tab order
    id2name = {s["sid"]: s["name"] for s in alive}
    sessions, turns = [], {}
    for s in alive:
        sid, name = s["sid"], s["name"]
        tm = tmux.get(sid)
        live = tm is not None
        hexcol = (tm and tm["color"]) or (_name_color(sid) or {}).get("bg", "#888888")
        try:
            session = em.parse_session(s["path"], rompuuid=sid, candidate_files=[s["path"]],
                                       postal_log=str(jd.MESSAGES), now=now)
        except Exception:
            session = {"turns": []}
        caps = _captions(sid)
        st_turns = session["turns"]
        last_turn = st_turns[-1] if st_turns else None
        open_now = bool(last_turn and not last_turn["ended"]
                        and not any(x["type"] == "idle" for x in last_turn["atoms"]))
        if tm:                            # live: tmux state drives the lane badge (working/waiting/idle/permission/compacting)
            state = tm["state"] or "idle"
        else:                             # dead lane: coarse file-derived (badgeFor hides the badge when !live anyway)
            blocked = "blocked" in jd.load_goals(sid).get("status", {}).values()
            state = "awaiting" if blocked else ("working" if open_now else "idle")
        bars, last_t = [], None
        for ti, turn in enumerate(st_turns):
            turn_open = (ti == len(st_turns) - 1 and not turn["ended"]
                         and not any(x["type"] == "idle" for x in turn["atoms"]))
            segs = em.segments(turn)
            for si, seg in enumerate(segs):
                cap = caps.get(seg["id"], {}).get("caption", "")
                work_uuid, reply_uuid = _seg_anchors(seg["atoms"])
                trig = next((x for x in seg["atoms"] if x.get("uuid") == seg.get("trigger")), None)
                author = (trig or {}).get("author")
                src = "queued" if isinstance(author, dict) else "typed"
                last_t = max(last_t or 0, seg["end"])
                bars.append({
                    "id": seg["id"], "promptId": None, "workId": None,
                    "start": seg["t"], "end": seg["end"], "open": turn_open and si == len(segs) - 1,
                    "prompt": _seg_prompt(seg), "summary": cap, "reply": "",
                    "src": src, "mids": [], "pending": False,
                    "tid": sid, "uuid": seg.get("trigger"),
                    "workUuid": work_uuid, "replyUuid": reply_uuid})
        turns[sid] = bars
        compactions = [{"t": a["t"]} for turn in st_turns for a in turn["atoms"]
                       if a.get("type") == "system" and a.get("subtype") == "compact_boundary" and a.get("t")]
        active = bool(tm and tm["state"] in ("working", "permission", "compacting", "waiting"))
        faded = (not live) or (not active and bool(tm and tm["since"]) and now - tm["since"] > 3600)
        sessions.append({
            "id": sid, "name": name, "live": live, "state": state,
            "since": (tm["since"] if tm and tm["since"] else last_t),
            "color": hexcol,
            "model": (tm["model"] if tm else ""), "effort": (tm["effort"] if tm else ""),
            "context": (tm["context"] if tm else None),
            "compactPct": (tm["compactPct"] if tm else None),
            "awaiting": _state_intervals(sid, "permission", now),
            "compacting": _state_intervals(sid, "compacting", now),
            "compactions": compactions, "pendingMail": _pending_mail(sid),
            "stale": faded, "faded": faded})
    return {"type": "timeline", "now": now, "sessions": sessions, "turns": turns,
            "messages": _postal_messages(now, set(id2name), id2name),
            "activeChat": None, "focus": None, "hover": None, "usage": _usage()}


# ───────────────────────── WebSocket (stdlib, hand-rolled) ─────────────────────────
WS_GUID = "258EAFA5-E914-47DA-95CA-C5AB0DC85B11"


def _ws_accept(key):
    return base64.b64encode(hashlib.sha1((key + WS_GUID).encode()).digest()).decode()


def _ws_send(wfile, lock, text):
    data = text.encode("utf-8")
    n = len(data)
    hdr = bytearray([0x81])                   # FIN + text frame
    if n < 126:
        hdr.append(n)
    elif n < 65536:
        hdr.append(126); hdr += struct.pack(">H", n)
    else:
        hdr.append(127); hdr += struct.pack(">Q", n)
    with lock:
        wfile.write(bytes(hdr) + data)
        wfile.flush()


def _ws_recv(rfile):
    """Read one client (masked) frame → (opcode, payload bytes), or (None, None) on close/EOF."""
    b = rfile.read(2)
    if len(b) < 2:
        return None, None
    opcode = b[0] & 0x0F
    masked = b[1] & 0x80
    ln = b[1] & 0x7F
    if ln == 126:
        ln = struct.unpack(">H", rfile.read(2))[0]
    elif ln == 127:
        ln = struct.unpack(">Q", rfile.read(8))[0]
    mask = rfile.read(4) if masked else b"\x00\x00\x00\x00"
    payload = bytearray(rfile.read(ln))
    for i in range(len(payload)):
        payload[i] ^= mask[i % 4]
    return opcode, bytes(payload)


def _send_to_app(app, msg):
    """Push one message to every connected client of an app (chat/feed/timeline) — cross-pane routing
    so a feed/timeline click drives the chat (e.g. focus a tab + scroll to a transcript anchor)."""
    s = json.dumps(msg)
    with _clients_lock:
        targets = [c for c in _clients if c["app"] == app]
    for c in targets:
        try:
            c["send"](s)
        except Exception:
            c["alive"] = False


_nonce = [0]


def _next_nonce():
    _nonce[0] += 1
    return _nonce[0]


def _push_all():
    """Build fresh payloads and push to every connected client (per its app). The timeline payload
    re-parses every session, so it's built only when a timeline client is actually connected."""
    now = int(time.time())
    tmux = _tmux_sessions()                       # one tmux read per push, shared by all builders
    with _clients_lock:
        want_tl = any(c["app"] == "timeline" for c in _clients)
    try:
        hidden = _hidden_tabs()
        chat_list = [s for s in _ordered_alive(now, tmux) if s["sid"] not in hidden]   # × hides a tab
        chat_sessions = [m for m in (build_session(s["sid"], now, tmux) for s in chat_list) if m]
        tab_order = [s["sid"] for s in chat_list]
        feed = build_feed(now, tmux)
        timeline = build_timeline(now, tmux) if want_tl else None
    except Exception:
        sys.stderr.write("push build: %s\n" % traceback.format_exc())
        return
    with _clients_lock:
        clients = list(_clients)
    for c in clients:
        try:
            if c["app"] == "chat":
                for m in chat_sessions:
                    c["send"](json.dumps(m))
                c["send"](json.dumps({"type": "tabOrder", "order": tab_order}))   # sync tab order ↔ timeline
                c["send"](json.dumps({"type": "working", "names": feed["working"]}))
            elif c["app"] == "feed":
                c["send"](json.dumps(feed))
            elif c["app"] == "timeline":
                c["send"](json.dumps({"type": "data", "data": timeline}))
        except Exception:
            c["alive"] = False
    with _clients_lock:
        _clients[:] = [c for c in _clients if c.get("alive", True)]


# ───────────────────────── producer + push threads ─────────────────────────
def _producer():
    while True:
        try:
            with _clients_lock:
                browser = bool(_clients)
            # INDEX tier (captioner + archiver) is ALWAYS-ON for any active session — it keeps the
            # TOC/search index current even with no browser (the kernel is always up via the login
            # service). TRIAGE tier (planner; courier later) stays browser-gated — the live goal inbox
            # only matters while someone's looking. (The freeze bug was the old 90s-since-HTTP timer a
            # long-lived WS never refreshed; gate on the real signals — active tmux / connected client.)
            if _tmux_sessions():
                jd.run_once()
            if browser:
                jd.run_plan()
                jd.run_courier()
        except Exception:
            sys.stderr.write("producer: %s\n" % traceback.format_exc())
        time.sleep(20)


def _pusher():
    while True:
        with _clients_lock:
            any_client = bool(_clients)
        if any_client:
            _push_all()
        time.sleep(4)


# ───────────────────────── HTTP / page serving ─────────────────────────
