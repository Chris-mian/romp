# The combined-shell splitter JS: draggable v-split (chat|feed) + h-split (top row | timeline),
# persisted in localStorage. Iframes get pointer-events:none mid-drag so the gutter keeps the mouse
# (an iframe otherwise swallows mousemove the instant the cursor crosses it).
_LANDING_JS = """
(function(){var col=document.querySelector('.col'),row=document.querySelector('.row'),
tf=document.getElementById('f-timeline');var KC='romp-split-chat';
try{var c=localStorage.getItem(KC);if(c)row.style.setProperty('--chat',c);}catch(e){}
// timeline AUTO-FITS its content (only as tall as its lanes need): set --tl from the iframe's
// content height, re-fit on a lane add/remove (ResizeObserver) and on window resize. Capped at 70vh.
function tlContentH(){try{return tf.contentDocument.body.scrollHeight;}catch(e){return 0;}}
function cap(){return Math.round(window.innerHeight*0.7);}
function autosize(){var h=tlContentH();if(!h)return;col.style.setProperty('--tl',Math.min(h+2,cap())+'px');}
function drag(h,cls,apply){if(!h)return;h.addEventListener('mousedown',function(e){e.preventDefault();
document.body.classList.add('drag',cls);
function mv(ev){apply(ev);}function up(){document.body.classList.remove('drag',cls);
window.removeEventListener('mousemove',mv);window.removeEventListener('mouseup',up);}
window.addEventListener('mousemove',mv);window.addEventListener('mouseup',up);});}
drag(document.getElementById('gv'),'dragv',function(ev){var r=row.getBoundingClientRect();
var pct=Math.max(15,Math.min(85,(ev.clientX-r.left)/r.width*100));var v=pct.toFixed(1)+'%';
row.style.setProperty('--chat',v);try{localStorage.setItem(KC,v);}catch(e){}});
drag(document.getElementById('gh'),'dragh',function(ev){var r=col.getBoundingClientRect();
var px=r.bottom-ev.clientY;var ch=tlContentH();var mx=ch?ch+2:cap();   // can SHRINK, never exceed content
col.style.setProperty('--tl',Math.max(48,Math.min(mx,px))+'px');});
tf.addEventListener('load',function(){autosize();
try{new ResizeObserver(autosize).observe(tf.contentDocument.body);}catch(e){}});
window.addEventListener('resize',autosize);})();
"""


# Mobile shell behavior, layered on top of the desktop splitter above. The bottom tab bar (#mtabs,
# shown only by the media query below) swaps which single iframe is full-screen by toggling `m-on`.
# A cross-pane "reveal" auto-switches the visible tab: the kernel pushes {type:"reveal",pane} over an
# app=shell WebSocket when a feed/timeline tap brings the chat forward (see _reveal_chat), and the
# timeline deep-link posts the same shape as a window message. The active tab persists in localStorage.
# Entirely inert on desktop, where #mtabs is hidden and all three panes are shown at once.
_LANDING_MOBILE_JS = """
(function(){var bar=document.getElementById('mtabs');if(!bar)return;
var F={chat:document.getElementById('f-chat'),feed:document.getElementById('f-feed'),timeline:document.getElementById('f-timeline')};
var B=bar.querySelectorAll('button'),KT='romp-mobile-tab';
function show(p){if(!F[p])return;document.body.setAttribute('data-tab',p);for(var k in F)F[k].classList.toggle('m-on',k===p);
for(var i=0;i<B.length;i++)B[i].classList.toggle('on',B[i].getAttribute('data-pane')===p);
try{localStorage.setItem(KT,p);}catch(e){}}
for(var i=0;i<B.length;i++)(function(b){b.addEventListener('click',function(){show(b.getAttribute('data-pane'));});})(B[i]);
window.addEventListener('message',function(e){var m=e.data;if(m&&m.romp==='reveal'&&m.pane)show(m.pane);});
function shellWS(){try{var proto=location.protocol==='https:'?'wss://':'ws://';
var ws=new WebSocket(proto+location.host+'/ws?app=shell');
ws.onmessage=function(ev){var m;try{m=JSON.parse(ev.data);}catch(e){return;}
if(m&&m.type==='reveal'&&m.pane)show(m.pane);};
ws.onclose=function(){setTimeout(shellWS,2000);};}catch(e){}}
shellWS();
var last='chat';try{var s=localStorage.getItem(KT);if(s&&F[s])last=s;}catch(e){}show(last);
})();
"""


# Build-staleness notification (combined shell only). When the kernel serves a NEWER bundle than
# the one this tab loaded (dist_ver > the tab's load-time version), show a centered top notification
# with Reload + Dismiss — proactive, "near the top of the whole window" (the user 2026-06-16), not
# buried in the feed pane. Supersedes the gear panel's inline "⚠ reload" hint (the gear now shows
# version only). Self-contained block (own style + node + script) so it injects at one point.
_STALE_CSS = (
    "#rstale{position:fixed;top:14px;left:50%;transform:translateX(-50%);z-index:99999;display:none;"
    "align-items:center;gap:12px;max-width:92vw;background:#2b2d30;border:1px solid #4a4d51;"
    "border-radius:10px;padding:10px 14px;color:#e6e6e6;box-shadow:0 10px 30px #0000008a;"
    "font:13px/1.4 -apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif}"
    "#rstale.show{display:flex}#rstale .rs-msg{font-weight:500}"
    "#rstale button{font:inherit;cursor:pointer;border-radius:6px;padding:5px 11px;"
    "border:1px solid transparent;white-space:nowrap}"
    "#rstale .rs-reload{background:#54B204;color:#0c1a00;font-weight:600;border-color:#3f8a00}"
    "#rstale .rs-reload:hover{background:#62c80a}"
    "#rstale .rs-dismiss{background:none;color:#9aa0a6;border-color:#4a4d51}"
    "#rstale .rs-dismiss:hover{color:#e6e6e6}")
_STALE_HTML = (
    "<div id=rstale role=alert><span class=rs-msg>A newer romp build is available.</span>"
    "<button class=rs-reload id=rstale-reload>Reload</button>"
    "<button class=rs-dismiss id=rstale-dismiss>Dismiss</button></div>")
_STALE_JS = (
    "(function(){var box=document.getElementById('rstale'),"
    "rl=document.getElementById('rstale-reload'),dm=document.getElementById('rstale-dismiss');"
    "var loaded=__LOADEDVER__,dismissed=0,served=0;"
    "function check(){fetch('/version',{cache:'no-store'}).then(function(r){return r.json();}).then(function(v){"
    "served=v.dist_ver||0;"
    "if(loaded&&served>loaded&&served!==dismissed)box.classList.add('show');"
    "else if(served<=loaded)box.classList.remove('show');}).catch(function(){});}"
    "rl.onclick=function(){location.reload();};"
    "dm.onclick=function(){dismissed=served;box.classList.remove('show');};"
    "check();setInterval(check,30000);})();")


# Pane collapse handles (restored from the old TS shell — the user 2026-06-16). Each pane's faint edge
# bar folds it to a 26px strip via body.cc-* (the CSS overrides the grid-template); state persists in
# localStorage and ?collapse=feed,tl bookmarks a layout. The whole collapsed strip clicks to re-expand.
_LANDING_COLLAPSE_JS = """
(function(){
  var KEY='romp-collapse',st={chat:false,feed:false,tl:false};
  try{var s=JSON.parse(localStorage.getItem(KEY)||'null');if(s)st=Object.assign(st,s);}catch(e){}
  var cp=new URLSearchParams(location.search).get('collapse');
  if(cp!==null){st.chat=st.feed=st.tl=false;cp.split(',').forEach(function(k){k=k.trim();if(k in st)st[k]=true;});}
  function save(){try{localStorage.setItem(KEY,JSON.stringify(st));}catch(e){}}
  var P=[['chat','chat-collapse','chat-pane'],['feed','feed-collapse','feed-pane'],['tl','tl-collapse','tl-pane']];
  function apply(){
    document.body.classList.toggle('cc-chat',!!st.chat);
    document.body.classList.toggle('cc-feed',!!st.feed);
    document.body.classList.toggle('cc-tl',!!st.tl);
    P.forEach(function(p){var b=document.getElementById(p[1]);
      if(b)b.title=(st[p[0]]?'expand':'collapse')+' the '+(p[0]==='tl'?'timeline':p[0]);});
  }
  function toggle(k){st[k]=!st[k];apply();save();}
  P.forEach(function(p){
    var b=document.getElementById(p[1]);if(b)b.onclick=function(e){e.stopPropagation();toggle(p[0]);};
    var pane=document.getElementById(p[2]);if(pane)pane.addEventListener('click',function(){if(st[p[0]])toggle(p[0]);});
  });
  apply();
})();
"""


def _stale_block(v):
    return ("<style>" + _STALE_CSS + "</style>" + _STALE_HTML
            + "<script>" + _STALE_JS.replace("__LOADEDVER__", str(int(v))) + "</script>")


def _landing():
    # combined 3-pane shell: chat | feed on top (draggable col-resize gutter), the timeline band
    # full-width below (draggable row-resize gutter). Pane sizes persist in localStorage.
    #
    # On a narrow / touch viewport the 3-pane grid can't fit, so the media query collapses it to ONE
    # full-screen pane at a time, switched by the bottom tab bar (Chat / Feed / Timeline). All three
    # iframes stay in the DOM with their WebSockets live, so switching is instant and the background
    # panes keep updating; _LANDING_MOBILE_JS drives the switcher + cross-pane reveal.
    v = _dist_ver()
    return ("<!DOCTYPE html><html lang=en><head><meta charset=UTF-8>"
            # maximum-scale=1,user-scalable=no: the top document governs pinch-zoom for the whole visual
            # viewport (incl. iframes), so without this iOS page-zooms on a timeline pinch instead of letting
            # the timeline's own pinch handler run (the user 2026-06-16). Disables browser zoom on the mobile UI.
            "<meta name=viewport content='width=device-width,initial-scale=1,viewport-fit=cover,maximum-scale=1,user-scalable=no'>"
            "<link rel=icon type=image/svg+xml href=/media/romp-swirl-glyph.svg><title>Romp</title><style>"
            "html,body{margin:0;height:100%;background:#1e1e1e;overflow:hidden}"
            ".col{display:grid;grid-template-rows:1fr 5px var(--tl,160px);height:100vh}"
            ".row{display:grid;grid-template-columns:var(--chat,60%) 5px 1fr;min-height:0}"
            "iframe{border:0;width:100%;height:100%}"
            ".gv{cursor:col-resize;background:linear-gradient(90deg,transparent 2px,#333 2px,#333 3px,transparent 3px)}"
            ".gh{cursor:row-resize;background:linear-gradient(180deg,transparent 2px,#333 2px,#333 3px,transparent 3px)}"
            ".gv:hover{background:linear-gradient(90deg,transparent 2px,#007fd4 2px,#007fd4 3px,transparent 3px)}"
            ".gh:hover{background:linear-gradient(180deg,transparent 2px,#007fd4 2px,#007fd4 3px,transparent 3px)}"
            "body.drag iframe{pointer-events:none}body.dragv{cursor:col-resize}body.dragh{cursor:row-resize}"
            # ── pane collapse handles (the user 2026-06-16): a faint bar on each pane's collapse-toward
            # edge — chat→right, feed→left, timeline→top — folds it to a 26px strip (body.cc-* overrides
            # the grid-template; coexists with the splitter's --chat/--tl). Sizes/positions from the old shell.
            ".pane{position:relative;min-width:0;min-height:0;overflow:hidden}"
            ".collapse-btn{position:absolute;z-index:30;display:flex;align-items:center;justify-content:center;"
            "background:#2a2a2a;color:#999;border:1px solid #3a3a3a;cursor:pointer;user-select:none;opacity:.3;transition:opacity .1s}"
            ".collapse-btn:hover{opacity:1;color:#fff}"
            ".collapse-btn .bar-v{width:3px;height:12px;border-radius:2px;background:currentColor;display:block}"
            ".collapse-btn .bar-h{width:12px;height:3px;border-radius:2px;background:currentColor;display:block}"
            "#chat-collapse{top:50%;right:0;transform:translateY(-50%);width:13px;height:46px;border-radius:5px 0 0 5px;border-right:0}"
            "#feed-collapse{top:50%;left:0;transform:translateY(-50%);width:13px;height:46px;border-radius:0 5px 5px 0;border-left:0}"
            "#tl-collapse{left:50%;top:0;transform:translateX(-50%);width:46px;height:13px;border-radius:0 0 5px 5px;border-top:0}"
            ".pane-label{display:none;color:#8a8a8a;font:11px -apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;letter-spacing:.06em;user-select:none;cursor:pointer}"
            "body.cc-chat .row{grid-template-columns:26px 5px 1fr}"
            "body.cc-feed .row{grid-template-columns:1fr 5px 26px}"
            "body.cc-tl .col{grid-template-rows:1fr 5px 26px}"
            "body.cc-chat #chat-pane>iframe,body.cc-feed #feed-pane>iframe,body.cc-tl #tl-pane>iframe{display:none}"
            "body.cc-chat #chat-pane,body.cc-feed #feed-pane,body.cc-tl #tl-pane{background:#181818;cursor:pointer;display:flex;align-items:center;justify-content:center;gap:8px}"
            "body.cc-chat #chat-pane,body.cc-feed #feed-pane{flex-direction:column}"
            "body.cc-tl #tl-pane{flex-direction:row}"
            "body.cc-chat #chat-collapse,body.cc-feed #feed-collapse,body.cc-tl #tl-collapse{position:static;transform:none;opacity:.8;width:22px;height:22px;border-radius:5px;border:1px solid #3a3a3a}"
            "body.cc-chat #chat-pane .pane-label,body.cc-feed #feed-pane .pane-label{display:block;writing-mode:vertical-rl}"
            "body.cc-tl #tl-pane .pane-label{display:block}"
            "body.cc-chat #gv,body.cc-feed #gv{visibility:hidden}body.cc-tl #gh{visibility:hidden}"
            "#mtabs{display:none}"
            # narrow OR a touch device up to 1024px → one pane + bottom tabs; mouse desktops keep the grid
            "@media (max-width:820px),(pointer:coarse) and (max-width:1024px){"
            # flex column instead of fixed+height-math: the active pane fills the space and the switcher
            # sits below it, so the bar can NEVER overlap the chat composer (the earlier cover bug). Only
            # body height uses dvh (the address-bar-aware viewport); flex distributes the rest.
            "html,body{height:100%}"
            "body{display:flex;flex-direction:column;height:100vh;height:100dvh}"
            ".col{flex:1 1 auto;min-height:0;display:flex;flex-direction:column;height:auto}"
            ".row{flex:1 1 auto;min-height:0;display:block}"
