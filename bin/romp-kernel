#!/usr/bin/env python3
"""romp-kernel — the merged read-side kernel (design/read-side.md). One always-on process:
the Layer-1 parser + Layer-2 judges (producer) co-located with an HTTP+WebSocket server,
single writer. It serves the HUMAN'S TUNED chat-view UI (render.js/feed.js bundles, reused
verbatim) and pushes reshaped payloads built ONLY from the new records (captions/ goals/
archive/). The Python projection here is the SINGLE view-builder; the bundles only render.

Transport is the SAME WebSocket postMessage protocol the bundles already speak (the
`shimJs` bridge is reused verbatim), so the VS Code extension repoints to this kernel with
zero protocol change at switchover. WS is hand-rolled on the stdlib socket (no dependency).

Sits beside the untouched chat-view Node kernel during the minimal phase (extension stays on
old). Port status (KEEP/ADAPT/DROP) tracked in design/ui-parity.md + backlog.md.

Run:  python3 ~/GitRepos/romp-event-model/bin/romp-kernel   → opens http://127.0.0.1:7878
"""
import json, os, sys, time, threading, traceback, base64, hashlib, struct, subprocess
from pathlib import Path
from datetime import datetime
from importlib.machinery import SourceFileLoader
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from urllib.parse import urlparse, parse_qs

HERE = Path(__file__).resolve().parent
ROOT = HERE.parent
em = SourceFileLoader("romp_event_model", str(HERE / "romp-event-model")).load_module()
jd = SourceFileLoader("romp_judge", str(HERE / "romp-judge")).load_module()
cm = SourceFileLoader("romp_colormap", str(HERE / "romp_colormap.py")).load_module()  # age → recency tint
CHAT_VIEW = ROOT / "chat-view"               # the tuned UI, current in this worktree via `git merge main`
DIST = CHAT_VIEW / "dist"                    # bundles built from CHAT_VIEW/src (the human's tuned render layer)
MEDIA = CHAT_VIEW / "media"
OBSIDIAN = ROOT / "obsidian"
NAMES = jd.STATE / "names"
PORT = int(os.environ.get("ROMP_KERNEL_PORT", "7878"))
BIND = os.environ.get("ROMP_SERVE_HOST", "127.0.0.1")   # set 0.0.0.0 to reach the kernel over the tailnet / a phone


def _load_token():
    """The serve token, baked into launch so the human never passes --token: ROMP_SERVE_TOKEN if
    set, else a stable random token persisted under the state dir. Required only for NON-local
    reach; local clients pass on the Origin check + auto-injected cookie."""
    t = (os.environ.get("ROMP_SERVE_TOKEN") or "").strip()
    if t:
        return t
    f = jd.STATE / "serve-token"
    try:
        v = f.read_text().strip()
        if v:
            return v
    except OSError:
        pass
    v = base64.urlsafe_b64encode(os.urandom(18)).decode().rstrip("=")
    try:
        jd.STATE.mkdir(parents=True, exist_ok=True)
        f.write_text(v)
        os.chmod(f, 0o600)
    except OSError:
        pass
    return v

TOKEN = _load_token()

_clients = []                                # connected WS clients: {app, wid, send, alive}
_clients_lock = threading.Lock()
_client_seen = [0.0]


# ───────────────────────── helpers ─────────────────────────
def iso(t):
    try:
        return datetime.fromtimestamp(t).strftime("%Y-%m-%dT%H:%M:%S")
    except Exception:
        return ""


def _name_color(sid):
    """Session display color {bg,fg} from the names registry (3rd tab field), or null."""
    try:
        parts = (NAMES / sid).read_text().rstrip("\n").split("\t")
        if len(parts) > 2 and parts[2].startswith("#"):
            return {"bg": parts[2], "fg": "#ffffff"}
    except Exception:
        pass
    return None


def _rgb(color):
    """The card's recency-tint [r,g,b] — the session color (the old hawaii recency colormap is
    a later refinement), defaulting to a neutral slate."""
    h = (color or {}).get("bg", "#7088aa").lstrip("#")
    try:
        return [int(h[0:2], 16), int(h[2:4], 16), int(h[4:6], 16)]
    except Exception:
        return [112, 136, 170]


def _sessions(now):
    out = []
    for fsid, path, anchor, name in jd.discover(now):
        try:
            mtime = os.stat(path).st_mtime
        except OSError:
            mtime = 0
        out.append({"sid": fsid, "name": name or fsid[:8], "path": str(path), "mtime": mtime})
    out.sort(key=lambda s: s["mtime"], reverse=True)
    return out


def _captions(fsid):
    out = {}
    try:
        for line in (jd.CAPDIR / (fsid + ".jsonl")).read_text(errors="replace").splitlines():
            try:
                o = json.loads(line)
            except Exception:
                continue
            if o.get("id"):
                out[o["id"]] = o
    except OSError:
        pass
    return out


# ───────────────────────── view-builder: atoms → chat ChatEvent[] (parity: chat = KEEP) ─────────────────────────
def _edit_diff(inp):
    """A minimal unified-ish diff string for an Edit/MultiEdit tool_use input (the render folds it)."""
    edits = inp.get("edits") or ([{"old_string": inp.get("old_string", ""),
                                   "new_string": inp.get("new_string", "")}] if "old_string" in inp else [])
    lines = []
    for e in edits:
        for ln in str(e.get("old_string", "")).splitlines():
            lines.append("- " + ln)
        for ln in str(e.get("new_string", "")).splitlines():
            lines.append("+ " + ln)
    return "\n".join(lines)


def build_session(sid, now):
    """A {type:"session"} message the render.js bundle consumes: the event tree reshaped to
    ChatEvent[], plus the TOC ledger (archiver headline + turn captions) and a status chip."""
    sess = next((s for s in _sessions(now) if s["sid"] == sid), None)
    if not sess:
        return None
    session = em.parse_session(sess["path"], rompuuid=sid, candidate_files=[sess["path"]],
                               postal_log=str(jd.MESSAGES), now=now)
    caps = _captions(sid)
    events, by_tool = [], {}                  # by_tool: tool_use_id → its tool event (fill output later)
    last_t = None
    for turn in session["turns"]:
        for a in turn["atoms"]:
            t = a.get("t"); ts = iso(t) if t else None
            last_t = t or last_t
            msg = a.get("message") or {}
            blocks = msg.get("content", []) if isinstance(msg.get("content"), list) else []
            if a["type"] == "user":
                author = a.get("author")
                trs = [b for b in blocks if isinstance(b, dict) and b.get("type") == "tool_result"]
                if isinstance(author, dict):                     # peer message → postal card
                    text = " ".join(b.get("text", "") for b in blocks if b.get("type") == "text")
                    events.append({"kind": "postal", "direction": "in", "peer": (author.get("peer") or "peer"),
                                   "body": text, "uuid": a.get("uuid"), "ts": ts, "t": t, "status": "delivered"})
                elif trs:                                        # tool_result → fill the matching tool event's output
                    for tr in trs:
                        ev = by_tool.get(tr.get("tool_use_id"))
                        if ev is not None:
                            c = tr.get("content")
                            ev["output"] = c if isinstance(c, str) else json.dumps(c)[:4000]
                            ev["isError"] = bool(tr.get("is_error"))
                            ev["resultUuid"] = a.get("uuid")
                else:                                            # genuine prompt
                    text = " ".join(b.get("text", "") for b in blocks if b.get("type") == "text").strip() \
                           if blocks else (msg.get("content") if isinstance(msg.get("content"), str) else "")
                    if text:
                        events.append({"kind": "user", "md": text, "uuid": a.get("uuid"), "ts": ts,
                                       "human": author == "human"})
            elif a["type"] == "assistant":
                for b in blocks:
                    if not isinstance(b, dict):
                        continue
                    if b.get("type") == "thinking":
                        events.append({"kind": "thinking", "text": b.get("thinking", ""),
                                       "encrypted": bool(b.get("signature")), "uuid": a.get("uuid"), "ts": ts})
                    elif b.get("type") == "text" and b.get("text", "").strip():
                        events.append({"kind": "assistant", "md": b["text"], "uuid": a.get("uuid"), "ts": ts})
                    elif b.get("type") == "tool_use":
                        inp = b.get("input") or {}
                        ev = {"kind": "tool", "name": b.get("name", "tool"), "desc": "",
                              "input": json.dumps(inp)[:2000], "output": "", "isError": False,
                              "uuid": a.get("uuid"), "ts": ts,
                              "file": inp.get("file_path") or inp.get("path") or "",
                              "diff": _edit_diff(inp) if b.get("name") in ("Edit", "MultiEdit", "Write") else ""}
                        by_tool[b.get("id")] = ev
                        events.append(ev)
            elif a["type"] == "system" and a.get("subtype") == "compact_boundary":
                events.append({"kind": "assistant", "md": "✦ Compacted", "uuid": a.get("uuid"), "ts": ts})
    # TOC ledger: archiver headline + turn captions (click-to-jump via the turn's anchor uuid)
    arch = jd.load_archive(sid) or {}
    bullets = []
    for turn in session["turns"]:
        cap = caps.get(turn["id"], {}).get("caption")
        anchor = next((x.get("uuid") for x in turn["atoms"] if x.get("uuid")), None)
        if cap:
            bullets.append({"text": cap, "t": turn["t"], "id": anchor, "sid": sid})
    ledger = {"summary": arch.get("headline", ""), "bullets": bullets}
    last_turn = session["turns"][-1] if session["turns"] else None
    open_now = bool(last_turn and not last_turn["ended"]
                    and not any(x["type"] == "idle" for x in last_turn["atoms"]))
    status = {"state": "working" if open_now else "idle",
              "sinceEpoch": last_t, "faded": not open_now}
    return {"type": "session", "id": sid, "name": sess["name"], "color": _name_color(sid),
            "events": events, "status": status, "ledger": ledger, "firstSeen": session["turns"][0]["t"]
            if session["turns"] else now}


# ───────────────────────── view-builder: goals → feed (parity: feed = ADAPT; minimal here) ─────────────────────────
def build_feed(now):
    """The {type:"feed"} message the tuned feed.js bundle consumes (ui-parity.md: feed = ADAPT).
    Goals map onto the AskItem/AskTreeNode shape the render already speaks: the goal tree IS the
    card's tree, rolled-up status → the Working/Blocked/Completed column, dead-concept fields
    (relevance/liveness/suspects/openQuestions/decision-briefs) left empty so the render's
    conditional paths hide them — no edits to the tuned card code. Stream = turn captions."""
    asks, stream, working = [], [], []
    for s in _sessions(now):
        fsid, name = s["sid"], s["name"]
        color = _name_color(fsid); live = s["mtime"] >= now - 90
        if live:
            working.append(name)
        store = jd.load_goals(fsid)
        nodes, status = store.get("nodes", {}), store.get("status", {})
        children = {}
        for nid, nd in nodes.items():
            children.setdefault(nd.get("parentId"), []).append(nid)

        def node_status(nd):
            return "done" if nd.get("nodeComplete") else ("question" if nd.get("blocked") else "open")

        def flatten(nid, out):                       # AskTreeNode flat list, root first; nest via children ids
            nd = nodes[nid]
            kids = sorted(children.get(nid, []), key=lambda c: nodes[c]["t"])
            out.append({"id": nid, "kind": "ask", "text": nd["text"], "who": name, "whoSid": fsid,
                        "whoColor": color, "whoWorking": False, "status": node_status(nd),
                        "t": nd["t"], "last": nd["t"], "trgb": list(cm.age_rgb(now - nd["t"])),
                        "children": kids, "rows": []})
            for c in kids:
                flatten(c, out)
            return out
        for nid in children.get(None, []):
            col = status.get(nid, "working")
            if col == "cleared":
                continue
            asks.append({
                "itemId": nid, "sid": fsid, "name": name, "color": color, "text": nodes[nid]["text"],
                "t": nodes[nid]["t"], "created": nodes[nid]["t"], "live": live,
                "trgb": list(cm.age_rgb(now - nodes[nid]["t"])),
                "done": 0, "needsYou": 0, "linked": [], "turnId": nid, "turnIds": [nid],
                "column": ("needs_input" if col == "blocked" else "completed" if col == "completed" else "working"),
                "openQuestions": [], "openPaths": [], "tree": flatten(nid, [])})
        for c in _captions(fsid).values():
            if c.get("grain") == "turn":
                stream.append({"itemId": c["id"], "sid": fsid, "name": name, "color": color,
                               "did": c["caption"], "t": c["t"], "trgb": list(cm.age_rgb(now - c["t"])),
                               "relevance": "DETAILS", "live": live, "standalone": True})
    stream.sort(key=lambda c: c["t"], reverse=True)
    return {"type": "feed", "asks": asks, "items": stream[:200], "blocked": [], "now": now,
            "working": working, "dismissedCount": 0, "showDismissed": False, "canUndoClear": False}


# ───────────────────────── view-builder: segments → timeline (parity: timeline = ADAPT) ─────────────────────────
TL_HORIZON = 48 * 3600                        # how far back stripes are read (matches the slider max)


def _state_intervals(sid, want, now):
    """Every [start,end] the session sat in `want` ('permission' → awaiting candy-stripes,
    'compacting' → cross-hatch), from states/<sid>.jsonl: an entry runs until the next transition
    (or `now` if still in it). Forward-only — periods predating the log don't appear. File-based
    port of the obsidian timeline's stateIntervals (the kernel reads states/, never tmux)."""
    try:
        text = (jd.STATE / "states" / (sid + ".jsonl")).read_text(errors="replace")
    except OSError:
        return []
    ev = []
    for line in text.splitlines():
        if not line:
            continue
        try:
            o = json.loads(line)
        except Exception:
            continue
        if o.get("t") and o.get("state"):
            ev.append((o["t"], o["state"]))
    ev.sort()
    cutoff, out = now - TL_HORIZON, []
    for i, (t, st) in enumerate(ev):
        if st != want:
            continue
        end = ev[i + 1][0] if i + 1 < len(ev) else now
        if end < cutoff:
            continue
        out.append([max(t, cutoff), end])
    return out


def _usage():
    """The /usage rate-limit bars (5h + weekly) from usage.json, or None. File-based, like the
    obsidian timeline's readUsage."""
    try:
        o = json.loads((jd.STATE / "usage.json").read_text())
    except Exception:
        return None

    def seg(s):
        if isinstance(s, dict) and isinstance(s.get("pct"), (int, float)):
            ra = s.get("resets_at")
            return {"pct": max(0, min(100, round(s["pct"]))),
                    "resetsAt": ra if isinstance(ra, (int, float)) else None}
        return None
    five, seven = seg(o.get("five_hour")), seg(o.get("seven_day"))
    if not five and not seven:
        return None
    t = o.get("t")
    return {"fiveHour": five, "sevenDay": seven, "t": t if isinstance(t, (int, float)) else None}


def _pending_mail(sid):
    """Unread/parked postal count for a lane (the 📬 flag, esp. on dead lanes), from
    postal/mail-pending/<sid> (presence gate) + postal/mail/<sid>/new (count)."""
    try:
        base = jd.STATE / "postal"
        if not (base / "mail-pending" / sid).exists():
            return 0
        return sum(1 for f in (base / "mail" / sid / "new").iterdir() if not f.name.startswith("."))
    except Exception:
        return 0


def _seg_anchors(atoms):
    """(workUuid, replyUuid) deep-link anchors for a segment: workUuid = the FIRST assistant atom
    (the bar → response, often a thinking block); replyUuid = the LAST assistant atom carrying
    text (the readable reply, preferred work anchor) — parallel to the obsidian timeline."""
    work = reply = None
    for a in atoms:
        if a.get("type") != "assistant":
            continue
        if work is None:
            work = a.get("uuid")
        blocks = (a.get("message") or {}).get("content", [])
        if isinstance(blocks, list) and any(
                isinstance(b, dict) and b.get("type") == "text" and b.get("text", "").strip()
                for b in blocks):
            reply = a.get("uuid")
    return work, reply


def _seg_prompt(seg):
    """The segment's request text (its trigger/opener atom) for the prompt-dot tooltip."""
    trig = seg.get("trigger")
    atoms = seg["atoms"]
    a = next((x for x in atoms if x.get("uuid") == trig), None) if trig else None
    if a is None:
        a = next((x for x in atoms if x.get("type") == "user"), None)
    if a is None:
        return ""
    blocks = (a.get("message") or {}).get("content", [])
    if isinstance(blocks, list):
        return " ".join(b.get("text", "") for b in blocks
                        if isinstance(b, dict) and b.get("type") == "text").strip()
    return blocks if isinstance(blocks, str) else ""


def build_timeline(now):
    """A {type:"timeline"} message the ported timeline bundle consumes (ui-parity.md: timeline =
    ADAPT). Lanes per session; work bars are SEGMENTS [t,end] from the event model (not the deleted
    `romp-events --emit`); prompt dots at segment starts; tooltips from the captioner; awaiting/
    compacting stripes from states/; compaction markers from compact_boundary atoms; usage from
    usage.json. Message connectors (need the courier) and model/effort pickers + context battery
    (tmux-only) are later increments — emitted empty/absent so the render's conditional paths hide
    them."""
    sessions, turns = [], {}
    for s in _sessions(now):
        sid, name = s["sid"], s["name"]
        hexcol = (_name_color(sid) or {}).get("bg", "#888888")
        live = s["mtime"] >= now - 90
        try:
            session = em.parse_session(s["path"], rompuuid=sid, candidate_files=[s["path"]],
                                       postal_log=str(jd.MESSAGES), now=now)
        except Exception:
            session = {"turns": []}
        caps = _captions(sid)
        st_turns = session["turns"]
        last_turn = st_turns[-1] if st_turns else None
        open_now = bool(last_turn and not last_turn["ended"]
                        and not any(x["type"] == "idle" for x in last_turn["atoms"]))
        blocked = "blocked" in jd.load_goals(sid).get("status", {}).values()
        state = "working" if open_now else ("awaiting" if blocked else "idle")
        bars, last_t = [], None
        for ti, turn in enumerate(st_turns):
            turn_open = (ti == len(st_turns) - 1 and not turn["ended"]
                         and not any(x["type"] == "idle" for x in turn["atoms"]))
            segs = em.segments(turn)
            for si, seg in enumerate(segs):
                cap = caps.get(seg["id"], {}).get("caption", "")
                work_uuid, reply_uuid = _seg_anchors(seg["atoms"])
                trig = next((x for x in seg["atoms"] if x.get("uuid") == seg.get("trigger")), None)
                author = (trig or {}).get("author")
                src = "queued" if isinstance(author, dict) else "typed"
                last_t = max(last_t or 0, seg["end"])
                bars.append({
                    "id": seg["id"], "promptId": None, "workId": None,
                    "start": seg["t"], "end": seg["end"], "open": turn_open and si == len(segs) - 1,
                    "prompt": _seg_prompt(seg), "summary": cap, "reply": "",
                    "src": src, "mids": [], "pending": False,
                    "tid": sid, "uuid": seg.get("trigger"),
                    "workUuid": work_uuid, "replyUuid": reply_uuid})
        turns[sid] = bars
        compactions = [{"t": a["t"]} for turn in st_turns for a in turn["atoms"]
                       if a.get("type") == "system" and a.get("subtype") == "compact_boundary" and a.get("t")]
        sessions.append({
            "id": sid, "name": name, "live": live, "state": state, "since": last_t,
            "color": hexcol, "model": "", "effort": "", "context": None, "compactPct": None,
            "awaiting": _state_intervals(sid, "permission", now),
            "compacting": _state_intervals(sid, "compacting", now),
            "compactions": compactions, "pendingMail": _pending_mail(sid),
            "stale": not live, "faded": not live})
    return {"type": "timeline", "now": now, "sessions": sessions, "turns": turns,
            "messages": [], "activeChat": None, "focus": None, "hover": None, "usage": _usage()}


# ───────────────────────── WebSocket (stdlib, hand-rolled) ─────────────────────────
WS_GUID = "258EAFA5-E914-47DA-95CA-C5AB0DC85B11"


def _ws_accept(key):
    return base64.b64encode(hashlib.sha1((key + WS_GUID).encode()).digest()).decode()


def _ws_send(wfile, lock, text):
    data = text.encode("utf-8")
    n = len(data)
    hdr = bytearray([0x81])                   # FIN + text frame
    if n < 126:
        hdr.append(n)
    elif n < 65536:
        hdr.append(126); hdr += struct.pack(">H", n)
    else:
        hdr.append(127); hdr += struct.pack(">Q", n)
    with lock:
        wfile.write(bytes(hdr) + data)
        wfile.flush()


def _ws_recv(rfile):
    """Read one client (masked) frame → (opcode, payload bytes), or (None, None) on close/EOF."""
    b = rfile.read(2)
    if len(b) < 2:
        return None, None
    opcode = b[0] & 0x0F
    masked = b[1] & 0x80
    ln = b[1] & 0x7F
    if ln == 126:
        ln = struct.unpack(">H", rfile.read(2))[0]
    elif ln == 127:
        ln = struct.unpack(">Q", rfile.read(8))[0]
    mask = rfile.read(4) if masked else b"\x00\x00\x00\x00"
    payload = bytearray(rfile.read(ln))
    for i in range(len(payload)):
        payload[i] ^= mask[i % 4]
    return opcode, bytes(payload)


def _push_all():
    """Build fresh payloads and push to every connected client (per its app). The timeline payload
    re-parses every session, so it's built only when a timeline client is actually connected."""
    now = int(time.time())
    with _clients_lock:
        want_tl = any(c["app"] == "timeline" for c in _clients)
    try:
        chat_sessions = [build_session(s["sid"], now) for s in _sessions(now)]
        chat_sessions = [m for m in chat_sessions if m]
        feed = build_feed(now)
        timeline = build_timeline(now) if want_tl else None
    except Exception:
        sys.stderr.write("push build: %s\n" % traceback.format_exc())
        return
    with _clients_lock:
        clients = list(_clients)
    for c in clients:
        try:
            if c["app"] == "chat":
                for m in chat_sessions:
                    c["send"](json.dumps(m))
                c["send"](json.dumps({"type": "working", "names": feed["working"]}))
            elif c["app"] == "feed":
                c["send"](json.dumps(feed))
            elif c["app"] == "timeline":
                c["send"](json.dumps({"type": "data", "data": timeline}))
        except Exception:
            c["alive"] = False
    with _clients_lock:
        _clients[:] = [c for c in _clients if c.get("alive", True)]


# ───────────────────────── producer + push threads ─────────────────────────
def _producer():
    while True:
        try:
            if time.time() - _client_seen[0] < 90:
                jd.run_once(); jd.run_plan()
        except Exception:
            sys.stderr.write("producer: %s\n" % traceback.format_exc())
        time.sleep(20)


def _pusher():
    while True:
        with _clients_lock:
            any_client = bool(_clients)
        if any_client:
            _push_all()
        time.sleep(4)


# ───────────────────────── HTTP / page serving ─────────────────────────
THEME_CSS = """:root{--vscode-font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;
--vscode-editor-font-family:Menlo,Monaco,"Courier New",monospace;--vscode-chat-font-family:var(--vscode-font-family);
--vscode-chat-font-size:13px;--vscode-foreground:#cccccc;--vscode-descriptionForeground:rgba(204,204,204,.7);
--vscode-errorForeground:#f48771;--vscode-editor-background:#1e1e1e;--vscode-editorWidget-background:#252526;
--vscode-editorHoverWidget-border:#454545;--vscode-sideBar-background:#252526;--vscode-widget-border:#303031;
--vscode-focusBorder:#007fd4;--vscode-input-background:#3c3c3c;--vscode-input-foreground:#cccccc;
--vscode-input-border:#3c3c3c;--vscode-menu-background:#252526;--vscode-menu-foreground:#cccccc;
