# The WS bridge shim (ported verbatim from chat-view server.ts shimJs — same protocol).
def _shim(app):
    return """
(function(){var queue=[],ws=null;var wid=new URLSearchParams(location.search).get("wid")||"";
function connect(){var proto=location.protocol==="https:"?"wss://":"ws://";
ws=new WebSocket(proto+location.host+"/ws?app=%s"+(wid?"&wid="+encodeURIComponent(wid):""));
ws.onopen=function(){for(var i=0;i<queue.length;i++)ws.send(queue[i]);queue=[];};
ws.onmessage=function(ev){var msg;try{msg=JSON.parse(ev.data);}catch(e){return;}
window.dispatchEvent(new MessageEvent("message",{data:msg}));};
ws.onclose=function(){setTimeout(function(){location.reload();},1500);};}
function send(m){var s=JSON.stringify(m);if(ws&&ws.readyState===1)ws.send(s);else queue.push(s);}
window.acquireVsCodeApi=function(){return{postMessage:function(m){send(m);},
getState:function(){return null;},setState:function(){}};};connect();})();
""" % app


def _chat_page():
    return ("<!DOCTYPE html><html lang=en><head><meta charset=UTF-8>"
            "<meta name=viewport content='width=device-width,initial-scale=1'>"
            "<link rel=icon type=image/svg+xml href=/media/romp-swirl-glyph.svg>"
            "<link href=/dist/styles.css rel=stylesheet><title>romp</title>"
            "<style>%s</style></head><body>%s<script>%s</script>"
            "<script src=/dist/render.js></script></body></html>"
            % (THEME_CSS, _chat_body(), _shim("chat")))


