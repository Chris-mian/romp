            # mobile uses the bottom tab switcher, not collapse: dissolve the .pane wrappers (so the
            # iframes act as direct flex children again, as the mobile rules below expect) + hide the handles
            ".pane{display:contents}.collapse-btn,.pane-label{display:none}"
            "iframe{position:static;display:none;width:100%;height:100%;border:0}"
            "#f-chat.m-on,#f-feed.m-on{display:block}"
            "#f-timeline{flex:1 1 auto;min-height:0}#f-timeline.m-on{display:block}"
            "body[data-tab=timeline] .row{display:none}"    # timeline active → collapse the chat/feed row
            # compact text-only switcher; height is just the button text + a little padding (no fixed pos)
            "#mtabs{display:flex;flex:0 0 auto;z-index:20;"
            "padding-bottom:env(safe-area-inset-bottom,0px);background:#181818;border-top:1px solid #303031}"
            "#mtabs button{flex:1;border:0;background:none;cursor:pointer;-webkit-tap-highlight-color:transparent;"
            "color:#9aa0a6;font:600 12px -apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;"
            "padding:6px 0;display:flex;align-items:center;justify-content:center}"
            "#mtabs button.on{color:#4da4ff}"
            "}"
            "</style></head><body><div class=col>"
            "<div class=row>"
            "<div class=pane id=chat-pane><iframe id=f-chat class=m-on src=/chat></iframe>"
            "<div class=collapse-btn id=chat-collapse title='collapse the chat'><span class=bar-v></span></div>"
            "<span class=pane-label>chat</span></div>"
            "<div class=gv id=gv></div>"
            "<div class=pane id=feed-pane><iframe id=f-feed src=/feed></iframe>"
            "<div class=collapse-btn id=feed-collapse title='collapse the feed'><span class=bar-v></span></div>"
