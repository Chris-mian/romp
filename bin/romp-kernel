# The combined-shell splitter JS: draggable v-split (chat|feed) + h-split (top row | timeline),
# persisted in localStorage. Iframes get pointer-events:none mid-drag so the gutter keeps the mouse
# (an iframe otherwise swallows mousemove the instant the cursor crosses it).
_LANDING_JS = """
(function(){var col=document.querySelector('.col'),row=document.querySelector('.row');
var KC='romp-split-chat',KT='romp-split-tl';
try{var c=localStorage.getItem(KC);if(c)row.style.setProperty('--chat',c);
var t=localStorage.getItem(KT);if(t)col.style.setProperty('--tl',t);}catch(e){}
function drag(h,cls,apply){if(!h)return;h.addEventListener('mousedown',function(e){e.preventDefault();
document.body.classList.add('drag',cls);
function mv(ev){apply(ev);}function up(){document.body.classList.remove('drag',cls);
window.removeEventListener('mousemove',mv);window.removeEventListener('mouseup',up);}
window.addEventListener('mousemove',mv);window.addEventListener('mouseup',up);});}
drag(document.getElementById('gv'),'dragv',function(ev){var r=row.getBoundingClientRect();
var pct=Math.max(15,Math.min(85,(ev.clientX-r.left)/r.width*100));var v=pct.toFixed(1)+'%';
row.style.setProperty('--chat',v);try{localStorage.setItem(KC,v);}catch(e){}});
drag(document.getElementById('gh'),'dragh',function(ev){var r=col.getBoundingClientRect();
var pct=Math.max(10,Math.min(80,(r.bottom-ev.clientY)/r.height*100));var v=pct.toFixed(1)+'%';
col.style.setProperty('--tl',v);try{localStorage.setItem(KT,v);}catch(e){}});})();
"""


def _landing():
    # combined 3-pane shell: chat | feed on top (draggable col-resize gutter), the timeline band
    # full-width below (draggable row-resize gutter). Pane sizes persist in localStorage.
    return ("<!DOCTYPE html><html lang=en><head><meta charset=UTF-8><title>romp</title><style>"
            "html,body{margin:0;height:100%;background:#1e1e1e;overflow:hidden}"
            ".col{display:grid;grid-template-rows:1fr 6px var(--tl,34%);height:100vh}"
            ".row{display:grid;grid-template-columns:var(--chat,60%) 6px 1fr;min-height:0}"
            "iframe{border:0;width:100%;height:100%}"
            ".gv{cursor:col-resize}.gh{cursor:row-resize}.gv,.gh{background:#303031}"
            ".gv:hover,.gh:hover{background:#007fd4}"
            "body.drag iframe{pointer-events:none}body.dragv{cursor:col-resize}body.dragh{cursor:row-resize}"
            "</style></head><body><div class=col>"
            "<div class=row><iframe src=/chat></iframe><div class=gv id=gv></div>"
            "<iframe src=/feed></iframe></div>"
            "<div class=gh id=gh></div><iframe src=/timeline></iframe></div>"
            "<script>" + _LANDING_JS + "</script></body></html>")


class Handler(BaseHTTPRequestHandler):
    protocol_version = "HTTP/1.1"

    def log_message(self, *a):
        pass

    def _send(self, code, body, ctype):
        body = body.encode("utf-8") if isinstance(body, str) else body
        self.send_response(code)
        self.send_header("Content-Type", ctype)
        self.send_header("Content-Length", str(len(body)))
        if getattr(self, "_set_cookie", None):       # auto-inject the token so a local client never 401-loops
            self.send_header("Set-Cookie", "romp_token=%s; Path=/; SameSite=Strict; HttpOnly" % self._set_cookie)
        self.end_headers()
        self.wfile.write(body)

    # ── serve-layer security (design/read-side.md): Origin/Host gate always; token for non-local reach ──
    def _is_local_host(self):
        host = (self.headers.get("Host") or "").rsplit(":", 1)[0].strip("[]")
        return host in ("127.0.0.1", "localhost", "::1", "")

    def _origin_ok(self):
        """Reject cross-site browser origins — the ClawJacked/WS hole (WS isn't covered by CORS, so
        this is the real gate). Allow same-origin, the local kernel origin, vscode-webview, and an
        ABSENT Origin (non-browser clients like the obsidian fetch / curl; the Host/token gate covers
        those). A cross-site page cannot forge Origin, so matching it is safe."""
        origin = self.headers.get("Origin")
        if not origin:
            return True
        o = origin.lower().rstrip("/")
        if o.startswith("vscode-webview://"):
            return True
        host = (self.headers.get("Host") or "").lower()
        if host and o in ("http://" + host, "https://" + host):
            return True                              # same-origin (covers local AND tailnet self-access)
        return o in ("http://127.0.0.1:%d" % PORT, "http://localhost:%d" % PORT)

    def _cookie_token(self):
        for part in (self.headers.get("Cookie") or "").split(";"):
            k, _, v = part.strip().partition("=")
            if k == "romp_token":
                return v
        return ""

    def _authorize(self, q):
        """(ok, cookie_to_set, reason). Origin gate always; token gate only for non-local Host —
        a valid ?token sets the cookie so the client (and its same-origin /ws) never re-prompts."""
        if not self._origin_ok():
            return False, None, "cross-site origin"
        if self._is_local_host():
            return True, None, ""                    # local passes on the Origin check alone
        if (q.get("token") or [""])[0] == TOKEN and TOKEN:
            return True, TOKEN, ""                    # first non-local hit with ?token → set the cookie
        if self._cookie_token() == TOKEN and TOKEN:
            return True, None, ""
        return False, None, "token required for non-local access"

    def do_GET(self):
        u = urlparse(self.path)
        p = u.path
        q = parse_qs(u.query)
        self._set_cookie = None
        try:
            if p == "/healthz":
                return self._send(200, "ok", "text/plain")   # liveness probe — exempt from auth
            ok, self._set_cookie, why = self._authorize(q)
            if not ok:
                return self._send(403, "forbidden: " + why, "text/plain")
            if p == "/ws":
                return self._ws()
            if p in ("/", ""):
                # combined chat + feed (both ported); the timeline pane joins this layout next.
                _client_seen[0] = time.time()
                return self._send(200, _landing(), "text/html; charset=utf-8")
            if p == "/chat":
                _client_seen[0] = time.time()
                return self._send(200, _chat_page(), "text/html; charset=utf-8")
            if p == "/feed":
                _client_seen[0] = time.time()
                return self._send(200, _feed_page(), "text/html; charset=utf-8")
            if p == "/timeline":
                _client_seen[0] = time.time()
                return self._send(200, _timeline_page(), "text/html; charset=utf-8")
            if p.startswith("/dist/") or p.startswith("/media/"):
                base = DIST if p.startswith("/dist/") else MEDIA
                fp = (base / p.split("/", 2)[2]).resolve()
                if base.resolve() not in fp.parents or not fp.is_file():
                    return self._send(404, "not found", "text/plain")
                ct = {"js": "text/javascript", "css": "text/css", "svg": "image/svg+xml",
                      "map": "application/json"}.get(fp.suffix.lstrip("."), "text/plain")
                return self._send(200, fp.read_bytes(), ct + "; charset=utf-8")
            return self._send(404, "not found", "text/plain")
        except (BrokenPipeError, ConnectionResetError):
            pass
        except Exception:
            try:
                self._send(500, traceback.format_exc(), "text/plain")
            except Exception:
                pass

    def _ws(self):
        key = self.headers.get("Sec-WebSocket-Key")
        if not key:
            return self._send(400, "expected websocket", "text/plain")
        q = parse_qs(urlparse(self.path).query)
        app = (q.get("app") or ["chat"])[0]
        self.send_response(101)
        self.send_header("Upgrade", "websocket")
        self.send_header("Connection", "Upgrade")
        self.send_header("Sec-WebSocket-Accept", _ws_accept(key))
        self.end_headers()
        self.close_connection = True              # hijacked socket — don't let the handler keep-alive after
        _client_seen[0] = time.time()
        lock = threading.Lock()
        client = {"app": app, "send": lambda s: _ws_send(self.wfile, lock, s), "alive": True}
        with _clients_lock:
            _clients.append(client)
        try:
            while client["alive"]:
                op, payload = _ws_recv(self.rfile)
                if op is None or op == 0x8:           # EOF / close
                    break
                if op == 0x9:                          # ping → we ignore (browsers rarely ping)
                    continue
                # webview→kernel messages: on "ready", push the initial state to this client
                try:
                    msg = json.loads(payload.decode("utf-8", "replace"))
                except Exception:
                    msg = None
                if msg and msg.get("type") == "ready":
                    self._push_one(client)
        except (BrokenPipeError, ConnectionResetError, OSError):
            pass
        finally:
            client["alive"] = False
            with _clients_lock:
                if client in _clients:
                    _clients.remove(client)

    def _push_one(self, client):
        now = int(time.time())
        if client["app"] == "chat":
            for s in _sessions(now):
                m = build_session(s["sid"], now)
                if m:
                    client["send"](json.dumps(m))
            client["send"](json.dumps({"type": "working", "names": build_feed(now)["working"]}))
        elif client["app"] == "timeline":
            client["send"](json.dumps({"type": "data", "data": build_timeline(now)}))
        else:
            client["send"](json.dumps(build_feed(now)))


def _ensure_bundles():
    """Build the chat-view webview bundles (the human's tuned UI) if missing/stale — keeps the
    kernel a single command and auto-rebuilds after TS edits (mirrors bin/romp-serve)."""
    cv = ROOT / "chat-view"
    render = DIST / "render.js"
    if not (cv / "node_modules").exists():
        sys.stderr.write("romp-kernel: UI deps missing — run once: (cd %s && npm install)\n" % cv)
        return
    stale = not render.exists() or any(
        ts.stat().st_mtime > render.stat().st_mtime for ts in (cv / "src").rglob("*.ts"))
    if stale:
        sys.stderr.write("romp-kernel: building UI bundles…\n")
        try:
            subprocess.run(["node", "esbuild.js"], cwd=str(cv), check=True,
                           capture_output=True, timeout=120)
        except Exception as e:
            sys.stderr.write("romp-kernel: bundle build failed (%s) — UI may be stale\n" % e)


def main():
    _ensure_bundles()
    threading.Thread(target=_producer, daemon=True).start()
    threading.Thread(target=_pusher, daemon=True).start()
    srv = ThreadingHTTPServer((BIND, PORT), Handler)
    url = "http://127.0.0.1:%d" % PORT
    sys.stderr.write("romp-kernel: serving the ported UI at %s  (Ctrl-C to stop)\n" % url)
    sys.stderr.write("romp-kernel: records under %s ; bundles from %s\n" % (jd.STATE, DIST))
    if BIND != "127.0.0.1":
        # reachable off-box (tailnet/phone): the Origin gate blocks cross-site browsers token-free,
        # and a token is REQUIRED for any non-local Host. Local 127.0.0.1 access still needs nothing.
        sys.stderr.write("romp-kernel: bound %s — REMOTE access needs the token. Open from the phone:\n"
                         "  http://<this-host>:%d/?token=%s\n" % (BIND, PORT, TOKEN))
    if not os.environ.get("ROMP_KERNEL_NO_OPEN"):
        try:
            import webbrowser
            webbrowser.open(url)
        except Exception:
            pass
    try:
        srv.serve_forever()
    except KeyboardInterrupt:
        sys.stderr.write("\nromp-kernel: stopped\n")


if __name__ == "__main__":
    main()
