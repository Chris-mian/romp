# The timeline page bootstrap (adapted from chat-view/src/kernel/timeline.ts): shim the 3 Obsidian
# DOM helpers TimelinePanel uses, connect the kernel WS (app=timeline), drive panel.update() from the
# {type:"data"} payload, and provide the host bridges as WS messages (the view can't shell out from a
# browser). deepLink/writeOrder/compact/sendCommand are accepted-and-ignored by the kernel for now
# (cross-pane nav + reorder + tmux pickers are later increments) — the page degrades cleanly.
_TIMELINE_BOOT = """
(function(){var P=HTMLElement.prototype;
if(!P.createEl)P.createEl=function(tag,o){var e=document.createElement(tag);if(o&&o.cls)e.className=o.cls;if(o&&o.text)e.textContent=o.text;this.appendChild(e);return e;};
if(!P.createDiv)P.createDiv=function(o){return this.createEl('div',o);};
if(!P.createSpan)P.createSpan=function(o){return this.createEl('span',o);};})();
(function(){var wid=new URLSearchParams(location.search).get("wid")||"";var queue=[],ws=null,panel=null;
function send(m){var s=JSON.stringify(m);if(ws&&ws.readyState===1)ws.send(s);else queue.push(s);}
function connect(){var proto=location.protocol==="https:"?"wss://":"ws://";
ws=new WebSocket(proto+location.host+"/ws?app=timeline"+(wid?"&wid="+encodeURIComponent(wid):""));
ws.onopen=function(){for(var i=0;i<queue.length;i++)ws.send(queue[i]);queue=[];};
ws.onmessage=function(ev){var m;try{m=JSON.parse(ev.data);}catch(e){return;}
if(m.type==="data")panel.update(m.data);
else if(m.type==="activeChat"&&panel.setActiveChat)panel.setActiveChat(m.activeChat);
else if(m.type==="hover"&&panel.setHover)panel.setHover(m);};
ws.onclose=function(){setTimeout(function(){location.reload();},1500);};}
window.__rompTimelineOpenExternal=function(url){try{var u=new URL(url);if(u.protocol==="vscode:"){var q=u.searchParams;
send({type:"deepLink",session:q.get("session"),anchor:q.get("anchor")||undefined,anchorT:Number(q.get("anchorT"))||undefined,anchorKind:q.get("anchorKind")||undefined,compose:q.get("compose")==="1"});
if(window.parent!==window)window.parent.postMessage({romp:"reveal",pane:"chat"},"*");return;}}catch(e){}window.open(url,"_blank");};
window.__rompTimelineWriteOrder=function(order){send({type:"writeOrder",order:order});};
window.__rompTimelineCompact=function(name){send({type:"compact",name:name});};
window.__rompTimelineSendCommand=function(name,cmd){send({type:"sendCommand",name:name,cmd:cmd});};
window.__rompConnectTimeline=function(p){panel=p;connect();send({type:"ready"});};})();
"""


def _timeline_page():
    """The timeline pane: the shared obsidian TimelinePanel (romp-timeline-view.js) injected verbatim
    and driven by build_timeline over the kernel WS (app=timeline) — the same view the VS Code/Obsidian
    surfaces use. The view JS is read live from OBSIDIAN/ so an edit goes live on a browser reload."""
    try:
        view_js = (OBSIDIAN / "romp-timeline-view.js").read_text()
    except OSError:
        return ("<!DOCTYPE html><html><body style='font-family:-apple-system,sans-serif;color:#999;"
                "background:#1e1e1e;padding:12px'>romp timeline needs the obsidian/ modules "
                "(romp-timeline-view.js).</body></html>")
    return ("<!DOCTYPE html><html lang=en><head><meta charset=UTF-8>"
            "<meta name=viewport content='width=device-width,initial-scale=1'>"
            "<link rel=icon type=image/svg+xml href=/media/romp-swirl-glyph.svg>"
            "<title>Romp · timeline</title><style>%s\n%s</style></head><body><div id=host></div>"
            "<script>%s</script>"
            "<script>var module={exports:{}};(function(module,exports){\n%s\n})(module,module.exports);"
            "var TimelinePanel=module.exports.TimelinePanel;"
            "window.__rompConnectTimeline(new TimelinePanel(document.getElementById('host')));"
            "</script></body></html>" % (THEME_CSS, TIMELINE_CSS, _TIMELINE_BOOT, view_js))


def _chat_body():
    # ported from chat-view page-skeleton.chatBody
    return ('<div id="winframe"></div><div id="tabbar"><span id="tabs"></span></div>'
            '<div id="ledger" style="display:none"></div><div id="content"></div>'
            '<div id="live-ask" style="display:none"></div>'
            '<div id="footer"><div id="statusline" class="statusline"></div>'
            '<div id="composer"><textarea id="composer-input" rows="1" '
            'placeholder="Message this session…"></textarea>'
            '<button id="composer-attach" title="Attach a file — inserts its path">📎</button></div></div>')


# The combined-shell splitter JS: draggable v-split (chat|feed) + h-split (top row | timeline),
# persisted in localStorage. Iframes get pointer-events:none mid-drag so the gutter keeps the mouse
# (an iframe otherwise swallows mousemove the instant the cursor crosses it).
_LANDING_JS = """
(function(){var col=document.querySelector('.col'),row=document.querySelector('.row'),
tf=document.getElementById('t');var KC='romp-split-chat';
try{var c=localStorage.getItem(KC);if(c)row.style.setProperty('--chat',c);}catch(e){}
// timeline AUTO-FITS its content (only as tall as its lanes need): set --tl from the iframe's
// content height, re-fit on a lane add/remove (ResizeObserver) and on window resize. Capped at 70vh.
function tlContentH(){try{return tf.contentDocument.body.scrollHeight;}catch(e){return 0;}}
function cap(){return Math.round(window.innerHeight*0.7);}
function autosize(){var h=tlContentH();if(!h)return;col.style.setProperty('--tl',Math.min(h+2,cap())+'px');}
function drag(h,cls,apply){if(!h)return;h.addEventListener('mousedown',function(e){e.preventDefault();
document.body.classList.add('drag',cls);
function mv(ev){apply(ev);}function up(){document.body.classList.remove('drag',cls);
window.removeEventListener('mousemove',mv);window.removeEventListener('mouseup',up);}
window.addEventListener('mousemove',mv);window.addEventListener('mouseup',up);});}
drag(document.getElementById('gv'),'dragv',function(ev){var r=row.getBoundingClientRect();
var pct=Math.max(15,Math.min(85,(ev.clientX-r.left)/r.width*100));var v=pct.toFixed(1)+'%';
row.style.setProperty('--chat',v);try{localStorage.setItem(KC,v);}catch(e){}});
drag(document.getElementById('gh'),'dragh',function(ev){var r=col.getBoundingClientRect();
var px=r.bottom-ev.clientY;var ch=tlContentH();var mx=ch?ch+2:cap();   // can SHRINK, never exceed content
col.style.setProperty('--tl',Math.max(48,Math.min(mx,px))+'px');});
tf.addEventListener('load',function(){autosize();
try{new ResizeObserver(autosize).observe(tf.contentDocument.body);}catch(e){}});
window.addEventListener('resize',autosize);})();
"""


def _landing():
    # combined 3-pane shell: chat | feed on top (draggable col-resize gutter), the timeline band
    # full-width below (draggable row-resize gutter). Pane sizes persist in localStorage.
    return ("<!DOCTYPE html><html lang=en><head><meta charset=UTF-8>"
            "<link rel=icon type=image/svg+xml href=/media/romp-swirl-glyph.svg><title>Romp</title><style>"
            "html,body{margin:0;height:100%;background:#1e1e1e;overflow:hidden}"
            ".col{display:grid;grid-template-rows:1fr 5px var(--tl,160px);height:100vh}"
            ".row{display:grid;grid-template-columns:var(--chat,60%) 5px 1fr;min-height:0}"
            "iframe{border:0;width:100%;height:100%}"
            ".gv{cursor:col-resize;background:linear-gradient(90deg,transparent 2px,#333 2px,#333 3px,transparent 3px)}"
            ".gh{cursor:row-resize;background:linear-gradient(180deg,transparent 2px,#333 2px,#333 3px,transparent 3px)}"
            ".gv:hover{background:linear-gradient(90deg,transparent 2px,#007fd4 2px,#007fd4 3px,transparent 3px)}"
            ".gh:hover{background:linear-gradient(180deg,transparent 2px,#007fd4 2px,#007fd4 3px,transparent 3px)}"
            "body.drag iframe{pointer-events:none}body.dragv{cursor:col-resize}body.dragh{cursor:row-resize}"
            "</style></head><body><div class=col>"
            "<div class=row><iframe src=/chat></iframe><div class=gv id=gv></div>"
            "<iframe src=/feed></iframe></div>"
            "<div class=gh id=gh></div><iframe src=/timeline></iframe></div>"
            "<script>" + _LANDING_JS + "</script></body></html>")


class Handler(BaseHTTPRequestHandler):
    protocol_version = "HTTP/1.1"

    def log_message(self, *a):
        pass

    def _send(self, code, body, ctype):
        body = body.encode("utf-8") if isinstance(body, str) else body
        self.send_response(code)
        self.send_header("Content-Type", ctype)
        self.send_header("Content-Length", str(len(body)))
        if getattr(self, "_set_cookie", None):       # auto-inject the token so a client never 401-loops
            # Max-Age=1yr so the phone persists the token past its browser session (no re-prompt on
            # the tailnet after the tab is closed) — for simplify's auto-serve/permanence work.
            self.send_header("Set-Cookie", "romp_token=%s; Path=/; Max-Age=31536000; "
                             "SameSite=Strict; HttpOnly" % self._set_cookie)
        self.end_headers()
        self.wfile.write(body)

    # ── serve-layer security (design/read-side.md): Origin/Host gate always; token for non-local reach ──
    def _is_local_host(self):
        host = (self.headers.get("Host") or "").rsplit(":", 1)[0].strip("[]")
        return host in ("127.0.0.1", "localhost", "::1", "")

    def _origin_ok(self):
        """Reject cross-site browser origins — the ClawJacked/WS hole (WS isn't covered by CORS, so
        this is the real gate). Allow same-origin, the local kernel origin, vscode-webview, and an
        ABSENT Origin (non-browser clients like the obsidian fetch / curl; the Host/token gate covers
        those). A cross-site page cannot forge Origin, so matching it is safe."""
        origin = self.headers.get("Origin")
        if not origin:
            return True
        o = origin.lower().rstrip("/")
        if o.startswith("vscode-webview://"):
            return True
        host = (self.headers.get("Host") or "").lower()
        if host and o in ("http://" + host, "https://" + host):
            return True                              # same-origin (covers local AND tailnet self-access)
        return o in ("http://127.0.0.1:%d" % PORT, "http://localhost:%d" % PORT)

    def _cookie_token(self):
        for part in (self.headers.get("Cookie") or "").split(";"):
            k, _, v = part.strip().partition("=")
            if k == "romp_token":
                return v
        return ""

    def _authorize(self, q):
        """(ok, cookie_to_set, reason). Origin gate always; token gate only for non-local Host —
        a valid ?token sets the cookie so the client (and its same-origin /ws) never re-prompts."""
        if not self._origin_ok():
            return False, None, "cross-site origin"
        if self._is_local_host():
            return True, None, ""                    # local passes on the Origin check alone
        if (q.get("token") or [""])[0] == TOKEN and TOKEN:
            return True, TOKEN, ""                    # first non-local hit with ?token → set the cookie
        if self._cookie_token() == TOKEN and TOKEN:
            return True, None, ""
        return False, None, "token required for non-local access"

    def do_GET(self):
        u = urlparse(self.path)
        p = u.path
        q = parse_qs(u.query)
        self._set_cookie = None
        try:
            if p == "/healthz":
                return self._send(200, "ok", "text/plain")   # liveness probe — exempt from auth
            ok, self._set_cookie, why = self._authorize(q)
            if not ok:
                return self._send(403, "forbidden: " + why, "text/plain")
            if p == "/ws":
                return self._ws()
            if p in ("/", ""):
                # combined chat + feed (both ported); the timeline pane joins this layout next.
                _client_seen[0] = time.time()
                return self._send(200, _landing(), "text/html; charset=utf-8")
            if p == "/chat":
                _client_seen[0] = time.time()
                return self._send(200, _chat_page(), "text/html; charset=utf-8")
            if p == "/feed":
                _client_seen[0] = time.time()
                return self._send(200, _feed_page(), "text/html; charset=utf-8")
            if p == "/timeline":
                _client_seen[0] = time.time()
                return self._send(200, _timeline_page(), "text/html; charset=utf-8")
            if p.startswith("/dist/") or p.startswith("/media/"):
                base = DIST if p.startswith("/dist/") else MEDIA
                fp = (base / p.split("/", 2)[2]).resolve()
                if base.resolve() not in fp.parents or not fp.is_file():
                    return self._send(404, "not found", "text/plain")
                ct = {"js": "text/javascript", "css": "text/css", "svg": "image/svg+xml",
                      "map": "application/json"}.get(fp.suffix.lstrip("."), "text/plain")
                return self._send(200, fp.read_bytes(), ct + "; charset=utf-8")
            return self._send(404, "not found", "text/plain")
        except (BrokenPipeError, ConnectionResetError):
            pass
        except Exception:
            try:
                self._send(500, traceback.format_exc(), "text/plain")
            except Exception:
                pass

    def _ws(self):
        key = self.headers.get("Sec-WebSocket-Key")
        if not key:
            return self._send(400, "expected websocket", "text/plain")
        q = parse_qs(urlparse(self.path).query)
        app = (q.get("app") or ["chat"])[0]
        self.send_response(101)
        self.send_header("Upgrade", "websocket")
        self.send_header("Connection", "Upgrade")
        self.send_header("Sec-WebSocket-Accept", _ws_accept(key))
        self.end_headers()
        self.close_connection = True              # hijacked socket — don't let the handler keep-alive after
        _client_seen[0] = time.time()
        lock = threading.Lock()
        client = {"app": app, "send": lambda s: _ws_send(self.wfile, lock, s), "alive": True}
        with _clients_lock:
            _clients.append(client)
        try:
            while client["alive"]:
                op, payload = _ws_recv(self.rfile)
                if op is None or op == 0x8:           # EOF / close
                    break
                if op == 0x9:                          # ping → we ignore (browsers rarely ping)
                    continue
                # webview→kernel messages: on "ready", push the initial state to this client
                try:
                    msg = json.loads(payload.decode("utf-8", "replace"))
                except Exception:
                    msg = None
                if msg and msg.get("type") == "ready":
                    self._push_one(client)
                elif msg and msg.get("type") == "askClear" and msg.get("itemId"):
                    _clear_ask(msg["itemId"])
                    _push_all()                        # reflect the clear on every feed client now
                elif msg and msg.get("type") == "clearAll":
                    d = build_feed(int(time.time()))
                    _clear_all([a["itemId"] for a in d["asks"]] + [c["itemId"] for c in d["items"]])
                    _push_all()
                elif msg and msg.get("type") == "undoClear":
                    _undo_clear()
                    _push_all()
                elif msg and msg.get("type") in ("reorderTabs", "writeOrder") and isinstance(msg.get("order"), list):
                    _write_session_order(msg["order"])   # tab-drag or lane-drag → reorder BOTH surfaces
                    _push_all()
                elif msg and msg.get("type") == "closeSession" and msg.get("id"):
                    _set_hidden_tab(msg["id"], True)     # × hides the tab (session keeps running)
                    _push_all()
                elif msg and msg.get("type") == "openSession" and msg.get("id"):
                    _set_hidden_tab(msg["id"], False)    # feed/timeline click reopens a hidden tab
                    _push_all()
                    _send_to_app("chat", {"type": "focus", "id": msg["id"]})   # + switch the chat to it
                elif msg and msg.get("type") == "deepLink" and msg.get("session"):
                    _send_to_app("chat", {"type": "focus", "id": msg["session"], "anchor": msg.get("anchor"),
                                          "anchorT": msg.get("anchorT"), "anchorKind": msg.get("anchorKind")})
                elif msg and msg.get("type") == "showOnTimeline" and msg.get("sid"):
                    _send_to_app("chat", {"type": "focus", "id": msg["sid"],
                                          "anchorT": msg.get("t"), "anchor": msg.get("anchor")})
                elif msg and msg.get("type") == "hoverHighlight":
                    ids = msg["ids"] if isinstance(msg.get("ids"), list) else ([msg["id"]] if msg.get("id") else [])
                    _send_to_app("timeline", {"type": "hover", "ids": ids, "nonce": _next_nonce()})
                elif msg and msg.get("type") == "sendMessage" and msg.get("id") and msg.get("text"):
                    _tmux_send(_name_of(msg["id"]) or msg["id"], str(msg["text"]))   # composer → session
                elif msg and msg.get("type") == "interrupt" and msg.get("id"):
                    nm = _name_of(msg["id"]) or msg["id"]
                    try:
                        subprocess.run(["tmux", "send-keys", "-t", nm, "Escape"], timeout=3)
                    except Exception:
                        pass
                elif msg and msg.get("type") == "compact" and msg.get("name"):
                    _tmux_send(str(msg["name"]), "/compact")
                elif msg and msg.get("type") == "sendCommand" and msg.get("name") and msg.get("cmd"):
                    cmd = str(msg["cmd"])
                    _tmux_send(str(msg["name"]), cmd, model_cmd=cmd.strip().startswith("/model"))
                elif msg and msg.get("type") == "askFollowUp" and msg.get("itemId") and msg.get("text"):
                    sid = str(msg["itemId"]).rsplit(":", 1)[0]   # goal node id → session → inject the follow-up
                    _tmux_send(_name_of(sid) or sid, str(msg["text"]))
        except (BrokenPipeError, ConnectionResetError, OSError):
            pass
        finally:
            client["alive"] = False
            with _clients_lock:
                if client in _clients:
                    _clients.remove(client)

    def _push_one(self, client):
        now = int(time.time())
        tmux = _tmux_sessions()
        if client["app"] == "chat":
            hidden = _hidden_tabs()
            ordered = [s for s in _ordered_alive(now, tmux) if s["sid"] not in hidden]
            for s in ordered:
                m = build_session(s["sid"], now, tmux)
                if m:
                    client["send"](json.dumps(m))
            client["send"](json.dumps({"type": "tabOrder", "order": [s["sid"] for s in ordered]}))
            client["send"](json.dumps({"type": "working", "names": build_feed(now, tmux)["working"]}))
        elif client["app"] == "timeline":
            client["send"](json.dumps({"type": "data", "data": build_timeline(now, tmux)}))
        else:
            client["send"](json.dumps(build_feed(now, tmux)))


def _ensure_bundles():
    """Build the chat-view webview bundles (the human's tuned UI) if missing/stale — keeps the
    kernel a single command and auto-rebuilds after TS edits (mirrors bin/romp-serve)."""
    cv = ROOT / "chat-view"
    render = DIST / "render.js"
    if not (cv / "node_modules").exists():
        sys.stderr.write("romp-kernel: UI deps missing — run once: (cd %s && npm install)\n" % cv)
        return
    stale = not render.exists() or any(
        ts.stat().st_mtime > render.stat().st_mtime for ts in (cv / "src").rglob("*.ts"))
    if stale:
        sys.stderr.write("romp-kernel: building UI bundles…\n")
        try:
            subprocess.run(["node", "esbuild.js"], cwd=str(cv), check=True,
                           capture_output=True, timeout=120)
        except Exception as e:
            sys.stderr.write("romp-kernel: bundle build failed (%s) — UI may be stale\n" % e)


def _pid_alive(pid):
    try:
        os.kill(pid, 0)
        return True
    except ProcessLookupError:
        return False
    except PermissionError:
        return True


def _parent_watch():
    """Exit if the manager that spawned us (ROMP_MANAGER_PID) dies, so a supervisor crash doesn't
    orphan the kernel — the python analogue of chat-view/src/kernel/parent-watch, for simplify's
    romp-manager integration. No-op when launched standalone (no ROMP_MANAGER_PID)."""
    pid = os.environ.get("ROMP_MANAGER_PID")
    if not (pid and pid.isdigit()):
        return
    pid = int(pid)
    while _pid_alive(pid):
        time.sleep(2)
    os._exit(0)


def main():
    _ensure_bundles()
    threading.Thread(target=_producer, daemon=True).start()
    threading.Thread(target=_pusher, daemon=True).start()
    threading.Thread(target=_parent_watch, daemon=True).start()
    srv = ThreadingHTTPServer((BIND, PORT), Handler)
    url = "http://127.0.0.1:%d" % PORT
    sys.stderr.write("romp-kernel: serving the ported UI at %s  (Ctrl-C to stop)\n" % url)
    sys.stderr.write("romp-kernel: records under %s ; bundles from %s\n" % (jd.STATE, DIST))
    if BIND != "127.0.0.1":
        # reachable off-box (tailnet/phone): the Origin gate blocks cross-site browsers token-free,
        # and a token is REQUIRED for any non-local Host. Local 127.0.0.1 access still needs nothing.
        sys.stderr.write("romp-kernel: bound %s — REMOTE access needs the token. Open from the phone:\n"
                         "  http://<this-host>:%d/?token=%s\n" % (BIND, PORT, TOKEN))
    if not os.environ.get("ROMP_KERNEL_NO_OPEN"):
        try:
            import webbrowser
            webbrowser.open(url)
        except Exception:
            pass
    try:
        srv.serve_forever()
    except KeyboardInterrupt:
        sys.stderr.write("\nromp-kernel: stopped\n")


if __name__ == "__main__":
    main()
