#!/usr/bin/env python3
"""romp-kernel — the merged read-side kernel (design/read-side.md), MINIMAL browser version.

ONE always-on process: the Layer-1 parse + Layer-2 judges (the producer) AND an HTTP server
that serves ui/ and the three panes — chat, feed, timeline — built ONLY from the new records
(captions/ goals/ archive/), never the old stores. Single writer.

This minimal version is a self-contained Python kernel sitting BESIDE the existing chat-view
Node kernel (which stays, so the VS Code extension keeps working). Converging the view-builder
to TS in ui/ and folding the extension onto this kernel are tracked deferrals (design/backlog.md).
Live update is by polling (WS push deferred); the producer is presence-gated (no model calls
when no browser is open).

Run:  python3 ~/GitRepos/romp-event-model/bin/romp-kernel
      then open the printed http://127.0.0.1:PORT
"""
import json, os, sys, time, threading, traceback
from pathlib import Path
from importlib.machinery import SourceFileLoader
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from urllib.parse import urlparse, parse_qs

HERE = Path(__file__).resolve().parent
em = SourceFileLoader("romp_event_model", str(HERE / "romp-event-model")).load_module()
jd = SourceFileLoader("romp_judge", str(HERE / "romp-judge")).load_module()
UIDIR = HERE.parent / "ui"
PORT = int(os.environ.get("ROMP_KERNEL_PORT", "7878"))

_client_seen = [0.0]            # last browser activity (presence gate for the producer)
_pending = [0]                  # rough pending-judgment count (UI progress surface, minimal)


# ───────────────────────── view-builder (records → pane payloads) ─────────────────────────
# Minimal Python view-builder; the single TS view-builder in ui/ is the tracked target.
def _captions(fsid):
    out = {}
    try:
        for line in (jd.CAPDIR / (fsid + ".jsonl")).read_text(errors="replace").splitlines():
            try:
                o = json.loads(line)
            except Exception:
                continue
            if o.get("id"):
                out[o["id"]] = o
    except OSError:
        pass
    return out


def _sessions(now):
    """Discovered sessions with their archive headline + color, newest activity first."""
    out = []
    for fsid, path, anchor, name in jd.discover(now):
        arch = jd.load_archive(fsid) or {}
        try:
            mtime = os.stat(path).st_mtime
        except OSError:
            mtime = 0
        out.append({"sid": fsid, "name": name or fsid[:8], "path": str(path), "mtime": mtime,
                    "headline": arch.get("headline", ""), "abstract": arch.get("abstract", "")})
    out.sort(key=lambda s: s["mtime"], reverse=True)
    return out


def view_feed(now):
    """The inbox: top-level goal cards bucketed by rolled-up status, + the caption stream."""
    cols = {"working": [], "blocked": [], "completed": []}
    stream = []
    for s in _sessions(now):
        fsid = s["sid"]
        store = jd.load_goals(fsid)
        nodes, status = store.get("nodes", {}), store.get("status", {})
        children = {}
        for nid, nd in nodes.items():
            children.setdefault(nd.get("parentId"), []).append(nid)

        def subtree(nid):
            nd = nodes[nid]
            return {"id": nid, "text": nd["text"], "done": bool(nd.get("nodeComplete")),
                    "blocked": bool(nd.get("blocked")),
                    "kids": [subtree(c) for c in sorted(children.get(nid, []), key=lambda c: nodes[c]["t"])]}
        for nid in children.get(None, []):
            st = status.get(nid, "working")
            if st == "cleared":
                continue
            card = {"sid": fsid, "session": s["name"], "id": nid, "text": nodes[nid]["text"],
                    "status": st, "trail": subtree(nid)}
            cols.get(st, cols["working"]).append(card)
        caps = _captions(fsid)
        for c in caps.values():
            if c.get("grain") == "turn":
                stream.append({"sid": fsid, "session": s["name"], "t": c["t"], "caption": c["caption"]})
    stream.sort(key=lambda c: c["t"], reverse=True)
    return {"columns": cols, "stream": stream[:120]}


def _atom_row(a):
    msg = a.get("message") or {}
    blocks = msg.get("content", []) if isinstance(msg.get("content"), list) else []
    text = " ".join(b.get("text", "") for b in blocks if isinstance(b, dict) and b.get("type") == "text").strip()
    tools = [b.get("name") for b in blocks if isinstance(b, dict) and b.get("type") == "tool_use"]
    has_result = any(isinstance(b, dict) and b.get("type") == "tool_result" for b in blocks)
    thinking = any(isinstance(b, dict) and b.get("type") == "thinking" for b in blocks)
    kind = a["type"]
    if kind == "system":
        kind = "system:" + (a.get("subtype") or "")
    author = a.get("author")
    author = ("peer" if isinstance(author, dict) else author) or ""
    return {"uuid": a.get("uuid"), "type": kind, "author": author, "t": a.get("t"),
            "text": text, "tools": tools, "toolResult": has_result, "thinking": thinking,
            "end": a.get("end")}


def view_chat(sid):
    """The event tree rendered directly (atoms), plus the TOC ledger (archive headline +
    turn/segment captions, each anchored to the first atom to jump to)."""
    sess = next((s for s in _sessions(int(time.time())) if s["sid"] == sid), None)
    if not sess:
        return {"error": "unknown session"}
    session = em.parse_session(sess["path"], rompuuid=sid, candidate_files=[sess["path"]],
                               postal_log=str(jd.MESSAGES), now=int(time.time()))
    caps = _captions(sid)
    rows, toc = [], []
    for turn in session["turns"]:
        segs = em.segments(turn)
        first_uuid = next((a.get("uuid") for a in turn["atoms"] if a.get("uuid")), None)
        tcap = caps.get(turn["id"], {}).get("caption", "")
        toc_seg = []
        for seg in segs:
            scap = caps.get(seg["id"], {}).get("caption", "")
            sfirst = next((a.get("uuid") for a in seg["atoms"] if a.get("uuid")), None)
            if len(segs) > 1 and scap:
                toc_seg.append({"caption": scap, "anchor": sfirst})
        toc.append({"caption": tcap or "(turn)", "anchor": first_uuid, "segs": toc_seg})
        for a in turn["atoms"]:
            rows.append(_atom_row(a))
    return {"sid": sid, "name": sess["name"], "headline": sess["headline"],
            "abstract": sess["abstract"], "toc": toc, "atoms": rows}


def view_timeline(now):
    """Lanes (one per session); each segment a bar [t,end] with its caption; idle atoms as gaps."""
    lanes = []
    lo = hi = None
    for s in _sessions(now):
        sid = s["sid"]
        try:
            session = em.parse_session(s["path"], rompuuid=sid, candidate_files=[s["path"]],
                                       postal_log=str(jd.MESSAGES), now=now)
        except Exception:
            continue
        caps = _captions(sid)
        bars, idles = [], []
        for turn in session["turns"]:
            for seg in em.segments(turn):
                cap = caps.get(seg["id"], {}).get("caption", "")
                bars.append({"t": seg["t"], "end": seg["end"], "caption": cap, "trigger": seg["trigger"]})
                lo = seg["t"] if lo is None else min(lo, seg["t"])
                hi = seg["end"] if hi is None else max(hi, seg["end"])
            for a in turn["atoms"]:
                if a["type"] == "idle":
                    idles.append({"t": a["t"], "end": a.get("end", a["t"])})
        if bars:
            lanes.append({"sid": sid, "name": s["name"], "bars": bars, "idles": idles})
    return {"lanes": lanes, "lo": lo or now - 3600, "hi": hi or now}


# ───────────────────────── the producer (presence-gated) ─────────────────────────
def _producer():
    """Keep the records fresh while a browser is connected: index tier + (presence) the planner.
    Idle (no browser polled recently) → no model calls. A minimal stand-in for the doc's
    always-on index tier + presence-gated triage; event-based triggering is a tracked deferral."""
    while True:
        try:
            if time.time() - _client_seen[0] < 90:      # a browser is watching
                jd.run_once()                            # index tier (captions + archive)
                jd.run_plan()                            # triage tier (goals)
        except Exception:
            sys.stderr.write("producer: %s\n" % traceback.format_exc())
        time.sleep(20)


# ───────────────────────── HTTP ─────────────────────────
class Handler(BaseHTTPRequestHandler):
    def log_message(self, *a):
        pass                                             # quiet

    def _send(self, code, body, ctype):
        body = body.encode("utf-8") if isinstance(body, str) else body
        self.send_response(code)
        self.send_header("Content-Type", ctype)
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)

    def _json(self, obj):
        self._send(200, json.dumps(obj), "application/json")

    def do_GET(self):
        u = urlparse(self.path)
        p, q = u.path, parse_qs(u.query)
        try:
            if p.startswith("/api/"):
                _client_seen[0] = time.time()            # presence
                now = int(time.time())
                if p == "/api/feed":
                    return self._json(view_feed(now))
                if p == "/api/timeline":
                    return self._json(view_timeline(now))
                if p == "/api/sessions":
                    return self._json({"sessions": _sessions(now)})
                if p == "/api/chat":
                    return self._json(view_chat((q.get("sid") or [""])[0]))
                return self._json({"error": "unknown endpoint"})
            # static ui/
            rel = "index.html" if p in ("/", "") else p.lstrip("/")
            fp = (UIDIR / rel).resolve()
            if UIDIR.resolve() not in fp.parents and fp != (UIDIR / "index.html").resolve():
                return self._send(403, "forbidden", "text/plain")
            if not fp.is_file():
                return self._send(404, "not found", "text/plain")
            ctype = {"html": "text/html", "js": "text/javascript", "css": "text/css",
                     "svg": "image/svg+xml"}.get(fp.suffix.lstrip("."), "text/plain")
            return self._send(200, fp.read_bytes(), ctype + "; charset=utf-8")
        except Exception:
            return self._send(500, traceback.format_exc(), "text/plain")


def main():
    threading.Thread(target=_producer, daemon=True).start()
    srv = ThreadingHTTPServer(("127.0.0.1", PORT), Handler)
    url = "http://127.0.0.1:%d" % PORT
    sys.stderr.write("romp-kernel: serving the new read side at %s  (Ctrl-C to stop)\n" % url)
    sys.stderr.write("romp-kernel: reading new records under %s\n" % jd.STATE)
    if not os.environ.get("ROMP_KERNEL_NO_OPEN"):
        try:
            import webbrowser
            webbrowser.open(url)
        except Exception:
            pass
    try:
        srv.serve_forever()
    except KeyboardInterrupt:
        sys.stderr.write("\nromp-kernel: stopped\n")


if __name__ == "__main__":
    main()
