#!/usr/bin/env python3
"""romp-pipeline — a live status table of the summarization+registry DAG.

For every turn-event across the fleet it shows where that event is in the pipeline
  romp-events (parse) → summarize-backfill (tag+phrase+LINK, writes the request
  registry; see REQUESTS.md) → romp-feed-detail (paragraph)
and how long each stage took — so you can watch the pipeline keep up (or fall
behind) in real time and debug it.

Design: a healthy row is QUIET — age, session, duration, deliverable. Pipeline
status appears only on deviation, worded ("⧗ summary" / "⧗ detail", yellow→red
by wait). Registry flow trails the text dim, only when it happened: "+1 ask"
(this typed turn captured an ask) · "→1 req" (this reply served a request).
Header carries the aggregates (linked / asks open / summarizing / detailing).

  romp-pipeline                live, scrollable, refreshing every 2s
  romp-pipeline --once         print once and exit (also when piped)
  romp-pipeline -n 200         cap rows
  romp-pipeline --pending      only events still missing a stage (the backlog)
  romp-pipeline --no-color
"""
import os, sys, json, time, math, argparse, subprocess, termios, tty, signal, textwrap
from select import select as _poll
try: signal.signal(signal.SIGPIPE, signal.SIG_DFL)   # clean exit when piped to head/less
except Exception: pass

PENDING_WINDOW = 1800   # only count a turn as "summarizing-pending" if it ended <30m ago

HERE = os.path.dirname(os.path.realpath(__file__))
sys.path.insert(0, HERE)
from romp_colormap import age_rgb

STATE = os.path.expanduser("~/.local/state/romp")
SUMM = os.path.join(STATE, "summaries")
DETAIL = os.path.join(STATE, "feed-detail")
REQS = os.path.join(STATE, "requests")       # the request registry (REQUESTS.md)
EVENTS_BIN = os.path.join(HERE, "romp-events")

# ── color ──────────────────────────────────────────────────────────────────
class C:
    on = True
    @staticmethod
    def rgb(t): return f"\033[38;2;{t[0]};{t[1]};{t[2]}m" if (C.on and t) else ""
    @staticmethod
    def c(s): return s if C.on else ""
    RESET="\033[0m"; BOLD="\033[1m"; DIM="\033[2m"
    GRN="\033[38;5;71m"; YEL="\033[38;5;179m"; RED="\033[38;5;203m"
    GRAY="\033[38;5;245m"; CYAN="\033[38;5;37m"; BLUE="\033[38;5;75m"; MAG="\033[38;5;176m"

def _hex(h):
    h = (h or "").lstrip("#")
    if len(h) != 6: return None
    try: return tuple(int(h[i:i+2], 16) for i in (0, 2, 4))
    except ValueError: return None

def agehms(s):
    s = max(0, int(round(s)))
    if s < 60: return f"{s}s"
    if s < 3600: return f"{s//60}m"
    if s < 86400: return f"{s//3600}h"
    return f"{s//86400}d"

def lag_color(sec):
    if sec is None: return C.DIM
    if sec < 30: return C.GRN
    if sec < 120: return C.YEL
    return C.RED

# ── data ───────────────────────────────────────────────────────────────────
def read_summaries(sid):
    """id -> (reply_write_t, RELEVANCE, text); last reply line for an id wins."""
    out = {}
    try:
        with open(os.path.join(SUMM, sid + ".jsonl")) as f:
            for ln in f:
                ln = ln.strip()
                if not ln: continue
                try: e = json.loads(ln)
                except ValueError: continue
                if e.get("kind") == "reply" and e.get("id"):
                    out[e["id"]] = (e.get("t", 0), str(e.get("relevance", "")).upper(), e.get("text", ""))
    except OSError: pass
    return out

def detail_mtime(eid):
    try: return os.stat(os.path.join(DETAIL, eid + ".json")).st_mtime
    except OSError: return None

def _req_rows(name):
    out = []
    try:
        with open(os.path.join(REQS, name)) as f:
            for ln in f:
                ln = ln.strip()
                if ln:
                    try: out.append(json.loads(ln))
                    except ValueError: pass
    except OSError: pass
    return out

def read_registry():
    """Registry-stage status: (reply_id -> n linked requests, n open asks,
    turn_id -> n asks captured/amended from that typed turn)."""
    links = {}
    for e in _req_rows("links.jsonl"):
        if e.get("kind") == "link" and e.get("reply_id"):
            links[e["reply_id"]] = len(e.get("request_ids") or [])
    asks, by_turn = set(), {}
    for n in _req_rows("nodes.jsonl"):
        if n.get("kind") == "ask" and n.get("id"):
            asks.add(n["id"])
            tid = n.get("turn_id")
            if tid: by_turn[tid] = by_turn.get(tid, 0) + 1
        elif n.get("kind") == "amend":
            tid = n.get("turn_id")
            if tid: by_turn[tid] = by_turn.get(tid, 0) + 1
    cleared = {c.get("id") for c in _req_rows("cleared.jsonl")}
    return links, len(asks - cleared), by_turn

def _turnstart(eid):
    try: return int(eid.split(":")[1])
    except Exception: return 0

def build_rows():
    try:
        raw = subprocess.run([EVENTS_BIN, "--emit"], capture_output=True, text=True, timeout=25).stdout
        emit = json.loads(raw)
    except Exception:
        return [], time.time(), 0
    now = emit.get("now") or time.time()
    links, open_asks, asks_by_turn = read_registry()
    rows = []
    for sid, s in emit.get("sessions", {}).items():
        name = s.get("name") or sid[:8]
        color = _hex(s.get("color"))
        ev_by_id = {e.get("id"): e for e in s.get("events", [])}
        summ = read_summaries(sid)
        seen = set()
        # (1) Summarized deliverables — the SAME ground truth the feed shows. Driving
        #     off summaries (not the live event list) means a turn romp-events later
        #     FOLDED still appears, since its summary persists.
        for eid, (sum_t, tag, text) in summ.items():
            seen.add(eid)
            e = ev_by_id.get(eid)
            start = (e.get("t") if e else 0) or _turnstart(eid)
            end = (e.get("end") or start) if e else (sum_t or start)
            dt = detail_mtime(eid)
            rows.append({
                "eid": eid,
                "name": name, "color": color, "end": end,
                "dur": (end - start) if (e and end and start) else None,
                "summarized": True, "tag": tag,
                "asks": asks_by_turn.get(eid, 0),
                "linked": links.get(eid, 0),
                "detailed": dt is not None, "det_lag": (dt - sum_t) if (dt and sum_t) else None,
                "detail_expected": tag in ("DONE", "DECISION"),
                "folded": e is None,                 # summarized but romp-events dropped the event
                "text": text or "",
            })
        # (2) The not-yet-summarized FRONT — RECENT prompt turns awaiting a summary
        #     (a window, so the count reflects live backlog, not ancient un-summarized cruft).
        for e in s.get("events", []):
            if e.get("id") in seen or e.get("open"): continue
            if e.get("kind") not in ("typed", "queued"): continue
            start = e.get("t", 0); end = e.get("end") or start
            if (now - end) > PENDING_WINDOW: continue
            rows.append({
                "eid": e.get("id"),
                "name": name, "color": color, "end": end, "dur": max(0, end - start),
                "summarized": False, "tag": "", "asks": asks_by_turn.get(e.get("id"), 0),
                "linked": 0, "detailed": False, "det_lag": None,
                "detail_expected": False, "folded": False,
                "text": (e.get("reply") or e.get("summary") or e.get("text") or "").strip(),
            })
    rows.sort(key=lambda r: r["end"], reverse=True)
    return rows, now, open_asks

# ── render ─────────────────────────────────────────────────────────────────
# Design: a HEALTHY row is quiet — age, session, duration, deliverable, nothing
# else. Pipeline status appears only when something DEVIATES, as a small worded
# note ("⧗ summary", "⧗ detail") colored by how long it's been waiting. Registry
# flow facts (+1 ask, →1 req) trail the text, dim, only when they happened.
# No symbols that need a legend; no per-row status when status is "fine".

def _cell(plain, color, w):
    pad = " " * max(0, w - len(plain))
    return C.c(color) + plain + C.c(C.RESET) + pad

def fmt_row(r, now):
    age = agehms(now - r["end"])
    agec = f"{C.rgb(age_rgb(now - r['end']))}{age:>4}{C.c(C.RESET)}"
    sess = _cell((r["name"] or "")[:14], C.rgb(r["color"]) if r["color"] else C.GRAY, 14)
    dur = _cell(agehms(r["dur"]) if r["dur"] is not None else "", C.DIM, 4)
    # stall note — empty when the pipeline is keeping up; colored by wait time
    if not r["summarized"]:
        wait = now - r["end"]
        stall = _cell("⧗ summary", C.YEL if wait < 120 else C.RED, 10)
    elif r["detail_expected"] and not r["detailed"]:
        stall = _cell("⧗ detail", C.YEL, 10)
    else:
        stall = " " * 10
    # flow facts, trailing and dim: what this turn put into / took from the registry
    notes = []
    if r["asks"]:
        notes.append(f"+{r['asks']} ask" + ("s" if r["asks"] > 1 else ""))
    if r["linked"]:
        notes.append(f"→{r['linked']} req")
    tail = f"  {C.c(C.DIM)}{' · '.join(notes)}{C.c(C.RESET)}" if notes else ""
    text = r["text"] if r["summarized"] else f"{C.c(C.DIM)}{r['text']}{C.c(C.RESET)}"
    return f"  {agec}  {sess} {dur} {stall} {text}{tail}"

HEADER_COLS = ("  " + "AGE".rjust(4) + "  " + "SESSION".ljust(14) + " " + "DUR".ljust(4)
               + " " + " ".ljust(10) + " DELIVERABLE")

EXPLAIN = (
    "Each row is one finished agent turn, newest first: when it ended, which session, how "
    "long it ran (DUR), and the one-line summary the pipeline wrote about it. A blank status "
    "column means that turn is fully processed. ⧗ summary = its one-liner hasn't been "
    "written yet. ⧗ detail = its expandable paragraph (shown when you expand the card in "
    "the feed) is still generating — only done/decision turns get paragraphs, routine turns "
    "never do, so most rows correctly show nothing. The dim notes at the end are request-"
    "registry traffic: '+N ask' = that typed message of yours was recorded as N new asks; "
    "'→N req' = that reply was matched to N requests it served."
)

def explain_lines():
    try: w = os.get_terminal_size().columns
    except OSError: w = 100
    return [f"  {C.c(C.DIM)}{ln}{C.c(C.RESET)}"
            for ln in textwrap.wrap(EXPLAIN, width=max(40, min(w - 4, 110)))]

def build_lines(args, rows, now, open_asks=0):
    if args.pending:
        rows = [r for r in rows if (not r["summarized"]) or (r["detail_expected"] and not r["detailed"])]
    if args.n:
        rows = rows[:args.n]
    pend_s = sum(1 for r in rows if not r["summarized"])
    pend_d = sum(1 for r in rows if r["detail_expected"] and not r["detailed"])
    n_link = sum(1 for r in rows if r["linked"])
    hdr = (f"{C.c(C.BOLD)}romp pipeline{C.c(C.RESET)}  {len(rows)} events"
           + (f" · {C.c(C.CYAN)}{n_link} linked{C.c(C.RESET)}" if n_link else "")
           + (f" · {open_asks} ask{'s' if open_asks != 1 else ''} open" if open_asks else "")
           + (f" · {C.c(C.YEL)}{pend_s} summarizing{C.c(C.RESET)}" if pend_s else "")
           + (f" · {C.c(C.YEL)}{pend_d} detailing{C.c(C.RESET)}" if pend_d else "")
           + f"  {C.c(C.DIM)}{time.strftime('%H:%M:%S')}{C.c(C.RESET)}")
    colhdr = f"{C.c(C.DIM)}{HEADER_COLS}{C.c(C.RESET)}"
    # body strings parallel `rows` 1:1 — the TUI maps the cursor index back to a row's eid.
    return hdr, explain_lines() + ["", colhdr], [fmt_row(r, now) for r in rows], rows

# ── trace pane ───────────────────────────────────────────────────────────────
# One event's whole journey through the pipeline, as a vertical flow: TURN →
# SUMMARY(request side) → SUMMARY(reply side) → LINK decision → REQ/PARENTS →
# DETAIL → DISPOSITION. One block per system, each carrying the clock time the
# fact was recorded, a latency FROM THE PRIOR STAGE *only where the latency is
# real*, and the decision that system made.
#
# TIMESTAMP HONESTY (see romp-summarize-backfill's append_summary docstring):
# almost every `t` the registry/summaries write is an EVENT time, not a write
# time — a reply summary keys at the turn's PERIOD END, a request/ask at the
# turn's PROCESS START, a message node at the message's own time. So a "+47s"
# off those would be fiction. We therefore show a real latency ONLY between two
# write-time anchors: the detail file's mtime (a genuine fs write) measured
# against the turn end. Everywhere else we print the clock the event carries and
# say plainly that it's the event's own time, never a stage latency.

REQUESTS_FLOOR = 1781036800   # ship-time floor (mirror of the daemon's): no registry before this

def _hhmmss(t):
    return time.strftime("%H:%M:%S", time.localtime(t)) if t else "--:--:--"

def _full_eid(suffix):
    """Resolve a user-supplied fragment to a full event id by scanning every summary file's
    ids (the authoritative id set). Matches a unique suffix OR prefix OR the middle epoch chunk
    (so '1781048591' finds '<fsid>:1781048591:<sha>'). Returns (eid, error_or_None)."""
    hits = set()
    try:
        names = os.listdir(SUMM)
    except OSError:
        names = []
    for fn in names:
        if not fn.endswith(".jsonl"):
            continue
        for e in _jsonl(os.path.join(SUMM, fn)):
            i = e.get("id")
            if not i:
                continue
            if i == suffix or i.startswith(suffix) or i.endswith(suffix) or (":" + suffix + ":") in (":" + i + ":"):
                hits.add(i)
    if not hits:
        return None, f"no event id matches {suffix!r}"
    if len(hits) > 1:
        return None, "ambiguous (%d match %r): %s" % (len(hits), suffix, ", ".join(sorted(hits)[:4]))
    return hits.pop(), None

def _jsonl(path):
    out = []
    try:
        with open(path) as f:
            for ln in f:
                ln = ln.strip()
                if ln:
                    try: out.append(json.loads(ln))
                    except ValueError: pass
    except OSError:
        pass
    return out

def _name_info(fsid):
    """names/<sid> → (name, dir, bg_rgb, fg_rgb). The fsid embedded in an event id keys it
    (a fork shares its anchor's name file when one exists; fall back to the bare fsid)."""
    try:
        parts = open(os.path.join(STATE, "names", fsid)).read().rstrip("\n").split("\t")
    except OSError:
        return fsid[:8], "", None, None
    name = parts[0] if parts else fsid[:8]
    cdir = parts[1] if len(parts) > 1 else ""
    bg = _hex(parts[2]) if len(parts) > 2 else None
    fg = _hex(parts[3]) if len(parts) > 3 else None
    return name, cdir, bg, fg

def _registry_all():
    """Every registry file folded the read-time way (last-wins per kind), for trace use:
    nodes by id (amend → latest text, parents → merged edges), links by reply_id, the raw
    decision-log, the cleared set."""
    nodes = {}
    for o in _req_rows("nodes.jsonl"):
        k, i = o.get("kind"), o.get("id")
        if not i:
            continue
        if k in ("ask", "internal"):
            nodes.setdefault(i, dict(o))
        elif k == "amend" and i in nodes and o.get("text"):
            nodes[i]["text"] = o["text"]
        elif k == "parents" and i in nodes:
            cur = set(nodes[i].get("parent_ids") or [])
            nodes[i]["parent_ids"] = sorted(cur | set(o.get("parent_ids") or []))
    links = {}
    for o in _req_rows("links.jsonl"):
        if o.get("kind") == "link" and o.get("reply_id"):
            links[o["reply_id"]] = o          # last write wins
    cleared = {c.get("id") for c in _req_rows("cleared.jsonl")}
    declog = _req_rows("decision-log.jsonl")
    return nodes, links, cleared, declog

def _root_asks(req_ids, nodes, _seen=None):
    """Walk request ids up `parents` edges to ask roots (REQUESTS.md read-time root-walk): an
    internal node resolves to the ask(s) its parent_ids reach; an ask resolves to itself."""
    if _seen is None:
        _seen = set()
    roots = []
    for rid in req_ids or []:
        if rid in _seen:
            continue
        _seen.add(rid)
        n = nodes.get(rid)
        if n is None:
            continue                                    # unknown id → no reachable root
        if n.get("kind") == "ask":
            roots.append(n)
        else:                                           # internal handoff → follow its parents
            roots.extend(_root_asks(n.get("parent_ids"), nodes, _seen))
    return roots

def build_trace(eid):
    """All stage facts for one event id, drawn straight from the source files (not build_rows,
    which truncates). Returns a dict the renderer turns into the vertical flow."""
    fsid = eid.split(":")[0]
    name, cdir, bg, fg = _name_info(fsid)
    chip = bg or fg                                     # identity color for the session chip
    # TURN — start/end/dur + the prompting text. Prefer the live event (exact text + end);
    # fall back to the summary's request line when romp-events has folded the event.
    start = _turnstart(eid)
    end = None; ptext = ""; kind = ""
    try:
        emit = json.loads(subprocess.run([EVENTS_BIN, "--emit"], capture_output=True, text=True, timeout=25).stdout)
    except Exception:
        emit = {"sessions": {}}
    for sid, s in emit.get("sessions", {}).items():
        for e in s.get("events", []):
            if e.get("id") == eid:
                start = e.get("t") or start; end = e.get("end"); kind = e.get("kind") or ""
                ptext = (e.get("text") or "").strip()
                if not (bg or fg):                      # session has no names file → take emit color
                    chip = _hex(s.get("color")); name = s.get("name") or name
    # SUMMARY sides — request line (user-typed signal) + reply line (phrase/tag/event-time).
    req_t = rep_t = None; phrase = ""; tag = ""; req_phrase = ""; typed = False
    for e in _jsonl(os.path.join(SUMM, fsid + ".jsonl")):
        if e.get("id") != eid:
            continue
        if e.get("kind") == "request":
            typed = True; req_t = e.get("t"); req_phrase = e.get("text", "")
        elif e.get("kind") == "reply":
            rep_t = e.get("t"); phrase = e.get("text", ""); tag = str(e.get("relevance", "")).upper()
    if not ptext:                                       # folded turn: use the request phrase as text
        ptext = req_phrase
    nodes, links, cleared, declog = _registry_all()
    # ASKS this typed turn produced (ask | amend nodes whose turn_id == this event).
    asks = [n for n in nodes.values() if n.get("kind") == "ask" and n.get("turn_id") == eid]
    amends = [o for o in _req_rows("nodes.jsonl") if o.get("kind") == "amend" and o.get("turn_id") == eid]
    # The zero-/under-capture decision-log line for this typed turn, if any.
    cap = next((o for o in declog if o.get("kind") == "ask-capture" and o.get("turn_id") == eid), None)
    # LINK — the reply→request decision for this event id (full candidate set + chosen + raw).
    link = links.get(eid)
    link_dec = next((o for o in declog if o.get("kind") == "link" and o.get("reply_id") == eid), None)
    # REQ/PARENTS — postal-message decision records mentioning this event (msg id != event id,
    # but a parents decision can be keyed on a message this turn sent; surface when present).
    par_decs = [o for o in declog if o.get("kind") == "parents" and o.get("msg_id") in (eid,)]
    # DETAIL — feed-detail/<id>.json (mtime is a REAL write time).
    dt = detail_mtime(eid)
    # DISPOSITION — walk links → parents → ask roots to find where this landed for the user.
    roots = _root_asks((link or {}).get("request_ids"), nodes) if link else []
    return {
        "eid": eid, "name": name, "chip": chip, "dir": cdir, "typed": typed,
        "start": start, "end": end, "kind": kind, "ptext": ptext,
        "req_t": req_t, "req_phrase": req_phrase,
        "rep_t": rep_t, "phrase": phrase, "tag": tag,
        "asks": asks, "amends": amends, "cap": cap,
        "link": link, "link_dec": link_dec, "par_decs": par_decs,
        "detail_mtime": dt, "roots": roots, "cleared": cleared,
    }

# ── trace render ─────────────────────────────────────────────────────────────
# Aesthetic is BINDING: quiet. Default/dim text everywhere; color ONLY the
# identity chip, yellow/red for genuine stalls, and the recency-colored age.
# Every line is plain words — no symbol soup, no legend.

def _wrap(text, width, indent):
    """textwrap to terminal width, each continuation prefixed by `indent` (already colored)."""
    body = textwrap.wrap(text, width=max(20, width - len(_re.sub(r"\033\[[0-9;]*m", "", indent))))
    return [indent + ln for ln in body] if body else [indent.rstrip()]

def _stall(sec):
    """Color a wait: dim if short, yellow if it dragged, red if it stalled. Real waits only."""
    if sec is None: return C.DIM
    if sec < 120: return C.DIM
    if sec < 600: return C.YEL
    return C.RED

def trace_lines(tr, now, width):
    D, R = C.c(C.DIM), C.c(C.RESET)
    bar = f"{D}    │{R}"                                # the quiet flow spine
    tee = f"{D}    ├ {R}"                               # a branch into a stage
    L = []
    # ── header: turn id · session(identity chip) · who typed it · clock span ──
    chip = (C.rgb(tr["chip"]) + (tr["name"] or "?") + R) if tr["chip"] else (tr["name"] or "?")
    who = "typed by the user" if tr["typed"] else "agent-prompted"
    span = _hhmmss(tr["start"])
    if tr["end"]:
        dur = tr["end"] - tr["start"]
        span += f" → {_hhmmss(tr['end'])} ({agehms(dur)})"
    eid_short = tr["eid"].split(":")[0][:8] + "…:" + ":".join(tr["eid"].split(":")[1:])
    agec = f"{C.rgb(age_rgb(now - (tr['end'] or tr['start'])))}{agehms(now - (tr['end'] or tr['start']))} ago{R}"
    L.append(f"turn  {D}{eid_short}{R}  ·  {chip}  ·  {D}{who}{R}  ·  {D}{span}{R}  ·  {agec}")
    if tr["ptext"]:
        for ln in _wrap('"' + tr["ptext"] + '"', width, D + "  "):
            L.append(ln + R)
    L.append(bar)
    # ── SUMMARY / request side ──
    if tr["typed"]:
        # req_t is the turn's PROCESS START (an event time) — show the clock, not a latency.
        L.append(f"{tee}{C.c(C.BOLD)}summary · request{R}   {D}{_hhmmss(tr['req_t'])} (turn-start clock; event time, not a stage latency){R}")
        if tr["req_phrase"]:
            L.append(f"{bar}   {D}phrase:{R} {tr['req_phrase']}")
        # asks captured — the decision this side made about the user's intent.
        if tr["asks"]:
            L.append(f"{bar}   {D}asks captured:{R} {len(tr['asks'])}")
            for a in tr["asks"]:
                for ln in _wrap("• " + (a.get("text") or ""), width, bar + "     "):
                    L.append(ln)
        elif tr["amends"]:
            L.append(f"{bar}   {D}asks captured: none new — amended an existing ask{R}")
            for a in tr["amends"]:
                for ln in _wrap("• " + (a.get("text") or ""), width, bar + "     "):
                    L.append(ln)
        else:
            zero = "  ← zero-ask decision (logged)" if tr["cap"] else ""
            L.append(f"{bar}   {D}asks captured: none{zero}{R}")
        L.append(bar)
    elif tr["start"] >= REQUESTS_FLOOR:
        L.append(f"{tee}{C.c(C.BOLD)}summary · request{R}   {D}— agent-prompted, no user-ask on this turn{R}")
        L.append(bar)
    # ── SUMMARY / reply side ──
    if tr["rep_t"]:
        # rep_t is the turn's PERIOD END (an event time). The only real wait we can show is
        # detail-vs-end below; here just the clock + the tag the classifier chose.
        L.append(f"{tee}{C.c(C.BOLD)}summary · reply{R}   {D}{_hhmmss(tr['rep_t'])} (turn-end clock; event time){R}")
        if tr["phrase"]:
            L.append(f"{bar}   {D}phrase:{R} {tr['phrase']}")
        if tr["tag"]:
            L.append(f"{bar}   {D}tag:{R} {tr['tag'].lower()}")
        L.append(bar)
    else:
        L.append(f"{tee}{D}summary · reply   — not written yet (still summarizing){R}")
        L.append(bar)
    # ── LINK decision ──
    # The decision-log line is what the LINKER decided AT THE TIME, against its candidate set —
    # report exactly that (chose which of N). A later pass can append a DIFFERENT link (the
    # registry last-wins on reply_id), so when the standing link isn't covered by this decision's
    # chosen set we say so on its own line rather than mislabel the candidate count.
    dec = tr["link_dec"]
    cand_ids = set()
    if dec is not None:
        cands = dec.get("candidates") or []
        chosen = set(dec.get("chosen") or [])
        cand_ids = {c.get("id") for c in cands}
        n = len(cands)
        head = (f"{D}chose NONE of {n} candidate{'s' if n!=1 else ''}{R}" if not chosen
                else f"{D}chose {len(chosen)} of {n} candidate{'s' if n!=1 else ''}{R}")
        L.append(f"{tee}{C.c(C.BOLD)}link decision{R}   {head}")
        for i, c in enumerate(cands, 1):
            picked = c.get("id") in chosen
            mark = "✓" if picked else " "             # chosen reads at full weight, rest dim
            col = "" if picked else D
            for ln in _wrap(f"{i}. {c.get('text','')}", width, bar + f"   {mark} "):
                L.append(col + ln + R)
        raw = dec.get("raw")
        if raw is not None:
            L.append(f"{bar}   {D}model answer: {raw}{R}")
    # the standing link, when it differs from / postdates the logged decision (e.g. a later
    # link pass that matched a request that wasn't even in the original candidate set).
    if tr["link"]:
        rids = tr["link"].get("request_ids") or []
        extra = [r for r in rids if r not in cand_ids]
        if dec is None:
            L.append(f"{tee}{C.c(C.BOLD)}link decision{R}   {D}linked {len(rids)} request(s) (no decision-log line){R}")
        elif extra:
            L.append(f"{bar}   {D}later linked ({tr['link'].get('relevance','').lower()}) to {len(rids)} request(s) outside that candidate set{R}")
    if dec is not None or tr["link"]:
        L.append(bar)
    # ── REQ / PARENTS (postal delegation this turn made) ──
    for pd in tr["par_decs"]:
        chosen = pd.get("chosen") or []
        L.append(f"{tee}{C.c(C.BOLD)}req · parents{R}   {D}msg {pd.get('msg_id','')[:18]}… → {len(chosen)} parent(s){R}")
        L.append(bar)
    # ── DETAIL paragraph ──
    if tr["detail_mtime"]:
        # mtime is a REAL write time → a real latency from the turn end.
        lat = (tr["detail_mtime"] - tr["end"]) if tr["end"] else None
        latc = _stall(lat)
        latstr = f"  {C.c(latc)}(+{agehms(lat)} after turn end){R}" if lat is not None else ""
        L.append(f"{tee}{C.c(C.BOLD)}detail paragraph{R}   {D}{_hhmmss(tr['detail_mtime'])} written{R}{latstr}")
    else:
        if tr["tag"] in ("DONE", "DECISION"):
            wait = (now - tr["end"]) if tr["end"] else None
            L.append(f"{tee}{C.c(C.BOLD)}detail paragraph{R}   {C.c(_stall(wait))}expected — still in the generation queue{R}")
        else:
            L.append(f"{tee}{D}detail paragraph   n/a by design (routine turns get no paragraph){R}")
    L.append(bar)
    # ── DISPOSITION — where this event landed for the user ──
    disp, dcol = _disposition(tr)
    L.append(f"{D}    └ {R}{C.c(dcol)}disposition: {disp}{R}")
    return L

def _disposition(tr):
    """The final line: where the event landed for the user, and its color. Mirrors the surfaces'
    fold rules — ask membership (via root-walk), standalone card, or one of the hidden classes."""
    if tr["start"] < REQUESTS_FLOOR:
        return "hidden — pre-registry era (before the floor; no nodes/links)", C.DIM
    if tr["roots"]:
        texts = " · ".join(f"«{(r.get('text') or '')[:60]}»" for r in tr["roots"])
        return f"inside ask {texts}", C.GRN
    user_origin = tr["typed"]
    standalone = (user_origin and tr["tag"] in ("DONE", "DECISION")
                  and not tr["link"] and tr["start"] >= REQUESTS_FLOOR)
    if standalone:
        where = "NEEDS INPUT" if tr["tag"] == "DECISION" else "COMPLETED"
        return f"standalone card in {where} (user-origin, {tr['tag'].lower()}, unlinked)", C.YEL
    if not user_origin:
        return "hidden — agent-internal and unlinked (no ask claims it)", C.DIM
    return "hidden — routine progress (details turn, nothing for the user to act on)", C.DIM

# ── TUI (scrollable alt-screen) ──────────────────────────────────────────────
import re as _re
_ANSI = _re.compile(r"\033\[[0-9;?]*[A-Za-z]")
def _vis_trunc(s, w):
    out, vis, i = [], 0, 0
    while i < len(s):
        m = _ANSI.match(s, i)
        if m: out.append(m.group()); i = m.end(); continue
        if vis >= w: break
        out.append(s[i]); vis += 1; i += 1
    res = "".join(out)
    return res + (C.RESET if (C.on and "\033" in res) else "")

def _read_key(fd):
    ch = os.read(fd, 1)
    if ch != b"\x1b": return ch.decode("latin1", "ignore")
    if not _poll([fd], [], [], 0.02)[0]: return "\x1b"
    return "\x1b" + os.read(fd, 6).decode("latin1", "ignore")

def _highlight(s, w):
    """Reverse-video a row at terminal width — the only selection affordance (the user: nothing
    fancier). Truncate first, then wrap the visible text in SGR 7/27 so inner colors survive."""
    vis = _vis_trunc(s, w)
    if not C.on:
        return vis
    pad = w - len(_ANSI.sub("", vis))                # pad so the reverse bar spans the full width
    return "\033[7m" + vis + (" " * max(0, pad)) + "\033[27m"

def _trace_pane(out, fd, sz_fn, eid, refresh):
    """Full-screen trace for one event. Scrollable; Esc/q returns to the table. Re-reads on the
    same cadence so a live pipeline's later stages (a detail paragraph landing) appear."""
    off, next_r, first, lines = 0, 0.0, True, []
    while True:
        t = time.time()
        if first or t >= next_r:
            sz = sz_fn()
            lines = trace_lines(build_trace(eid), time.time(), min(sz.columns, 120))
            next_r = t + refresh; first = False
        sz = sz_fn()
        view = max(1, sz.lines - 2)
        max_off = max(0, len(lines) - view)
        off = min(max(0, off), max_off)
        win = lines[off:off + view]
        foot = f"{C.c(C.DIM)}↑/↓ scroll · q/Esc back to table{C.c(C.RESET)}"
        body = ["\033[H"] + [_vis_trunc(b, sz.columns) + "\033[K" for b in win]
        body += ["\033[K" for _ in range(view - len(win))]
        body.append(_vis_trunc(foot, sz.columns) + "\033[K")
        out.write("\r\n".join(body) + "\033[J"); out.flush()
        if _poll([sys.stdin], [], [], max(0.05, next_r - time.time()))[0]:
            k = _read_key(fd)
            if k in ("q", "\x1b", "\x03"): return
            elif k in ("\x1b[A", "k"): off -= 1
            elif k in ("\x1b[B", "j"): off += 1
            elif k in ("\x1b[5~", "b"): off -= view
            elif k in ("\x1b[6~", "f", " "): off += view
            elif k in ("g", "\x1b[H"): off = 0
            elif k in ("G", "\x1b[F"): off = max_off

def run_tui(args):
    fd = sys.stdin.fileno(); old = termios.tcgetattr(fd); out = sys.stdout
    out.write("\033[?1049h\033[?25l"); out.flush()
    offset, cursor, next_refresh, first = 0, 0, 0.0, True
    hdr = ""; head = []; body = []; frows = []
    sz_fn = os.get_terminal_size
    try:
        tty.setcbreak(fd)
        while True:
            t = time.time()
            if first or t >= next_refresh:
                rows, now, open_asks = build_rows()
                hdr, head, body, frows = build_lines(args, rows, now, open_asks)
                next_refresh = t + args.watch; first = False
            sz = sz_fn()
            view = max(1, sz.lines - 2 - len(head))
            cursor = min(max(0, cursor), max(0, len(body) - 1))
            # scroll so the cursor stays inside the viewport (keep the selected row visible)
            if cursor < offset: offset = cursor
            elif cursor >= offset + view: offset = cursor - view + 1
            offset = min(max(0, offset), max(0, len(body) - view))
            win = body[offset:offset + view]
            shown = f"{cursor+1}/{len(body)}" if body else "0/0"
            foot = f"{C.c(C.DIM)}↑/↓ select · Enter trace · g/G top·bottom · q quit   {shown}{C.c(C.RESET)}"
            rows_out = ["\033[H", _vis_trunc(hdr, sz.columns) + "\033[K"]
            rows_out += [_vis_trunc(h, sz.columns) + "\033[K" for h in head]
            for j, b in enumerate(win):
                sel = (offset + j) == cursor
                rows_out.append((_highlight(b, sz.columns) if sel else _vis_trunc(b, sz.columns)) + "\033[K")
            rows_out += ["\033[K" for _ in range(view - len(win))]
            rows_out.append(_vis_trunc(foot, sz.columns) + "\033[K")
            out.write("\r\n".join(rows_out) + "\033[J"); out.flush()
            if _poll([sys.stdin], [], [], max(0.05, next_refresh - time.time()))[0]:
                k = _read_key(fd)
                if k in ("q", "\x03"): break
                elif k in ("\x1b[A", "k"): cursor -= 1
                elif k in ("\x1b[B", "j"): cursor += 1
                elif k in ("\x1b[5~", "b"): cursor -= view
                elif k in ("\x1b[6~", "f", " "): cursor += view
                elif k in ("g", "\x1b[H"): cursor = 0
                elif k in ("G", "\x1b[F"): cursor = len(body) - 1
                elif k in ("\r", "\n"):                  # Enter → trace the selected turn
                    if 0 <= cursor < len(frows) and frows[cursor].get("eid"):
                        _trace_pane(out, fd, sz_fn, frows[cursor]["eid"], args.watch)
                        first = True                     # force a table redraw on return
    except KeyboardInterrupt: pass
    finally:
        termios.tcsetattr(fd, termios.TCSADRAIN, old)
        out.write("\033[?25h\033[?1049l"); out.flush()

def main():
    ap = argparse.ArgumentParser(add_help=True)
    ap.add_argument("-n", type=int, default=0, help="max rows")
    ap.add_argument("--pending", action="store_true", help="only events missing a stage")
    ap.add_argument("--watch", type=float, default=2.0, help="refresh seconds")
    ap.add_argument("--once", action="store_true", help="print once and exit")
    ap.add_argument("--trace", metavar="EVENT", help="print one event's pipeline trace and exit "
                    "(event id, or any unique prefix/suffix/epoch fragment of it)")
    ap.add_argument("--no-color", action="store_true")
    a = ap.parse_args()
    C.on = (not a.no_color) and sys.stdout.isatty()
    if a.trace:
        eid, err = _full_eid(a.trace)
        if err:
            print(err, file=sys.stderr); sys.exit(1)
        try: w = os.get_terminal_size().columns
        except OSError: w = 100
        tr = build_trace(eid)
        print("\n".join(trace_lines(tr, time.time(), min(w, 120))))
        return
    if a.once or not sys.stdout.isatty():
        rows, now, open_asks = build_rows()
        hdr, head, body, _ = build_lines(a, rows, now, open_asks)
        print("\n".join([hdr] + head + body))
        return
    run_tui(a)

if __name__ == "__main__":
    main()
