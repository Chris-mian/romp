#!/usr/bin/env bash
# romp-service — install/remove the login agent that keeps romp-manager (and thus the
# kernel) running at login, so you never run `romp on`: log in, open the browser, and
# you can even start sessions FROM it (the kernel is up before any session exists).
# Cross-platform: a launchd user agent on macOS, a systemd --user service on Linux.
#   romp-service install     write + load the agent (auto-start at login)
#   romp-service uninstall    unload + remove it
#   romp-service status       installed? running?
# Safe + idle-free: the kernel is hardened (Origin gate + token) and the producer is
# presence-gated (zero model calls when no browser is connected). Runs as a USER-level
# agent (no root). PATH + ROMP_DIR are baked into the unit so the service finds
# node / python3 / claude / the romp bins (reinstall after a PATH change to refresh).
set -euo pipefail

# Resolve the repo root through any symlink (matches the other bin/ consumers).
src="${BASH_SOURCE[0]}"
while [[ -L "$src" ]]; do
    tgt="$(readlink "$src")"
    case "$tgt" in /*) src="$tgt" ;; *) src="$(cd "$(dirname "$src")" && pwd)/$tgt" ;; esac
done
ROMP_DIR="$(cd "$(dirname "$src")/.." && pwd)"
MANAGER="${ROMP_MANAGER_BIN:-$ROMP_DIR/bin/romp-manager}"
LABEL="com.romp.manager"
STATE="${ROMP_STATE_DIR:-${XDG_STATE_HOME:-$HOME/.local/state}/romp}"
LOG="$STATE/manager.log"
# macOS Full Disk Access identity: the login agent runs the manager THROUGH this
# thin launcher, which execs it under a romp-owned copy of node at $ROMP_NODE
# (created by ensure_romp_node). TCC then labels the grant "romp-node" (romp
# only) instead of the shared "node". macOS-only; the Linux systemd unit is
# unchanged (no TCC there). See bin/romp-node-launch for the full rationale.
LAUNCHER="$ROMP_DIR/bin/romp-node-launch"
ROMP_NODE="$STATE/romp-node"

# Seams: OS, where the unit is written, whether to actually (un)load it (tests set
# ROMP_SERVICE_NO_LOAD=1 and point the dirs at a tmp path to assert unit content),
# and which launchctl to call (tests stub it to exercise the bootstrap retry path).
os="${ROMP_OS_OVERRIDE:-$(uname -s)}"
LAUNCHD_DIR="${ROMP_LAUNCHD_DIR:-$HOME/Library/LaunchAgents}"
SYSTEMD_DIR="${ROMP_SYSTEMD_DIR:-${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user}"
NO_LOAD="${ROMP_SERVICE_NO_LOAD:-}"
LAUNCHCTL="${ROMP_LAUNCHCTL:-launchctl}"
PLIST="$LAUNCHD_DIR/$LABEL.plist"
UNIT="$SYSTEMD_DIR/romp-manager.service"

write_plist() {
    mkdir -p "$LAUNCHD_DIR" "$STATE"
    cat > "$PLIST" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>$LABEL</string>
  <key>ProgramArguments</key>
  <array>
    <string>$LAUNCHER</string>
    <string>$MANAGER</string>
    <string>up</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key><string>$PATH</string>
    <key>ROMP_DIR</key><string>$ROMP_DIR</string>
    <key>ROMP_SUPERVISED</key><string>1</string>
  </dict>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>StandardOutPath</key><string>$LOG</string>
  <key>StandardErrorPath</key><string>$LOG</string>
</dict>
</plist>
EOF
}

write_unit() {
    mkdir -p "$SYSTEMD_DIR" "$STATE"
    cat > "$UNIT" <<EOF
[Unit]
Description=romp kernel supervisor (romp-manager)
After=default.target

[Service]
ExecStart=$MANAGER up
Restart=always
RestartSec=2
Environment=PATH=$PATH
Environment=ROMP_DIR=$ROMP_DIR
Environment=ROMP_SUPERVISED=1

[Install]
WantedBy=default.target
EOF
}

# Create/refresh the romp-owned node copy that romp-node-launch runs the manager
# under (macOS Full Disk Access identity). A byte-for-byte copy of the live node
# so it runs standalone; skipped when node isn't found. ROMP_NODE_SRC overrides
# the source (tests). Never fatal — a copy failure just leaves romp-node-launch
# to fall back to the system node.
ensure_romp_node() {
    local src="${ROMP_NODE_SRC:-$(command -v node 2>/dev/null || true)}"
    [[ -n "$src" ]] || return 0
    mkdir -p "$STATE"
    if [[ ! -x "$ROMP_NODE" ]] || ! cmp -s "$src" "$ROMP_NODE"; then
        if cp "$src" "$ROMP_NODE.tmp" 2>/dev/null && chmod +x "$ROMP_NODE.tmp"; then
            mv -f "$ROMP_NODE.tmp" "$ROMP_NODE"
        else
            rm -f "$ROMP_NODE.tmp" 2>/dev/null || true
        fi
    fi
    return 0
}

# Install attribution (2026-07-20): four times in one day the agent was rewritten/unloaded and the
# reload never landed — and the failure, though loud on the CALLER's stderr, left no trace saying
# WHO ran the install. Append who/where/when to the same audit journal `romp refresh` writes, so
# "who reinstalled the service?" is one tail instead of forensics. Best-effort, never blocks.
audit_install() {
    {
        _aud="$STATE/restart-audit.jsonl"
        mkdir -p "$STATE"
        _sid="${CLAUDE_CODE_SESSION_ID:-}"
        _name=""
        [[ -n "$_sid" && -f "$STATE/names/$_sid" ]] && _name="$(cut -f1 "$STATE/names/$_sid" 2>/dev/null | head -1)"
        printf '{"t": %s, "action": "service-%s", "ppid": %s, "parent": "%s", "sid": "%s", "name": "%s"}\n' \
            "$(date +%s)" "$1" "$PPID" \
            "$(ps -o command= -p "$PPID" 2>/dev/null | head -1 | tr -d '"\\' | cut -c1-160)" \
            "$_sid" "$_name" >> "$_aud"
    } 2>/dev/null || true
}

case "${1:-status}" in
  install)
    audit_install install
    case "$os" in
      Darwin)
        write_plist
        ensure_romp_node
        if [[ -z "$NO_LOAD" ]]; then
            "$LAUNCHCTL" bootout "gui/$(id -u)/$LABEL" 2>/dev/null || true   # drop any prior copy
            # bootout only STARTS the old job's teardown, and a manager draining live SDK
            # sessions takes far longer than a blind retry window — every bootstrap issued
            # while it drains is rejected ("Input/output error"), which is exactly how
            # 2026-07-20 ended (twice) with NO agent loaded and a dead dashboard. So wait
            # for the EVENT those retries were approximating: the old job actually
            # disappearing from launchd. Bounded poll; the loud failure below still
            # backstops a job that never finishes draining.
            for _ in $(seq 1 100); do
                "$LAUNCHCTL" print "gui/$(id -u)/$LABEL" >/dev/null 2>&1 || break
                sleep 0.3
            done
            # A bootstrap can still race launchd's bookkeeping right after the job drops.
            # Retry until launchd accepts, and fail LOUDLY if it never does:
            # swallowing this error once left NO agent loaded at all (no manager,
            # no kernel, dead dashboard) with nothing saying why.
            loaded=""
            for _ in $(seq 1 10); do
                if err="$("$LAUNCHCTL" bootstrap "gui/$(id -u)" "$PLIST" 2>&1)"; then loaded=1; break; fi
                sleep 0.3
            done
            if [[ -z "$loaded" ]]; then
                echo "romp-service: FAILED to load the login agent — romp-manager is NOT running." >&2
                echo "  launchctl bootstrap: ${err:-unknown error}" >&2
                echo "  Retry by hand: launchctl bootstrap gui/$(id -u) \"$PLIST\"" >&2
                exit 1
            fi
            # bootstrap ACCEPTED ≠ job RUNNING: launchd can accept the definition and still fail
            # the spawn (bad launcher path, env). Verify the service actually reports itself
            # before exiting 0 — an install that "succeeded" onto a dead agent is exactly the
            # silent outage this script keeps causing.
            running=""
            for _ in $(seq 1 20); do
                if "$LAUNCHCTL" print "gui/$(id -u)/$LABEL" >/dev/null 2>&1; then running=1; break; fi
                sleep 0.3
            done
            if [[ -z "$running" ]]; then
                echo "romp-service: agent loaded but is NOT running — check $LOG" >&2
                exit 1
            fi
        fi
        echo "  Installed launchd agent: $PLIST"
        echo "  romp-manager now auto-starts at login — just open the browser."
        if [[ -x "$ROMP_NODE" ]]; then
            echo
            echo "  Full Disk Access: grant it to romp's OWN node copy (not plain 'node'):"
            echo "      $ROMP_NODE"
            echo "  in System Settings > Privacy & Security > Full Disk Access (+, paste the path)."
            echo "  That scopes the grant to romp alone; re-grant once after a node upgrade."
        fi ;;
      Linux)
        write_unit
        if [[ -z "$NO_LOAD" ]]; then
            systemctl --user daemon-reload
            systemctl --user enable --now romp-manager.service
            loginctl enable-linger "$(id -un)" 2>/dev/null || true   # survive logout (best-effort)
        fi
        echo "  Installed systemd --user service: $UNIT"
        echo "  romp-manager now auto-starts at login — just open the browser." ;;
      *) echo "romp-service: unsupported OS '$os'" >&2; exit 1 ;;
    esac ;;
  uninstall)
    case "$os" in
      Darwin)
        if [[ -z "$NO_LOAD" ]]; then
            "$LAUNCHCTL" bootout "gui/$(id -u)/$LABEL" 2>/dev/null || "$LAUNCHCTL" unload "$PLIST" 2>/dev/null || true
        fi
        rm -f "$PLIST"
        echo "  Removed launchd agent." ;;
      Linux)
        if [[ -z "$NO_LOAD" ]]; then
            systemctl --user disable --now romp-manager.service 2>/dev/null || true
        fi
        rm -f "$UNIT"
        if [[ -z "$NO_LOAD" ]]; then systemctl --user daemon-reload 2>/dev/null || true; fi
        echo "  Removed systemd --user service." ;;
      *) echo "romp-service: unsupported OS '$os'" >&2; exit 1 ;;
    esac ;;
  status)
    case "$os" in
      Darwin)
        if [[ -f "$PLIST" ]]; then echo "installed: $PLIST"; else echo "not installed"; fi
        if [[ -z "$NO_LOAD" ]] && "$LAUNCHCTL" print "gui/$(id -u)/$LABEL" >/dev/null 2>&1; then echo "running"; fi ;;
      Linux)
        if [[ -f "$UNIT" ]]; then echo "installed: $UNIT"; else echo "not installed"; fi
        if [[ -z "$NO_LOAD" ]] && [[ "$(systemctl --user is-active romp-manager.service 2>/dev/null || true)" == "active" ]]; then echo "running"; fi ;;
      *) echo "romp-service: unsupported OS '$os'" >&2; exit 1 ;;
    esac ;;
  *) echo "usage: romp-service [install|uninstall|status]" >&2; exit 2 ;;
esac
