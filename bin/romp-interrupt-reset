#!/usr/bin/env bash
# romp-interrupt-reset — backgrounded from tmux when Ctrl+C or Esc is pressed
# in a romp session.
#
# Claude Code fires NO hook on a user interrupt (Stop deliberately does not
# fire on Ctrl+C / Esc, and there's no Interrupt hook), so a session's
# status would otherwise stay stuck on "working" — leaving the dashboard
# badge yellow and the ghostty tab dot 🟡 until the next prompt.
#
# We can't see the interrupt from a hook, but tmux saw the keystroke. So:
# after a short delay we VERIFY the interrupt actually landed by inspecting
# the pane — Claude's live "working" spinner always shows an elapsed timer
# like "(3s · …" (and, while generating, "esc to interrupt"). If that's
# gone, Claude is idle again → reset the session to ready. If it's still
# there (the interrupt didn't stop it, or it wasn't working), leave it: the
# next PostToolUse/Stop hook will keep the state correct.
#
# ─── FUTURE: delete this whole workaround when Claude Code gains an
#     interrupt hook ──────────────────────────────────────────────────
# This rebind-and-poll dance exists ONLY because Claude Code emits no hook
# on user interrupt — the Stop hook explicitly "does not run if the
# stoppage occurred due to a user interrupt" (per the hooks reference,
# https://code.claude.com/docs/en/hooks). Tracked upstream as:
#   • anthropics/claude-code #9516  — [FEATURE] User Interrupt Hook
#   • anthropics/claude-code #45289 — UserPromptCancel / Stop-on-cancel
# If/when such an event ships, retire all of this:
#   1. handle the new event in claude/hooks/tmux-status.sh → state=waiting
#      (treat it like Stop),
#   2. remove the `bind -n C-c …` and `bind -n Escape …` lines from tmux/tmux.conf,
#   3. delete this script and tests/romp-interrupt-reset.bats.
# ──────────────────────────────────────────────────────────────────────
set -euo pipefail

session="${1:?usage: romp-interrupt-reset <session>}"
delay="${ROMP_INTERRUPT_DELAY:-1}"   # seconds; overridable for tests

# Only romp sessions, and only when we currently believe it's working — so
# we never clobber a legitimately idle / awaiting-permission state.
[[ "$(tmux show -t "$session" -v @romp 2>/dev/null || true)" == "1" ]] || exit 0
[[ "$(tmux show -t "$session" -v @claude-state 2>/dev/null || true)" == "working" ]] || exit 0

sleep "$delay"

# Re-check the marker after the delay: a fresh PostToolUse may have fired
# (Claude really was still working), which keeps state at "working".
[[ "$(tmux show -t "$session" -v @claude-state 2>/dev/null || true)" == "working" ]] || exit 0

pane="$(tmux capture-pane -t "$session" -p 2>/dev/null || true)"
if ! grep -qE '\([0-9]+[ms]|esc to interrupt' <<<"$pane"; then
    # No live working indicator on the pane → the interrupt landed. The interrupt
    # is YOU interacting with the session, which counts as activity — so bump
    # @claude-state-since to now as well. That's the "last activity" clock the
    # dashboard, timeline, and idle-dot watcher (⚪) all judge staleness by;
    # without it, interrupting a task that had run >1h would read as instantly
    # idle. Active = you interacting OR the session working; an interrupt is the
    # former.
    now="$(date +%s)"
    tmux set -t "$session" @claude-state waiting \; \
         set -t "$session" @claude-state-since "$now" \; \
         set -t "$session" @romp-emoji "🔵"
fi
