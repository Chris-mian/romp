#!/usr/bin/env python3
"""romp-board — an INDEPENDENT terminal mirror of the dashboard feed (Working / Blocked / Completed).

WHY THIS EXISTS: the web feed is goal-stores → build_feed (romp-kernel) → feed.js (browser). When the
board disagrees with the browser, that localises the bug: if they AGREE, the goal stores are the truth
and both renders are faithful (so a wrong card is upstream, in the judge/planner); if they DIFFER, the
divergence is in build_feed or the browser bundle (e.g. a stale cached feed.js). To make that a real
cross-check, this tool deliberately does NOT import romp-kernel / romp-judge: it re-reads the SAME raw
inputs and re-implements the rollup itself. Independence is the whole point — keep it that way.

RAW INPUTS (all under $XDG_STATE_HOME/romp, default ~/.local/state/romp):
  goals/<sid>.json   per-session goal tree  {nodes:{id:{text,parentId,nodeComplete,blocked,cleared,t}},
                                              status:{topId:..}, lastNode, rompUuid}
  cleared.jsonl      append-only feed-clear log ({id,t,op})  — newest op per id wins; 'undo' un-clears
  names/<sid>        tab-separated: name \t .. \t #color
  tmux (live)        @romp / @romp-session-id / @claude-state  → which sessions are alive + their state

The status math here is a from-scratch re-implementation of romp-judge.rollup_status (precedence
cleared > blocked > completed+settled > working) plus the kernel's live-permission blocked floor. If
the rules change in romp-judge, this will (correctly) diverge until updated — that divergence is a
signal, not a bug.
"""
import os
import sys
import json
import time
import subprocess
from pathlib import Path

# ───────────────────────── raw readers (independent of the kernel) ─────────────────────────

def state_dir():
    home = Path(os.environ.get("HOME") or Path.home())
    base = os.environ.get("XDG_STATE_HOME") or str(home / ".local/state")
    return Path(base) / "romp"


def load_stores(state):
    """{sid: store} for every goals/<sid>.json, skipping unreadable/!dict ones."""
    out = {}
    for fp in sorted((state / "goals").glob("*.json")):
        try:
            d = json.loads(fp.read_text())
            if isinstance(d, dict) and isinstance(d.get("nodes"), dict):
                out[fp.stem] = d
        except Exception:
            pass
    return out


def cleared_ids(state):
    """Currently-cleared feed itemIds, replayed in file order from cleared.jsonl (a non-'undo' row sets
    the id, an 'undo' row removes it) — mirrors romp-kernel._cleared_ids exactly."""
    cur = {}
    try:
        for line in (state / "cleared.jsonl").read_text().splitlines():
            try:
                o = json.loads(line)
            except Exception:
                continue
            iid = o.get("id")
            if not iid:
                continue
            if o.get("op") == "undo":
                cur.pop(iid, None)
            else:
                cur[iid] = o.get("t", 0)
    except OSError:
        pass
    return set(cur)


def session_name(state, sid):
    try:
        return (state / "names" / sid).read_text().rstrip("\n").split("\t")[0] or sid[:8]
    except Exception:
        return sid[:8]


def session_color(state, sid):
    """[r,g,b] from the names registry (3rd tab field), or None."""
    try:
        parts = (state / "names" / sid).read_text().rstrip("\n").split("\t")
        if len(parts) > 2 and parts[2].startswith("#"):
            h = parts[2].lstrip("#")
            return [int(h[0:2], 16), int(h[2:4], 16), int(h[4:6], 16)]
    except Exception:
        pass
    return None


def tmux_sessions():
    """{sid: state} for alive romp sessions, queried straight from tmux (the one non-file source). {}
    when tmux is absent (headless) — the caller then treats every store as alive, like the kernel."""
    try:
        r = subprocess.run(["tmux", "list-sessions", "-F",
                            "#{@romp}|#{@romp-session-id}|#{@claude-state}"],
                           capture_output=True, text=True, timeout=2.5)
    except Exception:
        return {}
    if r.returncode != 0:
        return {}
    out = {}
    for line in r.stdout.splitlines():
        p = line.split("|")
        if len(p) >= 3 and p[0] == "1" and p[1]:
            out[p[1]] = p[2].strip()
    return out


# ───────────────────────── rollup (re-implemented from romp-judge.rollup_status) ─────────────────────────

def _children_map(nodes):
    ch = {}
    for nid, nd in nodes.items():
        ch.setdefault(nd.get("parentId"), []).append(nid)
    return ch


def _top_ancestor(nodes, nid):
    while nodes.get(nid, {}).get("parentId") is not None:
        nid = nodes[nid]["parentId"]
    return nid


def classify_store(store, session_closed, perm_floor=False):
    """Each top-goal's rolled-up status: 'cleared' | 'blocked' | 'completed' | 'working'.
    Precedence cleared > blocked > completed(+settled) > working. A node is complete if nodeComplete or
    (has kids and all kids complete); a (sub)tree that is complete can't be blocked (a finished ask's
    leftover child-block is moot); a goal completes only once SETTLED — no longer the focus, or the
    session is closed. perm_floor floors the focus top to blocked (a live permission prompt)."""
    nodes = store["nodes"]
    children = _children_map(nodes)

    def is_complete(nid):
        kids = children.get(nid, [])
        return nodes[nid].get("nodeComplete") or (bool(kids) and all(is_complete(c) for c in kids))

    def any_blocked(nid):
        if is_complete(nid):
            return False
        return bool(nodes[nid].get("blocked")) or any(any_blocked(c) for c in children.get(nid, []))

    focus = _top_ancestor(nodes, store["lastNode"]) if store.get("lastNode") in nodes else None
    perm_top = focus if (perm_floor and focus in nodes
                         and not nodes[focus].get("nodeComplete")
                         and not nodes[focus].get("cleared")) else None
    out = {}
    for nid in children.get(None, []):
        settled = (nid != focus) or session_closed
        if nodes[nid].get("cleared"):
            out[nid] = "cleared"
        elif nid == perm_top or any_blocked(nid):
            out[nid] = "blocked"
        elif is_complete(nid) and settled:
            out[nid] = "completed"
        else:
            out[nid] = "working"
    return out


def node_mark(nd):
    """Per-node state in the feed's vocabulary: done / blocked(needs-you) / open."""
    if nd.get("nodeComplete"):
        return "done"
    if nd.get("blocked"):
        return "blocked"
    return "open"


# ───────────────────────── render ─────────────────────────

COLUMNS = [("working", "WORKING"), ("blocked", "BLOCKED"), ("completed", "COMPLETED")]
MARK = {"done": "✓", "blocked": "!", "open": "○"}


class Style:
    def __init__(self, color):
        self.color = color

    def c(self, s, code):
        return ("\033[%sm%s\033[0m" % (code, s)) if self.color else s

    def rgb(self, s, rgb):
        if not self.color or not rgb:
            return s
        return "\033[38;2;%d;%d;%dm%s\033[0m" % (rgb[0], rgb[1], rgb[2], s)

    def mark(self, m):
        glyph = MARK[m]
        if not self.color:
            return glyph
        return {"done": "\033[32m%s\033[0m", "blocked": "\033[31m%s\033[0m",
                "open": "\033[90m%s\033[0m"}[m] % glyph


def build_board(state, include_dead=False, session_filter=None):
    """The full picture: {sid: {name,color,alive,state, tops:{status:[topId..]}, store}} for the
    sessions to show, plus the per-column ordering. One place builds it; render/json both consume it."""
    stores = load_stores(state)
    cleared = cleared_ids(state)
    tmux = tmux_sessions()
    rows = []
    for sid, store in stores.items():
        alive = (sid in tmux) if tmux else True
        if not alive and not include_dead:
            continue
        name = session_name(state, sid)
        if session_filter and session_filter.lower() not in (name.lower(), sid.lower(), sid[:8].lower()):
            continue
        st = tmux.get(sid, "" if alive else "closed")
        status = classify_store(store, session_closed=not alive, perm_floor=(st == "permission"))
        rows.append({"sid": sid, "name": name, "color": session_color(state, sid),
                     "alive": alive, "state": st, "status": status, "store": store,
                     "cleared": cleared})
    return rows


def _flatten(store, top, marks_only=False):
    """The top's subtree as (depth, node) pairs, children oldest-first — build_feed's flatten order."""
    nodes = store["nodes"]
    children = _children_map(nodes)
    out = []

    def walk(nid, depth):
        out.append((depth, nodes[nid]))
        for c in sorted(children.get(nid, []), key=lambda c: nodes[c].get("t", 0)):
            walk(c, depth + 1)
    walk(top, 0)
    return out


def render(rows, style, header=None):
    """The board: three columns, every node line carrying its raw flags + short id (so a divergence
    from the browser is debuggable at a glance — there's no terse mode, this IS the mode)."""
    out = []
    if header:
        out.append(style.c(header, "90"))
        out.append("")
    # bucket every visible top under its column, tagged with its owning session row
    buckets = {k: [] for k, _ in COLUMNS}
    for r in rows:
        for top, col in r["status"].items():
            if col == "cleared" or top in r["cleared"]:
                continue
            buckets[col].append((r, top))

    def flags(nd):
        return style.c("  [c=%s b=%s id=%s]" % (1 if nd.get("nodeComplete") else 0,
                       1 if nd.get("blocked") else 0, nd.get("id", "?")[-6:]), "90")

    for col, label in COLUMNS:
        items = buckets[col]
        head = "%s  (%d)" % (label, len(items))
        out.append(style.c(head, "1;33" if col == "working" else "1;31" if col == "blocked" else "1;34"))
        if not items:
            out.append("  " + style.c("—", "90"))
            out.append("")
            continue
        for r, top in items:
            store = r["store"]
            who = style.rgb(r["name"], r["color"])
            if not r["alive"]:
                who += style.c(" (dead)", "90")
            tree = _flatten(store, top)
            roottext = store["nodes"][top].get("text") or "(untitled)"
            out.append("  %s %s   %s%s" % (style.mark(node_mark(store["nodes"][top])), roottext, who,
                                           flags(store["nodes"][top])))
            for depth, nd in tree[1:]:
                ind = "    " + "  " * depth
                txt = nd.get("text") or "(node)"
                line = "%s%s %s%s%s" % (ind, style.mark(node_mark(nd)), txt,
                                        style.c("  [cleared]", "90") if nd.get("cleared") else "", flags(nd))
                if nd.get("cleared"):
                    line = style.c(line, "90")
                out.append(line)
            out.append("")
    return "\n".join(out).rstrip("\n") + "\n"


# ───────────────────────── cli ─────────────────────────

def _parse_args(argv):
    a = {"all": False, "session": None, "color": None, "help": False}
    it = iter(argv)
    for tok in it:
        if tok in ("--all", "-a"):
            a["all"] = True
        elif tok == "--no-color":
            a["color"] = False
        elif tok in ("--session", "-s"):
            a["session"] = next(it, None)
        elif tok in ("--help", "-h"):
            a["help"] = True
    return a


HELP = """romp-board — live terminal mirror of the dashboard feed (independent of the kernel render path)

Working / blocked / completed for non-cleared goals, every node showing its raw complete/blocked
flags + id. Redraws every second in a terminal (^C to stop); prints once when piped. For build/kernel
versions use `romp --version`.

  romp-board                      alive sessions
  romp-board --all                include dead sessions too
  romp-board --session web_view   only that session (name, sid, or sid prefix)
  romp-board --no-color           plain text
"""


def main(argv):
    a = _parse_args(argv)
    if a["help"]:
        sys.stdout.write(HELP)
        return 0
    state = state_dir()
    tty = sys.stdout.isatty()
    style = Style(tty if a["color"] is None else a["color"])

    def once():
        rows = build_board(state, include_dead=a["all"], session_filter=a["session"])
        return render(rows, style, header="romp-board · %s  (romp --version for builds)" % time.strftime("%H:%M:%S"))

    if not tty:                                  # piped/redirected → single snapshot, no watch loop
        sys.stdout.write(once())
        return 0
    try:
        while True:                              # interactive → live board, redraw every second
            sys.stdout.write("\033[2J\033[H")
            sys.stdout.write(once())
            sys.stdout.flush()
            time.sleep(1.0)
    except KeyboardInterrupt:
        return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
