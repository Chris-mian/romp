#!/usr/bin/env bash
# romp-serve — launches the romp web UI kernel for the manager (bin/romp-manager) to
# supervise. It is the seam between the manager's spawn contract and the kernel: the
# manager runs `romp-serve --port N` (with ROMP_SERVE_PORT / ROMP_MANAGER_PID in env)
# and supervises the resulting PID. We map those onto the Python kernel's env and
# `exec` it, so the manager keeps supervising the same PID and the kernel self-builds
# its UI bundles if stale.
#   romp-serve [--port N] [--host H] [--print-python]
# Host precedence: --host > local-only. The kernel stays bound to 127.0.0.1;
# tailnet/phone reach goes through `tailscale serve` proxying to loopback
# (docs/guide.md#from-your-phone), so there is no persisted off-loopback opt-in
# (`romp --serve` removed 2026-07-19). --host remains as the manager's spawn seam.
set -euo pipefail

# Resolve the repo root through any symlink (matches the other bin/ consumers).
src="${BASH_SOURCE[0]}"
while [[ -L "$src" ]]; do
    tgt="$(readlink "$src")"
    case "$tgt" in
        /*) src="$tgt" ;;
        *)  src="$(cd "$(dirname "$src")" && pwd)/$tgt" ;;
    esac
done
ROMP_DIR="$(cd "$(dirname "$src")/.." && pwd)"
# ROMP_KERNEL_BIN is the test seam (same pattern as ROMP_*_BIN elsewhere).
KERNEL="${ROMP_KERNEL_BIN:-$ROMP_DIR/bin/romp-kernel}"

# Port: the manager passes --port; fall back to the env, then the kernel default.
#
# ROMP_SERVE_PORT and ROMP_KERNEL_PORT are TWO SPELLINGS OF ONE VALUE: the port the kernel
# listens on. The split is historical and role-based, not semantic. ROMP_SERVE_PORT is the
# service-facing spelling (romp-manager, romp-service's unit, the wake hook, the VS Code
# extension); ROMP_KERNEL_PORT is the process-facing one (kernel.py, the postal bus, every
# `romp` CLI verb). This script is the seam between them, so it is where they have to agree.
#
# It used to read only ROMP_SERVE_PORT and then unconditionally OVERWRITE ROMP_KERNEL_PORT
# from it. Someone renumbering a second kernel by the documented knob alone (docs/reference.md
# names ROMP_KERNEL_PORT and not the other) got the two silently pulled apart: the unit carried
# no port, the manager fell back to the default, this script stamped that default over the
# inherited ROMP_KERNEL_PORT, and the second kernel bound the FIRST one's port while every
# foreground `romp` command went on printing the renumbered one. A collision that reports
# success is the exact shape the authoritative-sources rule exists to prevent, so now: accept
# either spelling, and if both are set and DISAGREE with no --port to settle it, refuse.
port=""
host=""
print_python=""
while [[ $# -gt 0 ]]; do
    case "$1" in
        --port) port="${2:-}"; shift 2 ;;
        --host) host="${2:-}"; shift 2 ;;
        --print-python) print_python=1; shift ;;   # install.sh's preflight: the interpreter the kernel would run, floor applied
        *) shift ;;
    esac
done
if [[ -z "$port" ]]; then
    _sp="${ROMP_SERVE_PORT:-}"
    _kp="${ROMP_KERNEL_PORT:-}"
    if [[ -n "$_sp" && -n "$_kp" && "$_sp" != "$_kp" ]]; then
        echo "romp-serve: ROMP_SERVE_PORT=$_sp and ROMP_KERNEL_PORT=$_kp disagree." >&2
        echo "  They are two names for the kernel's listen port and must match. Set one, or pass --port." >&2
        exit 1
    fi
    port="${_sp:-$_kp}"
fi

# Host: explicit --host wins; else local-only. A leftover serve-host state file
# from the removed `romp --serve` opt-in is deliberately IGNORED — a stale file
# must never silently rebind the kernel off loopback.
host="${host:-127.0.0.1}"

[[ -x "$KERNEL" ]] || { echo "romp-serve: kernel not found/executable at $KERNEL" >&2; exit 1; }

# The kernel runs on the python its SDK venv was built with, not blindly `python3` and not whatever
# is newest: the Agent SDK backend is imported INTO the kernel process (the venv's site-packages join
# sys.path), so interpreter and venv must agree. Order: ROMP_PYTHON (checked to be an executable
# interpreter), then the interpreter the venv's pyvenv.cfg records (checked to run and to be the
# recorded X.Y and the build the venv's lib directory names), then another python of that same X.Y
# and build on PATH or in ~/.local/bin, then the newest pythonX.Y found (the SDK needs >= 3.10, and
# some hosts pin the system python3 older, Ubuntu 20.04 = 3.8, with a newer one alongside, e.g. a
# uv-managed 3.12 in ~/.local/bin, probed explicitly because a non-login ssh shell doesn't have it
# on PATH).
# KEEP IN SYNC with the pick_python in bin/romp-sdk-setup and bin/romp-codex-setup, byte for byte
# (tests/romp-serve.bats diffs the three): each venv must be built with the SAME interpreter the
# kernel runs.
pick_python() {
    if [[ -n "${ROMP_PYTHON:-}" ]]; then
        # The pin is checked, not echoed as-is. A pin naming nothing runnable used to reach romp-serve's
        # exec, which died on bash's own "No such file or directory" with no mention of the pin while the
        # manager crash-looped on it, and romp-sdk-setup called the same pin a too-old python. The docs
        # tell operators to pin ROMP_PYTHON in service.env, so a typo, or an upgrade that removes the
        # pinned interpreter, lands here. A bare command name is looked up on PATH, as the exec would.
        local pin="$ROMP_PYTHON"
        [[ "$pin" == */* ]] || pin="$(type -P "$pin" 2>/dev/null || true)"
        if [[ -z "$pin" || ! -f "$pin" || ! -x "$pin" ]]; then
            echo "romp: ROMP_PYTHON=$ROMP_PYTHON is not an executable interpreter (set in service.env?)" >&2
            exit 1
        fi
        echo "$ROMP_PYTHON"; return
    fi
    local v c
    # THE VENV FIRST. bin/romp-sdk-setup builds the SDK venv with the interpreter this function picked at
    # the time, and pyvenv.cfg records it. Running anything else imports 3.X-compiled extensions into a
    # 3.Y process: on 2026-09-06 a `uv python install 3.14` in an unrelated shell put a python3.14 into
    # ~/.local/bin, the next kernel respawn picked it over the venv's 3.12, and every SDK session died at
    # import for two hours while the message blamed a missing install. So a machine that HAS a venv runs
    # the venv's interpreter, however old, and the newest-first walk below is only for a machine without
    # one (or whose recorded interpreter is gone; then we say so and romp-sdk-setup rebuilds to match).
    # Builtins only in here: the unit tests run it on a bare PATH. This function is kept byte for byte
    # with its copies in bin/romp-serve, bin/romp-sdk-setup and bin/romp-codex-setup (tests/romp-serve.bats
    # diffs the three).
    #
    # A candidate must RUN, and when the cfg names a version it must BE the python the venv was built for:
    # the X.Y the cfg records plus the build, `t` for a free-threaded interpreter, read from the tag venv
    # names lib/ with (lib/python3.14t; the cfg does not say). The kernel keys its venv match on that same
    # tag (_running_python_tag), so a default-build 3.14 handed a 3.14t venv would boot and then refuse the
    # venv as a mismatch. `home` is a directory, and a distro upgrade that removes python3.12 and repoints
    # home/python3 at 3.14 leaves that path present and runnable while the venv's extensions are still
    # 3.12's, the exact failure the recorded interpreter exists to prevent. The check reads
    # sys.version_info and sys.abiflags (builtins only; the build is decided by the flags, never by the
    # file name: uv's free-threaded install has python3.14 as a link to python3.14t), and it is bounded:
    # this is the first place the picker executes a candidate, and an interpreter that blocks (a stalled
    # network mount, a sitecustomize reaching for the network) would otherwise hang the launch with the
    # manager watching a live pid. `timeout 5` where coreutils provides it (a bare test PATH does not);
    # running out the clock counts as not runnable.
    _runs_as() {   # $1 candidate, $2 the X.Y it must be ("" for "runs at all"), $3 the build: "t" or ""
        local -a run=("$1")
        if command -v timeout >/dev/null 2>&1; then run=(timeout 5 "$1"); fi
        if [[ -n "$2" ]]; then
            "${run[@]}" -c "import sys; sys.exit(sys.version_info[:2] != (${2%%.*}, ${2#*.}) or ('t' in getattr(sys, 'abiflags', '')) != bool('${3:-}'))" >/dev/null 2>&1
        else
            "${run[@]}" -c pass >/dev/null 2>&1
        fi
    }
    local state="${ROMP_STATE_DIR:-${XDG_STATE_HOME:-$HOME/.local/state}/romp}"
    local cfg="$state/sdkvenv/pyvenv.cfg"
    if [[ -r "$cfg" ]]; then
        local key val exe="" home="" ver="" mm="" abi="" tag=""
        while IFS='=' read -r key val || [[ -n "$key" ]]; do
            key="${key%%[[:space:]]*}"
            val="${val#"${val%%[![:space:]]*}"}"; val="${val%"${val##*[![:space:]]}"}"
            case "$key" in
                executable)           exe="$val" ;;    # python >= 3.11 writes the binary itself
                home)                 home="$val" ;;   # older venvs: the bin dir plus a version line
                version|version_info) ver="$val" ;;    # `version` from venv, `version_info` from uv
            esac
        done < "$cfg"
        [[ "$ver" =~ ^([0-9]+\.[0-9]+) ]] && mm="${BASH_REMATCH[1]}"
        # The build, from the lib directory carrying the cfg's X.Y: lib/python3.14t is a free-threaded
        # venv. A cfg with no such directory reads as the default build, as romp-sdk-setup's
        # venv_built_for reads it.
        if [[ -n "$mm" && ! -d "$state/sdkvenv/lib/python$mm" && -d "$state/sdkvenv/lib/python${mm}t" ]]; then abi="t"; fi
        tag="$mm$abi"
        # The home candidates need the version. Without it `$home/python$mm` is the bare `$home/python`
        # (python2 on many machines) and `$home/python3` can be checked against nothing, so a cfg with a
        # home but no version line (hand-edited or truncated; venv, uv and virtualenv all write one)
        # yields only its `executable`, the recorded binary itself. A tagged venv tries home/python3.14t
        # and then home/python3.14 (a link to the t build in uv's layout; a default build under that name
        # fails the flags check, where it used to be taken silently).
        for c in "$exe" "${mm:+${home:+$home/python$tag}}" "${abi:+${mm:+${home:+$home/python$mm}}}" "${mm:+${home:+$home/python3}}"; do
            [[ -n "$c" && -x "$c" ]] || continue
            if _runs_as "$c" "$mm" "$abi"; then echo "$c"; return; fi
        done
        local rec="${exe:-${home:-?}/python${tag:-?}}"
        # THE SAME BUILD NEXT. The venv's site-packages are ABI-valid for any python of its tag, so another
        # python$tag on PATH or in ~/.local/bin keeps the kernel and the venv agreeing with nothing rebuilt:
        # `executable` is a realpath into a patch-versioned install root (Homebrew's Cellar, a uv
        # per-patch directory), which a patch upgrade removes while `python3.12` on PATH still runs. A
        # tagged venv tries python3.14t first and python3.14 after it; an untagged venv tries python3.14
        # alone, and a free-threaded build under that name is refused. Newest-first is the last resort,
        # and it costs a rebuild.
        if [[ -n "$mm" ]]; then
            local -a same=("python$tag" "$HOME/.local/bin/python$tag")
            [[ -n "$abi" ]] && same+=("python$mm" "$HOME/.local/bin/python$mm")
            for c in "${same[@]}"; do
                c="$(command -v "$c" 2>/dev/null || true)"
                [[ -n "$c" ]] || continue
                if _runs_as "$c" "$mm" "$abi"; then
                    echo "romp: the SDK venv at $state/sdkvenv was built with $rec, which is gone, will not run, or is no longer python $tag; using $c, another python $tag (the same minor and the same build), so the venv still matches." >&2
                    echo "$c"; return
                fi
            done
        fi
        echo "romp: the SDK venv at $state/sdkvenv was built with $rec, which is gone, will not run, or is no longer python ${tag:-?}, and no other python ${tag:-?} was found; picking the newest python instead. Re-run bin/romp-sdk-setup to rebuild the venv for it." >&2
    fi
    # Newest first. The list has to GROW with each release: a machine whose only python is newer than
    # everything named here falls through to `python3`, which is right when that IS the new one and wrong
    # when python3 points at something ancient. Seen on a 3.14-only box, 2026-07-28.
    for v in 3.14 3.13 3.12 3.11 3.10; do
        for c in "python$v" "$HOME/.local/bin/python$v"; do
            if command -v "$c" >/dev/null 2>&1; then command -v "$c"; return; fi
        done
    done
    command -v python3 || { echo "romp: no python3 on PATH" >&2; exit 1; }
}
PY="$(pick_python)"

# THE FLOOR (issue 1600): the kernel and the Agent SDK need python 3.10 or newer. The only gate used to sit
# in romp-sdk-setup, whose failure banners and lets the install finish, and this script then exec'd the
# kernel on whatever python3 the pick fell through to, so a fresh install on a machine whose python3 is
# 3.9 crash-looped the manager on a SyntaxError. The picked interpreter reports its version here and a
# reading below the floor is refused with the install command, before the exec. An interpreter that
# cannot report a version at all (the test suites' shell stand-ins) is left to the exec as before: the
# pick already checked it is an executable file, and a version nobody can read is not a version below the
# floor. `--print-python` (install.sh's preflight) prints the pick and stops here, floor applied. The version is
# the first line of the probe's output that IS a bare X.Y, carriage returns stripped: a chatty site customization
# printing before the program, an atexit hook printing after it, or a CRLF-terminated line would otherwise hide
# the number and let a 3.9 through. The floor exits 2, a code of its own, so install.sh can tell "the python is
# too old" from this script's other refusals (the two port spellings disagreeing, a kernel binary that is not
# there, an unrunnable ROMP_PYTHON pin), which stay at 1.
#
# This is the FIRST execution of the picked interpreter (pick_python checks a pin's file and the walk uses
# command -v), and install.sh's preflight runs it, so it is bounded where coreutils provides `timeout`: `timeout -k 1 5`,
# plain, so at the bound it signals its whole process group and a child the interpreter left behind dies with it
# (round five of issue 1600: --foreground had given that up), the KILL a second after the TERM covering an interpreter
# that ignores TERM. That KILL reaches timeout itself, so the bound reads 137 as well as 124, and an interpreter that
# exits either code of its own accord is refused as unresponsive with it: no clock tells them apart. The probe runs in
# a subshell that ends in exit with its stderr dropped, so the shell prints no job-status line for a KILLed timeout
# (the launcher's wrapper shape). Where there is no timeout (a stock mac) the probe is unbounded, as the picker's own
# runs of a candidate are; the reference names that residual. Running out the clock is NOT the no-version leg: the
# interpreter is refused, exit 1 (install.sh passes that through).
# The output goes to a FILE where one can be made (TMPDIR, then /tmp, then the state directory; mktemp under or-true,
# since an unwritable or stale TMPDIR, a launchd agent's /var/folders path across a reboot, or a PATH without mktemp
# must not refuse a good interpreter), read afterwards, so a helper the interpreter leaves holding stdout cannot hold
# the read (round four); with no file the read is from a pipe, which the same timeout bounds where there is one. The
# file goes with the shell, a TERM mid-probe included (the traps below, cleared before the exec).
# The version rides a SENTINEL line, "romp-pyver X.Y", so chatter that happens to be a bare number (a 2.7 printed
# by a site customization before the program) cannot pass for the version, and a decorated version cannot hide.
_pyprog='import sys; print("romp-pyver %d.%d" % sys.version_info[:2])'
_pyout_file=""
if command -v mktemp >/dev/null 2>&1; then
    for _pydir in "${TMPDIR:-}" /tmp "${ROMP_STATE_DIR:-${XDG_STATE_HOME:-$HOME/.local/state}/romp}"; do
        [[ -n "$_pydir" && -d "$_pydir" ]] || continue
        _pyout_file="$(mktemp "$_pydir/romp-pyver.XXXXXX" 2>/dev/null)" || _pyout_file=""
        [[ -n "$_pyout_file" ]] && break
    done
fi
_pyrm() { [[ -n "$_pyout_file" ]] && rm -f "$_pyout_file" 2>/dev/null; return 0; }
trap '_pyrm' EXIT
# a TERM to this script during the probe is acted on when the foreground probe returns (bash runs a trap after the
# command it interrupted), at the bound at the latest: the exit is 143 then, not at once
trap '_pyrm; exit 143' TERM INT HUP
_prc=0 _pybounded="" _pyout=""
if command -v timeout >/dev/null 2>&1; then
    _pybounded=1
    if [[ -n "$_pyout_file" ]]; then
        ( timeout -k 1 5 "$PY" -c "$_pyprog" </dev/null >"$_pyout_file" 2>/dev/null; exit $? ) 2>/dev/null || _prc=$?
        # the shell reads the file itself: a cat here was the script's only external read, and a PATH with timeout
        # and mktemp but no cat read no version and STARTED a 3.9 pin, fail-open and silent. A plain read, not the
        # $(<file) form: bash performs that one in the current shell, and a redirection that fails there (the probe
        # file gone inside the window: an interpreter that unlinks its own stdout) exits the script under set -e
        # before any or-else runs, a silent refusal of a good interpreter; read's failed redirection is an ordinary
        # command failure, the or-true stands, and an unreadable file is the no-version leg
        { IFS= read -r -d '' _pyout < "$_pyout_file"; } 2>/dev/null || true
    else
        _pyout="$( ( timeout -k 1 5 "$PY" -c "$_pyprog" </dev/null 2>/dev/null; exit $? ) 2>/dev/null )" || _prc=$?
    fi
else
    if [[ -n "$_pyout_file" ]]; then
        "$PY" -c "$_pyprog" </dev/null >"$_pyout_file" 2>/dev/null || _prc=$?
        { IFS= read -r -d '' _pyout < "$_pyout_file"; } 2>/dev/null || true
    else
        _pyout="$("$PY" -c "$_pyprog" </dev/null 2>/dev/null)" || _prc=$?
    fi
fi
_pyrm; trap - EXIT TERM INT HUP
if [[ -n "$_pybounded" && ( "$_prc" -eq 124 || "$_prc" -eq 137 ) ]]; then
    echo "romp: $PY did not answer its version probe within 5 s, or exited with the bound's own code (exit $_prc): unresponsive (a stalled network mount, a site customization reaching for the network), or an interpreter that exits 124 or 137 of its own accord reads the same; the kernel is not started on it." >&2
    exit 1
fi
_pyver=""
while IFS= read -r _pyline; do
    _pyline="${_pyline%$'\r'}"
    if [[ "$_pyline" =~ ^romp-pyver\ ([0-9]+)\.([0-9]+)$ ]]; then _pyver="${BASH_REMATCH[1]}.${BASH_REMATCH[2]}"; break; fi
done <<< "$_pyout"
if [[ "$_pyver" =~ ^([0-9]+)\.([0-9]+)$ ]] && (( BASH_REMATCH[1] < 3 || (BASH_REMATCH[1] == 3 && BASH_REMATCH[2] < 10) )); then
    echo "romp: $PY is python $_pyver; the kernel and the Agent SDK need 3.10 or newer, so the kernel is not started on it." >&2
    echo "  macOS:  brew install python@3.13    or:  uv python install 3.13    (or pin one: ROMP_PYTHON=/path/to/python3.13 in service.env)" >&2
    exit 2
fi
if [[ -n "$print_python" ]]; then echo "$PY"; exit 0; fi

# Map onto the kernel's env, then exec it (preserving the PID for the manager).
# ROMP_MANAGER_PID (parent-death watchdog) and ROMP_SERVE_TOKEN (auto-loaded from the
# persisted token file if unset) flow through untouched. ROMP_KERNEL_NO_OPEN keeps a
# supervised kernel from popping a browser on every (re)spawn.
export ROMP_DIR
export ROMP_BIN="${ROMP_BIN:-$ROMP_DIR/bin/romp}"
# Export BOTH spellings from the ONE resolved port, so nothing downstream can read a stale
# inherited copy of the other name: the kernel and the postal bus read ROMP_KERNEL_PORT, while
# the wake hook and any `romp` CLI run inside a session of this kernel may read either. Unset
# stays unset (the kernel applies its own default), so a bare launch is unchanged.
if [[ -n "$port" ]]; then
    export ROMP_KERNEL_PORT="$port"
    export ROMP_SERVE_PORT="$port"
fi
export ROMP_SERVE_HOST="$host"
export ROMP_KERNEL_NO_OPEN=1
exec "$PY" "$KERNEL"
