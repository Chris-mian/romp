#!/usr/bin/env python3
# romp-postal — the Romp Postal Service.
#
# Peer messaging between romp (Claude Code) sessions, local and remote. One
# stdlib-only program (no deps, nothing to install) with several modes:
#
#   romp-postal serve            run the message bus (HTTP, singleton on 127.0.0.1:PORT)
#   romp-postal ensure           start the bus if it isn't running (race-safe; no-op on remote)
#   romp-postal mcp              run the per-session stdio MCP server (tool-native messaging)
#   romp-postal send <to> <txt>  deliver a message to a live romp session       [CLI]
#   romp-postal inbox            print + consume this session's mail             [CLI]
#   romp-postal peek             print this session's mail without consuming     [CLI]
#   romp-postal agents           list romp sessions (+ branch + what they're on)  [CLI]
#   romp-postal working <text>   publish what this session is working on          [CLI]
#   romp-postal sent             this session's sent messages + read status       [CLI]
#   romp-postal recall <to> [id] unsend an unread/parked message you sent          [CLI]
#   romp-postal find [query]     search past+present sessions by saved summaries   [CLI]
#   romp-postal revive <name>    revive a dead session (romp --resume, detached)   [CLI]
#   romp-postal drain --id <id>  loop-guarded consume, for the Stop hook
#
# Architecture: the bus is the single source of truth. Everything (the MCP
# server, the CLI, the Stop hook) talks to it over HTTP at 127.0.0.1:PORT, so
# local and remote sessions use the exact same address — a remote session just
# tunnels that port to the laptop with `ssh -R PORT:127.0.0.1:PORT`. The bus
# persists mailboxes to $XDG_STATE_HOME/romp/postal/mail/<session-id>/ (Maildir,
# atomic delivery), resolves recipient names against the live romp sessions
# (tmux) plus any heartbeating remote agents, and shuts itself down once no romp
# clients remain.
#
# Delivery has two paths. The backstop is the Stop hook: a recipient drains its
# mailbox at the next turn boundary (also check_inbox / `romp --mail inbox`). On
# top of that, push-on-deliver (see _push) auto-wakes an IDLE local session by
# typing the mail straight into its prompt and submitting it — so a session
# sitting idle reacts immediately instead of only at its next turn. The push is
# careful never to clobber a draft (it stashes/restores via Ctrl+S) and stays
# clear of sessions at a permission prompt or mid-turn-with-a-draft, falling back
# to the drain whenever live injection isn't safe. Disable the push alone with
# ~/.claude/romp-postal-nopush; disable everything with ~/.claude/romp-postal-off.

import json
import os
import random
import re
import shutil
import socket
import subprocess
import sys
import threading
import time
import urllib.error
import urllib.parse
import urllib.request
from datetime import datetime
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from pathlib import Path

HOST = "127.0.0.1"
PORT = int(os.environ.get("ROMP_POSTAL_PORT", "47100"))
BASE = f"http://{HOST}:{PORT}"

STATE = Path(os.environ.get("XDG_STATE_HOME", str(Path.home() / ".local/state"))) / "romp" / "postal"
MAILROOT = STATE / "mail"
MAILPENDING = STATE / "mail-pending"   # touch <sid> here IFF that session has unread mail in new/
LOG = STATE / "server.log"
PIDFILE = STATE / "server.pid"
NAMES_DIR = Path(os.environ.get("XDG_STATE_HOME", str(Path.home() / ".local/state"))) / "romp" / "names"
TLDIR = STATE.parent / "timeline"     # append-only logs for the timeline view (messages.jsonl)
SUMMARIES_DIR = STATE.parent / "summaries"   # per-session Haiku request/reply summaries (romp-summarize backfill)
STATESDIR = STATE.parent / "states"          # per-session state-transition log (tmux-status.sh schema)

# The romp launcher (same dir as this script); used to REVIVE a dead session via
# `romp <name> --resume <uuid> --detach`. Overridable for tests.
ROMP_BIN = os.environ.get("ROMP_BIN") or str(Path(__file__).resolve().parent / "romp")

POLL = int(os.environ.get("ROMP_POSTAL_POLL", "30"))        # autostop poll interval (seconds)
IDLE_GRACE = int(os.environ.get("ROMP_POSTAL_IDLE_GRACE", "2"))  # empty polls before the bus exits
HEARTBEAT_TTL = int(os.environ.get("ROMP_POSTAL_HEARTBEAT_TTL", "90"))  # remote-presence window after a heartbeat
WINDOW = 30        # loop-guard rolling window (seconds)
MAX = 6            # loop-guard: max auto-deliveries per window before pausing
RETRY_INTERVAL = int(os.environ.get("ROMP_POSTAL_RETRY", "5"))  # re-attempt deferred deliveries every N s
PICKER_GRACE = int(os.environ.get("ROMP_POSTAL_PICKER_GRACE", "10"))  # secs to wait for a revive to reach a real state before declaring it picker-blocked
BADGE_TTL = int(os.environ.get("ROMP_POSTAL_BADGE_TTL", "300"))  # auto-clear the status-bar mail badge after N s
PEER_CAP = 10         # max peers kept on the status-bar "talking to" line (oldest dropped)
ORPHAN_GRACE = int(os.environ.get("ROMP_POSTAL_ORPHAN_GRACE", "900"))  # bounce unread mail to a dead recipient after N s

REPLY_HINT = ('To reply (only if you have something substantive to add, not just to '
              'acknowledge): romp --mail send <name> "<text>" — lead with ASK:/Q:/FYI: '
              'and put the whole point in your first sentence.')

# ───────────────────────── tmux helpers ─────────────────────────

_TMUX = None
def tmux_bin():
    global _TMUX
    if _TMUX:
        return _TMUX
    import shutil
    for c in ("tmux", "/opt/homebrew/bin/tmux", "/usr/local/bin/tmux", "/usr/bin/tmux", "/bin/tmux"):
        p = shutil.which(c) if "/" not in c else (c if os.path.exists(c) else None)
        if p:
            _TMUX = p
            return p
    _TMUX = "tmux"
    return _TMUX

def tmux(*args):
    try:
        r = subprocess.run([tmux_bin(), *args], capture_output=True, text=True, timeout=5)
        return r.stdout
    except Exception:
        return ""

def my_name():
    return tmux("display-message", "-p", "#S").strip() or None

def my_id():
    name = my_name()
    if not name:
        return None
    return tmux("show", "-t", name, "-v", "@romp-session-id").strip() or None

# ───────────────────────── maildir store ─────────────────────────

def _iso_now():
    return datetime.now().astimezone().strftime("%Y-%m-%dT%H:%M:%S%z")

_SAFE_ID_RE = re.compile(r"^[A-Za-z0-9][A-Za-z0-9._-]*$")

def _safe_id(s):
    """True iff `s` is safe as a single path component under the mail/names roots.
    Blocks path traversal (`..`, `/`, `\\`, NUL, leading dot, absolute paths) in
    any id/name that arrives over the (unauthenticated) bus. Session ids are
    UUIDs and names are sanitized to [A-Za-z0-9_-] at creation, so both match;
    anything else is a crafted reference (e.g. `../../../etc`) and is rejected."""
    if not s or len(s) > 128:
        return False
    if "/" in s or "\\" in s or "\x00" in s or s.startswith("."):
        return False
    return bool(_SAFE_ID_RE.match(s))

def _mailbox(sid):
    if not _safe_id(sid):
        raise ValueError("unsafe session id")
    mb = MAILROOT / sid
    for d in ("tmp", "new", "cur"):
        (mb / d).mkdir(parents=True, exist_ok=True)
    return mb

def _unique():
    host = socket.gethostname().split(".")[0] or "host"
    return f"{int(time.time())}.{os.getpid()}_{random.randint(0, 99999)}.{host}"

def _mark_pending(sid):
    """Reconcile the on-disk pending-mail marker with reality: mail-pending/<sid>
    exists IFF that session has unread mail in new/. Call after ANY mutation of a
    new/ box (deliver, consuming read_box, recall, sweep). On-disk and tmux-free,
    so it's the ONE fact every view can agree on — including DEAD sessions (no tmux
    vars) and across a bus restart. Self-correcting + idempotent; never raises."""
    if not sid:
        return
    m = MAILPENDING / sid
    newd = MAILROOT / sid / "new"
    try:
        has = newd.is_dir() and any(newd.iterdir())
    except Exception:
        has = False
    try:
        if has:
            MAILPENDING.mkdir(parents=True, exist_ok=True)
            m.touch()
        elif m.exists():
            m.unlink()
    except Exception:
        pass

def _tl_append(fname, obj):
    """Append one JSON line to a timeline log (best-effort; never raises)."""
    try:
        TLDIR.mkdir(parents=True, exist_ok=True)
        with open(TLDIR / fname, "a") as fh:
            fh.write(json.dumps(obj) + "\n")
    except Exception:
        pass

def deliver(to_id, from_name, from_id, body, park=False):
    # park=True marks a HANDOFF parked for a session that's currently dead. The
    # maildir is keyed by the session UUID (which `romp --resume` reuses), so the
    # message simply waits on disk until that session is revived — delivered then,
    # ignored forever if it never returns. Parked mail is also exempt from the
    # orphan sweep (see _sweep_orphans), so it persists indefinitely.
    mb = _mailbox(to_id)
    name = _unique()
    tmp = mb / "tmp" / name
    hdr = "From: %s\nFrom-Id: %s\nDate: %s\n" % (from_name, from_id, _iso_now())
    if park:
        hdr += "X-Park: 1\n"
    tmp.write_text(hdr + "\n" + body + "\n")
    tmp.rename(mb / "new" / name)   # atomic within the same filesystem
    _mark_pending(to_id)            # new/ is now non-empty -> raise the marker (covers park + live)
    # Timeline log: a message was SENT (the matching exec event is logged when
    # the recipient consumes it in read_box). id = maildir filename joins the two.
    ev = {"t": int(time.time()), "ev": "sent", "id": name,
          "from": from_name, "from_id": from_id, "to_id": to_id, "body": body}
    if park:
        ev["park"] = True
    _tl_append("messages.jsonl", ev)
    return name   # the message id (maildir filename); joins to the log + status-bar prefix

def read_box(sid, consume):
    if not _safe_id(sid):            # reject traversal in the id from /inbox, /drain
        return []
    mb = MAILROOT / sid
    newd = mb / "new"
    if not newd.is_dir():
        return []
    if consume:
        (mb / "cur").mkdir(parents=True, exist_ok=True)
    out = []
    for f in sorted(newd.iterdir(), key=lambda p: p.name):   # oldest first
        if not f.is_file():
            continue
        text = f.read_text(errors="replace")
        head, _, body = text.partition("\n\n")
        meta = {}
        for line in head.splitlines():
            k, _, v = line.partition(": ")
            meta[k.lower()] = v
        out.append({"from": meta.get("from", "?"), "from_id": meta.get("from-id", ""),
                    "date": meta.get("date", ""), "body": body.rstrip("\n"), "id": f.name,
                    "park": bool(meta.get("x-park"))})
        if consume:
            f.rename(mb / "cur" / f.name)
            _tl_append("messages.jsonl", {"t": int(time.time()), "ev": "exec", "id": f.name})
    if consume:
        _mark_pending(sid)         # cleared the box -> drop the marker (no-op if more arrived)
    return out

# ───────────────────────── formatting (shared) ─────────────────────────
#
# CONSUMER CONTRACT (stable — don't break without pinging dependents, e.g. vs_app2's
# romp-chat-view). Two machine-readable parts are relied on; keep them stable:
#   1. The `<!-- romp-msg-id: <id> -->` HTML-comment marker emitted after each
#      message body by format_inbox + format_push — <id> joins to messages.jsonl.
#   2. The messages.jsonl "sent" event schema written by deliver():
#      {ev:"sent", id, from, from_id, to_id, body, t, park?}  (park is additive).
# The HUMAN-FACING prose (banner text, headers, the "⏸ parked" tag, REPLY_HINT) is
# NOT a contract — consumers must not parse it, so it stays free to change.

def format_inbox(msgs):
    if not msgs:
        return ""
    out = ["\U0001F4EC New message(s) from your romp peers:"]
    for m in msgs:
        d = " (%s)" % m["date"] if m.get("date") else ""
        pk = "  ⏸ parked while you were offline — may be stale" if m.get("park") else ""
        mid = ("\n<!-- romp-msg-id: %s -->" % m["id"]) if m.get("id") else ""   # exact id for the timeline join
        out.append("\n— from %s%s%s:\n%s%s" % (m.get("from", "?"), d, pk, m.get("body", ""), mid))
    out.append("\n" + REPLY_HINT)
    return "\n".join(out)

def format_agents(agents, me):
    if not agents:
        return "(no live romp sessions)"
    lines = []
    for a in agents:
        tag = " (you)" if a["name"] == me else (" [remote]" if a.get("remote") else "")
        br = ("  [%s]" % a["branch"]) if a.get("branch") else ""
        wk = ("  — %s" % a["working"]) if a.get("working") else ""
        lines.append("  %s%s%s%s" % (a["name"], tag, br, wk))
    return "\n".join(lines)

def _hhmm_epoch(t):
    try: return datetime.fromtimestamp(int(t)).strftime("%H:%M")
    except Exception: return "?"

def format_receipts(recs):
    if not recs:
        return "No messages sent yet."
    out = ["Your recent sent messages:"]
    for r in recs[-15:]:
        if r.get("exec"):
            st = "read %s" % _hhmm_epoch(r["exec"])
        elif r.get("recalled"):
            st = "recalled %s" % _hhmm_epoch(r["recalled"])
        else:                                  # still unread -> recallable; show the id to target it
            st = "pending (not read yet) · id %s" % r.get("id", "?")
        out.append("  → %-18s sent %s · %s" % (r.get("to", "?"), _hhmm_epoch(r["sent"]), st))
    return "\n".join(out)

# ───────────────────────── the bus (server) ─────────────────────────

HEARTBEATS = {}        # id -> (name, last_seen_epoch)   (remote presence)
STREAKS = {}           # id -> (count, last_epoch)        (loop guard)
_lock = threading.Lock()

def local_agents():
    out = tmux("list-sessions", "-F",
               "#{@romp}|#{session_name}|#{@romp-session-id}|#{@romp-working}|#{@claude-dir}")
    res = []
    for line in out.splitlines():
        p = line.split("|")
        if len(p) >= 3 and p[0] == "1" and p[2]:
            res.append({"name": p[1], "id": p[2], "remote": False,
                        "working": p[3] if len(p) > 3 else "",
                        "dir": p[4] if len(p) > 4 else ""})
    return res

def all_agents():
    agents = local_agents()
    local_ids = {a["id"] for a in agents}
    now = time.time()
    for sid, (name, ts) in list(HEARTBEATS.items()):
        if now - ts < HEARTBEAT_TTL and sid not in local_ids:
            agents.append({"name": name, "id": sid, "remote": True})
    return agents

def present_count():
    return len(all_agents())

def _git_branch(d):
    """Current git branch of a dir (for the agent list — same-branch is what makes
    file overlap a real collision). '' if not a repo / on error."""
    if not d:
        return ""
    try:
        r = subprocess.run(["git", "-C", d, "rev-parse", "--abbrev-ref", "HEAD"],
                           capture_output=True, text=True, timeout=3)
        return r.stdout.strip() if r.returncode == 0 else ""
    except Exception:
        return ""

def _name_for_id(sid):
    if not sid:
        return "?"
    for a in local_agents():
        if a["id"] == sid:
            return a["name"]
    try:
        return (NAMES_DIR / sid).read_text().split("\t")[0].strip() or sid[:8]
    except Exception:
        return sid[:8]

def _dead_id_for_name(name):
    """Resolve a peer NAME that is NOT currently live to the session UUID of the
    most recent past session that used it — from the persistent names/ records,
    which outlive the session. Returns None if no session ever had that name, so a
    genuine typo still fails loudly (404) instead of parking into the void; a name
    that really existed parks a handoff for whenever it's revived. (Live names are
    handled by the normal /send path and never reach here.)"""
    if not name or not NAMES_DIR.is_dir():
        return None
    live_ids = {a["id"] for a in local_agents()}
    cands = []
    for f in NAMES_DIR.iterdir():
        if not f.is_file() or f.name in live_ids:
            continue
        try:
            if f.read_text().split("\t")[0].strip() != name:
                continue
            mtime = f.stat().st_mtime
        except Exception:
            continue
        # Prefer a candidate that still has a mailbox (a handoff mid-flight), then
        # the most recently seen session by that name.
        cands.append(((MAILROOT / f.name).is_dir(), mtime, f.name))
    if not cands:
        return None
    cands.sort(reverse=True)
    return cands[0][2]

def _recip_id_for(to):
    """A recipient reference (live name, UUID, or dead name) -> session UUID, or None."""
    for a in all_agents():
        if a["name"] == to:
            return a["id"]
    if _safe_id(to) and ((MAILROOT / to).is_dir() or (NAMES_DIR / to).is_file()):  # already an id
        return to
    return _dead_id_for_name(to)

def _recall(from_id, to, mid):
    """Unsend UNREAD mail: delete messages still sitting in a recipient's `new/`
    (queued or parked) that were sent BY from_id. With `to`, scope to that one
    recipient; with `mid` (and no `to`), find it across mailboxes; both narrows to
    one message. Only the original sender's own messages are touched. Already-read
    mail has left `new/` and can't be recalled. Returns [{to, id, body}] removed."""
    if not from_id:
        return []
    if to:
        rid = _recip_id_for(to)
        boxes = [rid] if rid else []
    elif MAILROOT.is_dir():
        boxes = [b.name for b in MAILROOT.iterdir() if b.is_dir()]
    else:
        boxes = []
    removed = []
    for rid in boxes:
        newd = MAILROOT / rid / "new"
        if not newd.is_dir():
            continue
        for f in list(newd.iterdir()):
            if not f.is_file() or (mid and f.name != mid):
                continue
            try:
                text = f.read_text(errors="replace")
            except Exception:
                continue
            meta = {}
            head, _, body = text.partition("\n\n")
            for ln in head.splitlines():
                k, _, v = ln.partition(": "); meta[k.lower()] = v
            if meta.get("from-id", "") != from_id:    # only the sender can recall their own
                continue
            try:
                f.unlink()
            except Exception:
                continue
            removed.append({"to": _name_for_id(rid), "id": f.name, "body": " ".join(body.split())[:120]})
            _tl_append("messages.jsonl", {"t": int(time.time()), "ev": "recall", "id": f.name})
        _mark_pending(rid)         # recall may have emptied new/ -> reconcile the marker
    return removed

# ───────────────────── session discovery + revival ─────────────────────
# Every past/present romp session leaves a persistent trail on disk: names/<sid>
# (name, dir, identity colour) and summaries/<sid>.jsonl (per-turn Haiku
# request/reply summaries — what it asked + what it did). That's a searchable
# index of expertise: a live session can find a DEAD session that worked on a
# relevant problem and REVIVE it (`romp <name> --resume <uuid> --detach`).

def _session_records():
    """Join names/ + summaries/ into one record per session:
       {id, name, dir, alive, last, summaries:[{t,kind,text}]}, newest first.
       last = most recent summary epoch, else the file mtime."""
    live = {a["id"]: a for a in local_agents()}
    ids = set()
    if NAMES_DIR.is_dir():
        ids |= {f.name for f in NAMES_DIR.iterdir() if f.is_file()}
    if SUMMARIES_DIR.is_dir():
        ids |= {f.stem for f in SUMMARIES_DIR.iterdir() if f.suffix == ".jsonl"}
    out = []
    for sid in ids:
        name, d = sid[:8], ""
        nf = NAMES_DIR / sid
        if nf.is_file():
            try:
                p = nf.read_text().split("\t")
                name = p[0].strip() or name
                d = p[1].strip() if len(p) > 1 else ""
            except Exception:
                pass
        if sid in live:                       # a live session's name/dir may be newer than the record
            name = live[sid].get("name", name)
            d = live[sid].get("dir", "") or d
        sums, last = [], 0
        sf = SUMMARIES_DIR / (sid + ".jsonl")
        if sf.is_file():
            for ln in sf.read_text(errors="replace").splitlines():
                try: e = json.loads(ln)
                except Exception: continue
                t = int(e.get("t", 0))
                sums.append({"t": t, "kind": e.get("kind", ""), "text": e.get("text", "")})
                last = max(last, t)
        if not last:
            try: last = int((sf if sf.is_file() else nf).stat().st_mtime)
            except Exception: last = 0
        out.append({"id": sid, "name": name, "dir": d, "alive": sid in live,
                    "last": last, "summaries": sums})
    out.sort(key=lambda s: s["last"], reverse=True)
    return out

def _rel_age(t):
    if not t: return "?"
    s = max(0, int(time.time()) - int(t))
    if s < 90:  return "%ds ago" % s
    m = s // 60
    if m < 90:  return "%dm ago" % m
    h = m // 60
    if h < 36:  return "%dh ago" % h
    return "%dd ago" % (h // 24)

def _find_sessions(query, limit=12):
    """Rank sessions by how well name/dir/summaries match the query tokens (empty
    query -> most recent). Returns (ranked records [each + 'snips'], fell_back)."""
    recs = _session_records()
    toks = [w for w in re.split(r"\s+", (query or "").lower().strip()) if w]
    fell_back = False
    if toks:
        def score(r):
            hay = (r["name"] + " " + r["dir"] + " " +
                   " ".join(s["text"] for s in r["summaries"])).lower()
            return sum(hay.count(t) for t in toks)
        hits = [(score(r), r) for r in recs]
        hits = [(sc, r) for sc, r in hits if sc > 0]
        if hits:
            hits.sort(key=lambda x: (x[0], x[1]["last"]), reverse=True)
            ranked = [r for _, r in hits[:limit]]
        else:
            ranked, fell_back = recs[:limit], True
    else:
        ranked = recs[:limit]
    for r in ranked:                          # attach the most relevant snippet lines
        snips = [s for s in r["summaries"] if any(t in s["text"].lower() for t in toks)] if toks else []
        if not snips:
            snips = r["summaries"][-3:]        # fall back to the latest few
        r["snips"] = snips[-4:]
    return ranked, fell_back

def format_find(ranked, query, fell_back, me_id=None):
    if not ranked:
        return "No past romp sessions on record."
    if fell_back:
        head = 'No session summaries matched "%s" — showing the most recent instead:' % query
    elif query:
        head = 'Past & present romp sessions matching "%s":' % query
    else:
        head = "Recent romp sessions:"
    out = [head, ""]
    for r in ranked:
        dot = "●" if r["alive"] else "○"   # ● alive / ○ dead
        st = "ALIVE" if r["alive"] else "dead"
        you = " (you)" if me_id and r["id"] == me_id else ""
        dirb = os.path.basename(r["dir"]) if r["dir"] else "?"
        out.append("%s %s%s  [%s]  %s · last active %s  ·  %s"
                   % (dot, r["name"], you, dirb, st, _rel_age(r["last"]), r["id"][:8]))
        for s in r.get("snips", []):
            verb = {"request": "asked", "reply": "did"}.get(s["kind"], s["kind"] or "—")
            out.append("    - %s: %s" % (verb, s["text"]))
    out += ["", '(to wake one: revive_session("<name>")  ·  romp --mail revive <name>)']
    return "\n".join(out)

def _resolve_session(name_or_id):
    """name_or_id -> (sid, name, dir, alive). Accepts a live name, a UUID we have a
    record for, or a dead name (most recent past session by that name). (None,...)
    if nothing matches."""
    x = (name_or_id or "").strip()
    if not x:
        return None, None, None, False
    la = local_agents()
    by_name = {a["name"]: a for a in la}
    if x in by_name:                          # a live session by that name -> already running
        a = by_name[x]
        return a["id"], a["name"], a.get("dir", ""), True
    # `x` is used as a path component below; reject traversal so a crafted
    # revive target (e.g. `../../../etc/hosts`) can't read an arbitrary file or
    # feed attacker-chosen contents into the spawn.
    if not _safe_id(x):
        return None, None, None, False
    if (NAMES_DIR / x).is_file() or (SUMMARIES_DIR / (x + ".jsonl")).is_file():
        sid = x
    else:
        sid = _dead_id_for_name(x)
    if not sid:
        return None, None, None, False
    name, d = sid[:8], ""
    nf = NAMES_DIR / sid
    if nf.is_file():
        try:
            p = nf.read_text().split("\t"); name = p[0].strip() or name
            d = p[1].strip() if len(p) > 1 else ""
        except Exception:
            pass
    return sid, name, d, sid in {a["id"] for a in la}

def _revive(name_or_id):
    """Spawn `romp <name> --resume <uuid> --detach` in the session's recorded dir
    (so claude --resume finds the transcript). Returns
    (ok, sid, name, already_alive, detail)."""
    sid, name, d, alive = _resolve_session(name_or_id)
    if not sid:
        return False, None, name_or_id, False, "no live or past romp session named '%s'" % name_or_id
    if alive:
        return True, sid, name, True, "already running"
    if not os.path.exists(ROMP_BIN):
        return False, sid, name, False, "romp launcher not found at %s" % ROMP_BIN
    workdir = d if d and os.path.isdir(d) else str(Path.home())
    try:
        r = subprocess.run([ROMP_BIN, name, "--resume", sid, "--detach"],
                           cwd=workdir, capture_output=True, text=True, timeout=30)
    except Exception as e:
        return False, sid, name, False, "revive failed: %s" % e
    if r.returncode != 0:
        return False, sid, name, False, (r.stderr or r.stdout or "romp exited %d" % r.returncode).strip()
    return True, sid, name, False, (r.stdout or "").strip()

def _sent_receipts(mid):
    """[{to, id, sent, exec, recalled}] for messages SENT by `mid`, joined by id,
    oldest first. exec is None until the recipient reads it; recalled is set if the
    sender later unsent it (so it shows 'recalled', not a permanent 'pending')."""
    log = TLDIR / "messages.jsonl"
    if not mid or not log.exists():
        return []
    sent, execs, recalls = {}, {}, {}
    for line in log.read_text(errors="replace").splitlines():
        try: e = json.loads(line)
        except Exception: continue
        ev = e.get("ev")
        if ev == "sent" and e.get("from_id") == mid:
            sent[e["id"]] = e
        elif ev == "exec":
            execs[e["id"]] = e["t"]
        elif ev == "recall":
            recalls[e["id"]] = e["t"]
    out = [{"to": _name_for_id(e.get("to_id", "")), "id": i, "sent": e["t"],
            "exec": execs.get(i), "recalled": recalls.get(i)}
           for i, e in sent.items()]
    return sorted(out, key=lambda r: r["sent"])

def _drain(sid):
    # Loop guard: cap rapid auto-deliveries so two chatty agents can't volley
    # forever. Over the cap -> pause (don't consume); after a quiet window the
    # streak resets and delivery resumes.
    with _lock:
        peek = read_box(sid, consume=False)
        if not peek:
            return {"messages": [], "paused": False}
        now = time.time()
        count, last = STREAKS.get(sid, (0, 0))
        count = count + 1 if now - last <= WINDOW else 1
        if count > MAX:
            return {"messages": [], "paused": True}
        STREAKS[sid] = (count, now)
        return {"messages": read_box(sid, consume=True), "paused": False}

# ───────────────────────── push-on-deliver (auto-wake) ─────────────────────────
# When mail lands for a LOCAL romp session that's sitting idle, type it straight
# into that session's prompt and submit it, so the recipient wakes immediately
# instead of waiting for its next Stop-hook drain. The drain stays as the
# backstop: whenever live injection isn't safe (a remote session, a permission
# prompt, a draft we can't preserve, Claude mid-turn with a draft), we DON'T
# inject — the message stays in the mailbox and the drain delivers it at the next
# turn boundary, exactly as before. Disable with ~/.claude/romp-postal-nopush
# (or romp-postal-off, which also disables the drain).
#
# Everything we know about Claude Code's prompt box (verified empirically against
# v2.1.x), which this relies on:
#   • multi-line text pasted via `paste-buffer -p` (bracketed paste) lands in the
#     box WITHOUT submitting; a separate Enter submits it;
#   • Ctrl+S is a stash TOGGLE — stashes+clears a draft, restores it when empty —
#     so we save/restore the user's draft with perfect fidelity and no parsing;
#   • a ghost auto-suggestion is rendered DIM (\e[2m); a real draft is not — so we
#     tell them apart from the colour codes in `capture-pane -e`;
#   • the "› stashed" indicator means a draft is already stashed (don't clobber it);
#   • after Enter, the box clears asynchronously — poll for it before unstashing.

PROMPT_GLYPH = "❯"                          # ❯
PUSH_SENTINEL = "#" * 44                          # banner rule; used to detect paste/submit
_SGR_RE = re.compile(r"\x1b\[[0-9;]*m")           # any SGR colour code
_DIM_RE = re.compile(r"\x1b\[2m.*?(?:\x1b\[(?:0|22)m|$)")   # a dim (ghost-suggestion) span
_RULE_RE = re.compile("─{10,}")              # the box's ─────… borders

def _push_disabled():
    h = Path.home() / ".claude"
    return (h / "romp-postal-off").exists() or (h / "romp-postal-nopush").exists()

def _identity(sid):
    """(hex-bg, fg) identity colour of a session id, from the names registry."""
    try:
        parts = (NAMES_DIR / sid).read_text().rstrip("\n").split("\t")
        if len(parts) >= 4:
            return parts[2], parts[3]
    except Exception:
        pass
    return "", ""

def _expire_badge(name, token):
    time.sleep(BADGE_TTL)
    try:
        if tmux("show", "-t", name, "-v", "@romp-mail-token").strip() == token:
            for v in ("@romp-mail-from", "@romp-mail-bg", "@romp-mail-fg", "@romp-mail-token"):
                tmux("set", "-t", name, v, "")        # empty -> badge hidden
            tmux("refresh-client", "-S")
    except Exception:
        pass

def _set_mail_badge(name, from_name, from_id):
    """Paint a sender-coloured "📬 from X" segment into the recipient's tmux status
    bar (the bar's identity colour stays; only this segment takes the sender's
    colour). Cleared when the user looks at the session (the client-session-changed
    hook in tmux.conf) or, as a backstop, after BADGE_TTL."""
    bg, fg = _identity(from_id)
    if not bg:
        bg, fg = "#888888", "white"                  # unknown sender -> neutral grey
    token = str(int(time.time() * 1000))
    try:
        tmux("set", "-t", name, "@romp-mail-from", from_name or "?")
        tmux("set", "-t", name, "@romp-mail-bg", bg)
        tmux("set", "-t", name, "@romp-mail-fg", fg or "white")
        tmux("set", "-t", name, "@romp-mail-token", token)
        tmux("refresh-client", "-S")
    except Exception as e:
        _log("badge set failed for %s: %s" % (name, e))
        return
    threading.Thread(target=_expire_badge, args=(name, token), daemon=True).start()

def _peer_get(sess):
    """Current peer chips of a session as [(id, name, bg, fg)] (oldest first).
    Chips are keyed by the stable session id so a rename can't duplicate or strand
    them; the name is just the display label (refreshed by _reconcile_peers)."""
    fmt = "|".join("#{@romp-peer%d-id}\t#{@romp-peer%d}\t#{@romp-peer%dc}\t#{@romp-peer%df}" % (i, i, i, i)
                   for i in range(1, PEER_CAP + 1))
    out = tmux("display-message", "-t", sess, "-p", fmt)
    res = []
    for part in out.rstrip("\n").split("|"):
        f = (part.split("\t") + ["", "", ""])[:4]
        if f[1].strip():
            res.append((f[0].strip(), f[1].strip(), f[2].strip(), f[3].strip()))
    return res

def _peer_write(sess, chips):
    """Write the chip list [(id,name,bg,fg)] (oldest→newest) into the slots and set
    the status to 2 lines (or back to one when empty). One batched tmux call."""
    cmds = ["set", "-t", sess, "status", "2" if chips else "on"]   # "on" = 1 line
    for i in range(1, PEER_CAP + 1):
        pid, nm, cl, fgc = chips[i-1] if i <= len(chips) else ("", "", "", "")
        cmds += [";", "set", "-t", sess, "@romp-peer%d-id" % i, pid,
                 ";", "set", "-t", sess, "@romp-peer%d" % i, nm,
                 ";", "set", "-t", sess, "@romp-peer%dc" % i, cl,
                 ";", "set", "-t", sess, "@romp-peer%df" % i, fgc]
    tmux(*cmds)

def _update_peers(sess, peer_id, peer_name, color, fg):
    """Record peer (by id) as a correspondent of `sess` — newest at the END, deduped
    by id, capped at PEER_CAP."""
    if not sess or not peer_id or not peer_name:
        return
    try:
        chips = [t for t in _peer_get(sess) if t[0] != peer_id]
        chips.append((peer_id, peer_name, color or "#888888", fg or "white"))
        _peer_write(sess, chips[-PEER_CAP:])
    except Exception as e:
        _log("peers update failed for %s: %s" % (sess, e))

def _peers_update(recip, recip_id, sender, sender_id):
    """Both ends of a delivery learn of each other (by id + name + identity bg/fg)."""
    sb, sf = _identity(sender_id)
    rb, rf = _identity(recip_id)
    _update_peers(recip, sender_id, sender, sb, sf)
    _update_peers(sender, recip_id, recip, rb, rf)

def _set_msg_prefix(sess, arrow, peer, bg, fg, body, mid):
    """Set the top-line message indicator on a session: a pill "<arrow> <peer>" in
    the PEER's colour (@romp-msg-bg/-fg) followed by the MESSAGE's own text
    (@romp-msg-summary) — NOT @claude-summary, which is the session's own unrelated
    work. @romp-msg-id-cur stashes the message id so the timeline daemon can later
    swap in its Haiku summary (only while the id still matches). Cleared by the
    tmux-status hook on the next non-message prompt."""
    if not sess or not peer:
        return
    s = " ".join((body or "").split())[:120]
    try:
        tmux("set", "-t", sess, "@romp-msg-dir", arrow,
             ";", "set", "-t", sess, "@romp-msg-peer", peer,
             ";", "set", "-t", sess, "@romp-msg-bg", bg or "#888888",
             ";", "set", "-t", sess, "@romp-msg-fg", fg or "white",
             ";", "set", "-t", sess, "@romp-msg-summary", s,
             ";", "set", "-t", sess, "@romp-msg-id-cur", mid or "",
             ";", "refresh-client", "-S")
    except Exception as e:
        _log("msg-prefix set failed for %s: %s" % (sess, e))

def _on_deliver(recip, recip_id, sender, sender_id, body, mid):
    """Off-thread side-effects of a delivery: update both 'talking to' lines and
    the top-line message indicator on each end (a pill in the OTHER end's colour
    + the message body; @romp-msg-id-cur = mid for the Haiku swap-in)."""
    sb, sf = _identity(sender_id)
    rb, rf = _identity(recip_id)
    _peers_update(recip, recip_id, sender, sender_id)
    _set_msg_prefix(recip, "←", sender, sb, sf, body, mid)   # receiver: ← from sender (sender's colour)
    _set_msg_prefix(sender, "→", recip, rb, rf, body, mid)   # sender:   → to recipient (its colour)

def _reconcile_peers():
    """Run by the tmux session-closed AND after-rename hooks. On every live
    session: drop chips whose peer id is no longer live (a killed session's chip
    vanishes), and refresh each surviving chip's display name from that id's
    CURRENT name (a renamed session updates everyone's chip). Also drops a stale
    top-line "←/→ peer:" prefix whose name is no longer live."""
    agents = local_agents()
    name_of = {a["id"]: a["name"] for a in agents if a["id"]}
    live_names = set(name_of.values())
    for name in live_names:
        cur = _peer_get(name)
        new = [(pid, name_of[pid], c, f) for (pid, nm, c, f) in cur if pid in name_of]
        mp = tmux("show", "-t", name, "-v", "@romp-msg-peer").strip()
        drop_mp = bool(mp) and mp not in live_names
        if new == cur and not drop_mp:
            continue
        try:
            _peer_write(name, new)
            if drop_mp:
                tmux("set", "-t", name, "@romp-msg-dir", "", ";", "set", "-t", name, "@romp-msg-peer", "",
                     ";", "set", "-t", name, "@romp-msg-id-cur", "")
        except Exception as e:
            _log("reconcile failed for %s: %s" % (name, e))

def _sweep_orphans():
    """Bounce mail stuck UNREAD in a DEAD recipient's mailbox back to its (live)
    sender — "↩ UNDELIVERED …" — so the sender learns it never landed and can
    resend/route, then drop the orphaned copy. Only messages older than
    ORPHAN_GRACE are touched, so a session that closes and resumes (same id) within
    the grace still gets its mail. Run periodically by the bus monitor."""
    if not MAILROOT.is_dir():
        return
    live = local_agents()
    if not live:                                       # tmux hiccup, not "everyone died" — don't mass-bounce
        return
    live_ids = {a["id"] for a in live}
    by_name = {a["name"]: a for a in live}
    now = time.time()
    for box in MAILROOT.iterdir():
        if not box.is_dir() or box.name in live_ids:   # live recipient -> not orphaned
            continue
        newd = box / "new"
        if not newd.is_dir():
            continue
        recip = _name_for_id(box.name)
        for f in list(newd.iterdir()):
            if not f.is_file():
                continue
            try:
                text = f.read_text(errors="replace")
            except Exception:
                continue
            meta = {}
            head, _, body = text.partition("\n\n")
            for ln in head.splitlines():
                k, _, v = ln.partition(": "); meta[k.lower()] = v
            if meta.get("x-park"):                           # deliberate handoff -> lives until revival; never bounce/expire
                continue
            try:
                if now - f.stat().st_mtime < ORPHAN_GRACE:   # fresh -> let a resume claim it
                    continue
            except Exception:
                continue
            s = by_name.get(meta.get("from", ""))
            if s:                                      # bounce to the live sender + wake it
                bounce = ("↩ UNDELIVERED — your message to '%s' was never read; that session "
                          "has exited. Resend or route elsewhere.\nOriginal: %s"
                          % (recip, " ".join(body.split())[:160]))
                try:
                    deliver(s["id"], "Romp Postal Service", "", bounce)
                    threading.Thread(target=_push, args=(s["name"], s["id"], False), daemon=True).start()
                except Exception as e:
                    _log("bounce to %s failed: %s" % (s["name"], e))
            try:
                f.unlink()
            except Exception:
                pass
        _mark_pending(box.name)                         # bounced orphans may have emptied new/
        try:                                            # tidy: drop the mailbox if nothing's left
            if all(not any((box / d).iterdir()) for d in ("new", "cur", "tmp") if (box / d).is_dir()):
                shutil.rmtree(box, ignore_errors=True)
        except Exception:
            pass

def _capture(name):
    return tmux("capture-pane", "-t", name, "-p", "-e")

def _box_region(cap):
    """The raw lines that make up the prompt box (between its last two ─── rules),
    or None if the box can't be located — in which case the caller should NOT
    inject, since it can't tell whether a draft is present."""
    lines = cap.split("\n")
    rules = [i for i, l in enumerate(lines) if _RULE_RE.search(l)]
    if len(rules) < 2:
        return None
    return lines[rules[-2] + 1:rules[-1]]

def _is_prompt_box(cap):
    """True ONLY when the box between the last two ─── rules is the live Claude
    INPUT prompt — identified by the ❯ glyph on its input line. A resume/loading
    screen and Claude's session PICKER also draw rule-bordered, box-shaped regions,
    but none carries the ❯ input prompt. Without this positive check, _push would
    treat such a screen as a prompt, _drain (consume) the mail, and paste it into a
    dead screen where the keystrokes vanish — losing the message. When this is
    False we bail and leave the mail in `new` for the Stop-hook drain or the
    SessionStart revive hook to deliver once Claude is actually back."""
    region = _box_region(cap)
    if region is None:
        return False
    return any(PROMPT_GLYPH in l for l in region)

_NORMAL_STATES = ("waiting", "working", "idle", "permission")  # any real @claude-state -> past the picker
# Claude's resume picker option labels, verbatim from the installed CLI (v2.1.170,
# per feed_design). Tiered match: STRICT (these literals) first for false-positive
# resistance; LOOSE (/summ/) as a fallback so a label change on a CLI update still
# fires instead of going blind. The matched tier is recorded so drift is visible.
_PICKER_STRICT = ("resume from summary", "resume full session as-is")
_PICKER_LOOSE = re.compile(r"summ", re.I)   # the picker is the only pre-prompt screen offering a "summary"

def _picker_tier(cap):
    """Which tier matched Claude's resume picker, or None. STRICT (exact labels) wins
    over LOOSE (/summ/ fallback). Returned tier is logged so we can tell when the
    strict labels stop matching (a CLI version drifted the wording)."""
    txt = _SGR_RE.sub("", cap or "")
    low = txt.lower()
    if any(s in low for s in _PICKER_STRICT):
        return "strict"
    if _PICKER_LOOSE.search(txt):
        return "loose"
    return None

def _box_text(cap):
    """The current prompt-box contents with ghost-suggestions and colour codes
    stripped — '' means the box is empty (ready for injection)."""
    region = _box_region(cap)
    if region is None:
        return ""
    out = []
    for raw in region:
        seg = raw.split(PROMPT_GLYPH, 1)[1] if PROMPT_GLYPH in raw else raw
        seg = _DIM_RE.sub("", seg)        # drop dim ghost-suggestion spans
        seg = _SGR_RE.sub("", seg)        # drop remaining colour codes
        out.append(seg)
    return "\n".join(out).strip()

def _is_stashed(cap):
    return "stashed" in _SGR_RE.sub("", cap)

def _wait(pred, timeout, interval=0.12):
    waited = 0.0
    while waited < timeout:
        if pred():
            return True
        time.sleep(interval)
        waited += interval
    return pred()

def _hhmm(iso):
    # _iso_now() -> "2026-06-05T14:23:45-0700"; pull HH:MM, else fall back to now.
    if iso and len(iso) >= 16 and iso[10:11] == "T":
        return iso[11:16]
    return datetime.now().astimezone().strftime("%H:%M")

def format_push(msgs):
    bar = PUSH_SENTINEL
    out = []
    for m in msgs:
        pk = " · ⏸ parked (you were offline)" if m.get("park") else ""
        head = "## \U0001F4EC from %s · %s%s" % (m.get("from", "?"), _hhmm(m.get("date", "")), pk)
        out += [bar, head, bar, m.get("body", "")]
        if m.get("id"):
            out.append("<!-- romp-msg-id: %s -->" % m["id"])   # exact id for the timeline join
        out.append(bar)
    out.append('(to reply, only if substantive: romp --mail send %s "..." — lead with ASK:/Q:/FYI:)'
               % msgs[0].get("from", ""))
    return "\n".join(out)

def _inject(name, text, has_draft):
    """Type `text` into session `name`'s prompt and submit it, preserving any
    existing draft. Raises if the paste never lands (caller restores the mail)."""
    if has_draft:                                              # stash the draft away
        tmux("send-keys", "-t", name, "C-s")
        _wait(lambda: not _box_text(_capture(name)), 1.5)
    tmux("set-buffer", "-b", "romppush", "--", text)           # bracketed paste (no submit)
    tmux("paste-buffer", "-b", "romppush", "-t", name, "-p", "-d")
    # A multi-line paste collapses to a "[Pasted text +N lines]" placeholder in the
    # box (it expands in full on submit), so "landed" just means the box is no
    # longer empty — not that the banner text itself is visible.
    if not _wait(lambda: bool(_box_text(_capture(name))), 2.0):
        if has_draft:
            tmux("send-keys", "-t", name, "C-s")              # un-stash before bailing
        raise RuntimeError("paste did not land in the prompt box")
    tmux("send-keys", "-t", name, "Enter")                     # submit (idle) / queue (working)
    if has_draft:                                             # restore once the banner clears
        if _wait(lambda: not _box_text(_capture(name)), 3.0):
            tmux("send-keys", "-t", name, "C-s")
        else:
            _log("push: box did not clear for %s; draft left safely in stash" % name)

def _push(name, sid, remote):
    """Decide whether it's safe to live-inject into `name`, then do it. Anything
    unsafe just returns — the Stop-hook drain remains the backstop."""
    if remote or _push_disabled():
        return
    try:
        state = tmux("show", "-t", name, "-v", "@claude-state").strip()
        if state not in ("waiting", "idle", "working"):
            return                                            # permission / unknown -> drain later
        # Scrolled up = the pane is in copy-mode, where a paste's Enter gets eaten
        # (stuck, unsubmitted) and capture-pane reads the scrolled view. Exit
        # copy-mode (drop to the live prompt) so the message submits immediately.
        if tmux("display-message", "-t", name, "-p", "#{pane_in_mode}").strip() == "1":
            tmux("send-keys", "-t", name, "-X", "cancel")
            _wait(lambda: tmux("display-message", "-t", name, "-p", "#{pane_in_mode}").strip() != "1", 1.0)
        cap = _capture(name)
        if not _is_prompt_box(cap):
            # Not at a ❯ prompt. If the session is IDLE and sitting on a dismissible
            # slash-command modal the user opened over the prompt (/usage, /help,
            # /config, …), press Esc once to close it and recheck — so mail pulls an
            # idle session out of the modal instead of stranding (same spirit as the
            # copy-mode cancel above). We deliberately do NOT do this when WORKING (it
            # could be an AskUserQuestion / ExitPlanMode decision mid-turn that Esc
            # would cancel), at a permission dialog (state isn't waiting/idle, already
            # returned above), or on the resume picker (left as a needs-input signal).
            # If Esc doesn't reveal a prompt (a loading screen / stale state / stubborn
            # modal), bail WITHOUT draining — the mail stays in `new` for the drain or
            # the revive hook, and the retry loop will try again.
            if state in ("waiting", "idle") and not _picker_tier(cap):
                tmux("send-keys", "-t", name, "Escape")
                _wait(lambda: bool(_is_prompt_box(_capture(name))), 1.0)
                cap = _capture(name)
            if not _is_prompt_box(cap):
                return
        has_draft = bool(_box_text(cap))
        if has_draft and (state == "working" or _is_stashed(cap)):
            return                                            # can't clear safely -> drain later
        res = _drain(sid)                                      # claim mail (guarded + consuming)
        msgs = res.get("messages", [])
        if not msgs:
            return                                            # nothing, or loop-guard paused
        try:
            _inject(name, format_push(msgs), has_draft)
        except Exception as e:                                # put the mail back for the drain
            for m in msgs:
                deliver(sid, m.get("from", "?"), m.get("from_id", ""), m.get("body", ""))
            _log("push to %s failed (%s); restored %d msg(s) for drain" % (name, e, len(msgs)))
    except Exception as e:
        _log("push error for %s: %s" % (name, e))

WAKE_TIMEOUT = int(os.environ.get("ROMP_POSTAL_WAKE_TIMEOUT", "45"))

def _wake_when_ready(sid):
    """Force-deliver pending mail to a REVIVING session once its prompt is live.

    A resumed session loads its transcript before its prompt box is interactive,
    and a SessionStart hook can only inject PASSIVE context (verified — it cannot
    force a turn), so a session revived with parked handoffs would just sit idle on
    un-acted mail. Instead we poll until the real ❯ prompt is up, then _push —
    which injects AND submits (Enter) — so the session actually takes a turn
    (waiting→working→acts→waiting) and shows WORKING in every existing view, no view
    changes needed. _push's loop guard prevents a mail-storm from spinning it. If
    the prompt never appears within WAKE_TIMEOUT (e.g. a huge transcript), the mail
    stays in new/ for the Stop-hook drain — delivered on the first turn, just not
    force-acted. Runs off the /wake handler so the revive hook returns instantly."""
    try:
        deadline = time.time() + WAKE_TIMEOUT
        while time.time() < deadline:
            newd = MAILROOT / sid / "new"
            if not (newd.is_dir() and any(newd.iterdir())):
                return                                        # nothing pending (or already delivered)
            live = {a["id"]: a["name"] for a in local_agents()}
            if sid not in live:
                return                                        # session died during load
            if _is_prompt_box(_capture(live[sid])):
                _push(live[sid], sid, False)                  # drain + inject + SUBMIT -> forces a turn
                return
            time.sleep(0.5)
    except Exception as e:
        _log("wake wait failed for %s: %s" % (sid, e))

class Handler(BaseHTTPRequestHandler):
    def log_message(self, *a):
        pass   # keep stdout/stderr clean; the bus log is for real events only

    def _send(self, obj, code=200):
        body = json.dumps(obj).encode()
        self.send_response(code)
        self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)

    def _body(self):
        n = int(self.headers.get("Content-Length", 0) or 0)
        return json.loads(self.rfile.read(n)) if n else {}

    def do_GET(self):
        u = urllib.parse.urlparse(self.path)
        q = urllib.parse.parse_qs(u.query)
        if u.path == "/ping":
            return self._send({"ok": True})
        if u.path == "/agents":
            me = (q.get("me") or [""])[0]
            agents = all_agents()
            for a in agents:                       # enrich with branch for display only
                a["branch"] = _git_branch(a.get("dir", ""))
            return self._send({"agents": agents, "me": me})
        if u.path == "/sent":
            sid = (q.get("id") or [""])[0]
            if not _safe_id(sid):
                return self._send({"error": "missing or invalid id"}, 400)
            return self._send({"sent": _sent_receipts(sid)})
        if u.path == "/inbox":
            sid = (q.get("id") or [""])[0]
            peek = (q.get("peek") or ["0"])[0] == "1"
            if not _safe_id(sid):
                return self._send({"error": "missing or invalid id"}, 400)
            return self._send({"messages": read_box(sid, consume=not peek)})
        if u.path == "/drain":
            sid = (q.get("id") or [""])[0]
            if not _safe_id(sid):
                return self._send({"error": "missing or invalid id"}, 400)
            return self._send(_drain(sid))
        self._send({"error": "not found"}, 404)

    def do_POST(self):
        u = urllib.parse.urlparse(self.path)
        try:
            data = self._body()
        except Exception:
            return self._send({"error": "bad json"}, 400)
        if u.path == "/send":
            to = data.get("to", "")
            frm, frm_id = data.get("from", "unknown"), data.get("from_id", "")
            body = data.get("body", "")
            match = [a for a in all_agents() if a["name"] == to]
            if not match:
                # No live peer by that name. If a PAST session used it, park a
                # handoff that delivers whenever it's revived (ignored if it never
                # returns). A name no session ever had is a typo -> 404.
                dead = _dead_id_for_name(to)
                if dead:
                    deliver(dead, frm, frm_id, body, park=True)
                    return self._send({"ok": True, "to": to, "parked": True})
                return self._send({"error": "no live romp session named '%s'" % to}, 404)
            a0 = match[0]
            mid = deliver(a0["id"], frm, frm_id, body)
            if not a0.get("remote", False):
                # Paint a sender-coloured badge into the recipient's status bar...
                _set_mail_badge(a0["name"], frm, frm_id)
                # ...record correspondence (peer line) + directional top-line prefix...
                threading.Thread(target=_on_deliver, args=(a0["name"], a0["id"], frm, frm_id, data.get("body", ""), mid),
                                 daemon=True).start()
                # ...and auto-wake it if it's idle, typing the mail into its prompt
                # (off-thread so send latency stays low).
                threading.Thread(target=_push, args=(a0["name"], a0["id"], False),
                                 daemon=True).start()
            return self._send({"ok": True, "to": to})
        if u.path == "/recall":
            frm_id = data.get("from_id", "")
            if not frm_id:
                return self._send({"error": "missing from_id"}, 400)
            removed = _recall(frm_id, data.get("to", ""), data.get("id", ""))
            return self._send({"ok": True, "removed": removed})
        if u.path == "/wake":
            sid = data.get("id", "")
            if sid and _safe_id(sid):                         # force-deliver on revive once the prompt is live
                threading.Thread(target=_wake_when_ready, args=(sid,), daemon=True).start()
            return self._send({"ok": True})
        if u.path == "/heartbeat":
            sid = data.get("id")
            if sid and _safe_id(sid):
                HEARTBEATS[sid] = (data.get("name", "?"), time.time())
            return self._send({"ok": True})
        self._send({"error": "not found"}, 404)

def _log(msg):
    try:
        sys.stderr.write("[postal] %s\n" % msg)
        sys.stderr.flush()
    except Exception:
        pass

def _monitor(httpd):
    idle = 0
    while True:
        time.sleep(POLL)
        try:
            _sweep_orphans()    # bounce mail stuck unread in dead recipients' mailboxes
        except Exception:
            pass
        try:
            n = present_count()
        except Exception:
            n = 1   # on error, err on the side of staying up
        if n <= 0:
            idle += 1
            if idle >= IDLE_GRACE:
                _log("no romp clients remain; shutting down")
                threading.Thread(target=httpd.shutdown, daemon=True).start()
                return
        else:
            idle = 0

def _retry_pending():
    """RETRY deferred deliveries — the fix for stranded mail. _push (and the revive
    wake) are single-shot: when they can't safely inject (a resume-from-summary
    picker, a permission dialog, a prompt not yet at ❯), they correctly DEFER and
    leave the mail in new/. But an IDLE recipient then has no Stop hook to trigger
    the drain, so the mail strands until something else happens to arrive. Here the
    bus periodically re-attempts delivery for every session that still has pending
    mail (marker present) and is live; _push re-checks safety each pass and injects
    the moment the block clears and the session is at a clean ❯ prompt. This makes
    delivery EVENTUAL rather than single-shot — covering both the revive-picker race
    and the live-idle-behind-a-permission-dialog case. Honors 'don't wake unless
    needed': only sessions that actually hold mail are touched, and _push still only
    injects at a safe idle/working ❯ prompt (never mid permission dialog or over a
    draft it can't preserve). A dead session's marker is skipped (its mail waits for
    revival); a stale marker (new/ already empty) is reconciled away."""
    if not MAILPENDING.is_dir():
        return
    live = {a["id"]: a["name"] for a in local_agents()}
    for m in list(MAILPENDING.iterdir()):
        if not m.is_file():
            continue
        sid = m.name
        newd = MAILROOT / sid / "new"
        if not (newd.is_dir() and any(newd.iterdir())):
            _mark_pending(sid)                 # stale marker -> clear it
            continue
        if sid in live:
            try:
                _push(live[sid], sid, False)   # re-attempt; _push defers again if still unsafe
            except Exception as e:
                _log("retry push to %s failed: %s" % (live[sid], e))

def _retry_loop():
    while True:
        time.sleep(RETRY_INTERVAL)
        try:
            _retry_pending()
        except Exception:
            pass

def _reconcile_markers():
    """One-time sync of every pending-mail marker to the actual new/ boxes — so mail
    that predates the marker feature (or any drift) is corrected on bus startup."""
    if not MAILROOT.is_dir():
        return
    try:
        for box in MAILROOT.iterdir():
            if box.is_dir():
                _mark_pending(box.name)
    except Exception as e:
        _log("marker reconcile failed: %s" % e)

def serve():
    STATE.mkdir(parents=True, exist_ok=True)
    MAILROOT.mkdir(parents=True, exist_ok=True)
    _reconcile_markers()
    try:
        httpd = ThreadingHTTPServer((HOST, PORT), Handler)
    except OSError as e:
        _log("bus already running on %d (%s)" % (PORT, e))
        return 0
    try:
        PIDFILE.write_text(str(os.getpid()))
    except Exception:
        pass
    _log("bus up on %s (pid %d)" % (BASE, os.getpid()))
    threading.Thread(target=_monitor, args=(httpd,), daemon=True).start()
    threading.Thread(target=_retry_loop, daemon=True).start()   # re-deliver deferred/stranded mail
    try:
        httpd.serve_forever()
    finally:
        try:
            if PIDFILE.exists() and PIDFILE.read_text().strip() == str(os.getpid()):
                PIDFILE.unlink()
        except Exception:
            pass
    return 0

# ───────────────────────── client (talks to the bus) ─────────────────────────

class BusError(Exception):
    pass

def _http(method, path, payload=None):
    data = json.dumps(payload).encode() if payload is not None else None
    headers = {"Content-Type": "application/json"} if data else {}
    req = urllib.request.Request(BASE + path, data=data, method=method, headers=headers)
    try:
        with urllib.request.urlopen(req, timeout=5) as r:
            return json.loads(r.read().decode() or "{}")
    except urllib.error.HTTPError as e:
        try:
            msg = json.loads(e.read().decode()).get("error", str(e))
        except Exception:
            msg = str(e)
        raise BusError(msg)
    except urllib.error.URLError as e:
        raise BusError("can't reach the Romp Postal Service bus at %s (%s)" % (BASE, getattr(e, "reason", e)))
    except Exception as e:
        raise BusError(str(e))

def ping():
    try:
        _http("GET", "/ping")
        return True
    except Exception:
        return False

CLIENT_ONLY = Path.home() / ".config/romp-postal/client-only"

def is_client_only():
    return bool(os.environ.get("ROMP_POSTAL_CLIENT_ONLY")) or CLIENT_ONLY.exists()

def looks_remote():
    # Heuristic: this shell reached the machine over SSH. Used only for advisory
    # nudges and `romp --mail remote` role detection — never to change delivery.
    return bool(os.environ.get("SSH_CONNECTION") or os.environ.get("SSH_TTY"))

def _unreachable_hint():
    if is_client_only() or looks_remote():
        return "can't reach your laptop's Romp Postal Service bus — is the SSH tunnel up? run: romp --mail remote"
    return "can't reach the Romp Postal Service bus (see ~/.local/state/romp/postal/server.log)"

def _remote_nudge():
    # On a remote machine not yet pointed at the laptop's bus, the local bus is
    # isolated; nudge toward `romp --mail remote` (advisory, on stderr only).
    if looks_remote() and not is_client_only():
        sys.stderr.write("[romp mail] you look like a remote machine on a local-only "
                         "Romp Postal Service — run `romp --mail remote` to reach your laptop's sessions.\n")

def ensure():
    """Make sure the bus is reachable. On a designated client-only host (remote),
    rely on the ssh tunnel rather than starting a local bus."""
    if ping():
        return True
    if is_client_only():
        return ping()
    STATE.mkdir(parents=True, exist_ok=True)
    logf = open(LOG, "a")
    subprocess.Popen([sys.executable, os.path.abspath(__file__), "serve"],
                     stdout=logf, stderr=logf, stdin=subprocess.DEVNULL, start_new_session=True)
    for _ in range(40):           # ~4s
        if ping():
            return True
        time.sleep(0.1)
    return ping()

def _heartbeat(sid, name):
    if sid:
        try:
            _http("POST", "/heartbeat", {"id": sid, "name": name or "?"})
        except Exception:
            pass

# ───────────────────────── stdio MCP server ─────────────────────────

# Server-level instructions, surfaced to the model by MCP clients at initialize.
# This is the self-contained copy of the messaging norms: it ships with the
# software, so sessions get them even without any global CLAUDE.md.
MCP_INSTRUCTIONS = """\
Norms for messaging peer sessions. A peer shares none of your context — only the bytes you send.

KEEP EXCHANGES TIGHT. Message a peer only with something substantive: a question, information they need, or a result worth sharing. Never reply just to acknowledge; a message wakes the recipient and costs it a whole turn. Stop once the exchange has served its purpose.

WRITE SO THE RECIPIENT CAN ACT FROM YOUR FIRST LINE.
- Lead with intent: start the body with ASK: (do this), Q: (answer me), FYI: (no reply needed), or HANDOFF:.
- First sentence = the whole point: the conclusion or ask itself, not the story of how you got there. Context after, only as much as the recipient needs to act.
- Name things exactly: files by path, sessions by name, the same term every time — never "the thing", a synonym, or a codename you invented mid-task.
- Match wording to evidence: "verified X (repro'd)" and "suspect Y (untested)" are different claims — make established vs. guessed legible from the words alone. When relaying, say whose ask or decision it is (the human's, yours, a peer's).
- End with the response you need, or that none is.
- Cut words, not information: one point per message; routine coordination is 1-3 lines, a handoff can be long. When brevity and clarity conflict, clarity wins.

COORDINATE BEFORE PARALLEL EDITS. Before editing a shared repo, run list_agents to see peers' working-notes and branches (file overlap only collides on the SAME branch), and publish your own with set_working. When handing off or working alongside a peer, declare ownership in your first line ("I own files A/B — stay off them"). Use check_sent to see if a message was read instead of asking "did you get it?". Confirm substantive coordination (a handoff plan, an ownership boundary) — never just to acknowledge.

If you message a session that has been killed, it is parked as a handoff: delivered if that session is ever revived, ignored otherwise — and its responsibility is yours now. If YOU are a revived session, mail flagged "parked" may be stale: reconcile before assuming your old task still stands.
"""

MCP_TOOLS = [
    {"name": "send_message",
     "description": "Send a message to another romp session by its name. A live recipient gets it at the end of its current turn. The recipient shares none of your context, so lead the body with ASK:/Q:/FYI:/HANDOFF: and put the whole point in the first sentence — context after, only what's needed to act. If you name a session that has been KILLED (but really existed), the message is PARKED as a handoff: it waits on disk and is delivered the instant that session is ever revived (even days later), or ignored if it never returns — useful for telling a dead session you've taken over its work. The response says whether it was delivered or parked. A name no session ever had still errors. Use list_agents to see who's live.",
     "inputSchema": {"type": "object",
                     "properties": {"to": {"type": "string", "description": "recipient romp session name"},
                                    "body": {"type": "string", "description": "message text"}},
                     "required": ["to", "body"]}},
    {"name": "check_inbox",
     "description": "Read and clear any messages other romp sessions have sent you. Messages are also delivered automatically at the end of each turn, so you rarely need to call this.",
     "inputSchema": {"type": "object", "properties": {}}},
    {"name": "list_agents",
     "description": "List the live romp sessions you can message (yours is marked), with each one's git branch and what it's currently working on — check this before editing shared files to avoid collisions.",
     "inputSchema": {"type": "object", "properties": {}}},
    {"name": "set_working",
     "description": "Publish what you're currently working on (files / surface) so peers see it in list_agents and steer clear. Your git branch is shown automatically. Pass empty text to clear when done.",
     "inputSchema": {"type": "object",
                     "properties": {"text": {"type": "string", "description": "short note, e.g. 'editing scripts/romp-postal + tmux.conf'"}}}},
    {"name": "check_sent",
     "description": "See your recently sent messages and whether each was read/acted on by the recipient yet, or is still pending — instead of asking 'did you get it?'.",
     "inputSchema": {"type": "object", "properties": {}}},
    {"name": "recall_message",
     "description": "Unsend a message you sent that the recipient HASN'T read yet — still queued, or PARKED for a dead session. Deletes it from their mailbox so a now-stale ask never lands (e.g. the task became moot, or you're superseding it). Give 'to' (the recipient) to recall your unread message(s) to them; add 'id' (from check_sent) to target one specific message. Only your OWN, still-UNREAD messages can be recalled — anything already read is gone. Returns what was removed.",
     "inputSchema": {"type": "object",
                     "properties": {"to": {"type": "string", "description": "recipient session name (or UUID) whose queued message(s) from you to cancel"},
                                    "id": {"type": "string", "description": "optional specific message id (from check_sent) to recall just that one"}}}},
    {"name": "find_sessions",
     "description": "Search PAST and present romp sessions by their saved Haiku summaries (what each one asked + did), plus name and directory — to find a session with expertise or context worth reusing. Returns matching sessions (alive ● / dead ○) with directory, last-active time, UUID, and the matching summary snippets. Omit the query to list the most recent sessions. Read-only; follow up with revive_session to wake a dead one.",
     "inputSchema": {"type": "object",
                     "properties": {"query": {"type": "string", "description": "keywords describing the expertise/topic you're after; omit to list recent sessions"}}}},
    {"name": "revive_session",
     "description": "Bring a DEAD romp session back to life — resumes its full conversation in its original directory, reusing its name + identity colour, and it rejoins list_agents. It comes back IDLE (does nothing until messaged). Use after find_sessions to recruit a past session's expertise, or to hand a revived session back its responsibility. Pass an optional 'message' (e.g. 'ASK: ...') to tell it why it was woken — delivered as it finishes loading. Naming a session that's already live is a no-op (just routes your message). Spawns a process, so the human is asked to approve.",
     "inputSchema": {"type": "object",
                     "properties": {"session": {"type": "string", "description": "the session name (or UUID) to revive"},
                                    "message": {"type": "string", "description": "optional note delivered to it on wake, e.g. 'ASK: take back the build'"}},
                     "required": ["session"]}},
]

def _mcp_call(name, args):
    me, mid = my_name(), my_id()
    _heartbeat(mid, me)
    if name == "send_message":
        to, body = args.get("to", ""), args.get("body", "")
        if not to or not body:
            return "Need both 'to' and 'body'.", True
        try:
            res = _http("POST", "/send", {"to": to, "from": me or "unknown", "from_id": mid or "", "body": body})
            if res.get("parked"):
                return ("'%s' isn't running right now, so I parked this as a handoff. It'll be "
                        "delivered the instant that session is revived — even days later — and "
                        "is simply ignored if it never comes back. Treat its responsibility as "
                        "yours now." % to), False
            return "Delivered to '%s'." % to, False
        except BusError as e:
            return str(e), True
    if name == "check_inbox":
        if not mid:
            return "Not inside a romp session.", True
        msgs = _http("GET", "/inbox?id=%s" % urllib.parse.quote(mid)).get("messages", [])
        return (format_inbox(msgs) or "No new messages."), False
    if name == "list_agents":
        res = _http("GET", "/agents?me=%s" % urllib.parse.quote(me or ""))
        return format_agents(res.get("agents", []), me), False
    if name == "set_working":
        if not me:
            return "Not inside a romp session.", True
        text = args.get("text", "")
        tmux("set", "-t", me, "@romp-working", text)
        return ("Cleared your 'working on' note." if not text.strip()
                else "Published — others see: working on '%s'." % text), False
    if name == "check_sent":
        if not mid:
            return "Not inside a romp session.", True
        recs = _http("GET", "/sent?id=%s" % urllib.parse.quote(mid)).get("sent", [])
        return format_receipts(recs), False
    if name == "recall_message":
        to, rid = args.get("to", ""), args.get("id", "")
        if not to and not rid:
            return "Give 'to' (the recipient) and/or 'id' to recall.", True
        if not mid:
            return "Not inside a romp session.", True
        removed = _http("POST", "/recall", {"from_id": mid, "to": to, "id": rid}).get("removed", [])
        if not removed:
            return ("Nothing to recall — no unread message from you matched "
                    "(it was already read, or nothing's queued there).", False)
        lines = ["Recalled %d message(s) before they were read:" % len(removed)]
        for r in removed:
            lines.append("  ✕ to %s: %s" % (r["to"], r["body"]))
        return "\n".join(lines), False
    if name == "find_sessions":
        q = args.get("query", "")
        ranked, fb = _find_sessions(q)
        return format_find(ranked, q, fb, mid), False
    if name == "revive_session":
        target = args.get("session", "") or args.get("name", "")
        if not target:
            return "Need 'session' — the name or UUID to revive.", True
        ok, sid, rname, already, detail = _revive(target)
        if not ok:
            return detail, True
        msg = args.get("message", "")
        note = ""
        if msg:
            try:
                res = _http("POST", "/send", {"to": rname, "from": me or "unknown",
                                              "from_id": mid or "", "body": msg})
                if already:
                    note = (" It was parked (delivers on its next revival)." if res.get("parked")
                            else " Your message was delivered.")
                else:
                    note = " Your message will reach it as it finishes loading."
            except BusError as e:
                note = " (couldn't deliver your message: %s)" % e
        if already:
            return ("'%s' is already running.%s" % (rname, note)), False
        return ("Reviving '%s' (uuid %s) in the background — it'll appear in list_agents shortly "
                "and comes back idle until messaged.%s" % (rname, sid[:8], note)), False
    return "Unknown tool: %s" % name, True

def mcp():
    """Hand-rolled stdio MCP server (newline-delimited JSON-RPC). stdout carries
    ONLY protocol messages; everything else goes to stderr."""
    ensure()
    out = sys.stdout

    def reply(obj):
        out.write(json.dumps(obj) + "\n")
        out.flush()

    for line in sys.stdin:
        line = line.strip()
        if not line:
            continue
        try:
            msg = json.loads(line)
        except Exception:
            continue
        mid_ = msg.get("id")
        method = msg.get("method")
        try:
            if method == "initialize":
                pv = (msg.get("params") or {}).get("protocolVersion", "2025-06-18")
                reply({"jsonrpc": "2.0", "id": mid_, "result": {
                    "protocolVersion": pv,
                    "capabilities": {"tools": {}},
                    "instructions": MCP_INSTRUCTIONS,
                    "serverInfo": {"name": "romp-postal", "version": "1.0"}}})
            elif method == "notifications/initialized":
                pass   # notification: no response
            elif method == "ping":
                reply({"jsonrpc": "2.0", "id": mid_, "result": {}})
            elif method == "tools/list":
                reply({"jsonrpc": "2.0", "id": mid_, "result": {"tools": MCP_TOOLS}})
            elif method == "tools/call":
                params = msg.get("params") or {}
                text, is_err = _mcp_call(params.get("name", ""), params.get("arguments") or {})
                reply({"jsonrpc": "2.0", "id": mid_, "result": {
                    "content": [{"type": "text", "text": text}], "isError": is_err}})
            elif mid_ is not None:
                reply({"jsonrpc": "2.0", "id": mid_, "error": {"code": -32601, "message": "method not found: %s" % method}})
        except Exception as e:
            _log("mcp error on %s: %s" % (method, e))
            if mid_ is not None:
                reply({"jsonrpc": "2.0", "id": mid_, "result": {
                    "content": [{"type": "text", "text": "internal error: %s" % e}], "isError": True}})
    return 0

# ───────────────────────── CLI client modes ─────────────────────────

def cli_send(argv):
    if len(argv) < 2:
        sys.stderr.write('usage: romp --mail send <session> <text>\n'); return 2
    to, body = argv[0], " ".join(argv[1:])
    if not body.strip():
        sys.stderr.write("[romp mail] refusing to send an empty message\n"); return 2
    if not ensure():
        sys.stderr.write("[romp mail] %s\n" % _unreachable_hint()); return 1
    me, mid = my_name(), my_id()
    try:
        res = _http("POST", "/send", {"to": to, "from": me or "unknown", "from_id": mid or "", "body": body})
    except BusError as e:
        sys.stderr.write("[romp mail] %s\n" % e); return 1
    if res.get("parked"):
        print("[romp mail] '%s' is offline — parked as a handoff; it'll be delivered on revival (ignored if it never returns)." % to)
    else:
        print("[romp mail] delivered to '%s'" % to)
    return 0

def cli_inbox(peek=False):
    if not ensure():
        sys.stderr.write("[romp mail] %s\n" % _unreachable_hint()); return 1
    mid = my_id()
    if not mid:
        sys.stderr.write("[romp mail] can't tell which session this is (are you in a romp session?)\n"); return 1
    try:
        res = _http("GET", "/inbox?id=%s&peek=%d" % (urllib.parse.quote(mid), 1 if peek else 0))
    except BusError as e:
        sys.stderr.write("[romp mail] %s\n" % e); return 1
    text = format_inbox(res.get("messages", []))
    if text:
        print(text)
    return 0

def cli_agents():
    if not ensure():
        sys.stderr.write("[romp mail] %s\n" % _unreachable_hint()); return 1
    me = my_name()
    try:
        res = _http("GET", "/agents?me=%s" % urllib.parse.quote(me or ""))
    except BusError as e:
        sys.stderr.write("[romp mail] %s\n" % e); return 1
    print(format_agents(res.get("agents", []), me))
    return 0

def cli_working(argv):
    name = my_name()
    if not name:
        sys.stderr.write("[romp mail] not in a romp session\n"); return 1
    text = " ".join(argv)
    tmux("set", "-t", name, "@romp-working", text)
    print("[romp mail] working: %s" % (text or "(cleared)"))
    return 0

def cli_sent():
    if not ensure():
        sys.stderr.write("[romp mail] %s\n" % _unreachable_hint()); return 1
    mid = my_id()
    if not mid:
        sys.stderr.write("[romp mail] not in a romp session\n"); return 1
    try:
        recs = _http("GET", "/sent?id=%s" % urllib.parse.quote(mid)).get("sent", [])
    except BusError as e:
        sys.stderr.write("[romp mail] %s\n" % e); return 1
    print(format_receipts(recs))
    return 0

def cli_recall(argv):
    if not argv:
        sys.stderr.write("usage: romp --mail recall <to> [id]\n"); return 2
    to, rid = argv[0], (argv[1] if len(argv) > 1 else "")
    if not ensure():
        sys.stderr.write("[romp mail] %s\n" % _unreachable_hint()); return 1
    try:
        removed = _http("POST", "/recall", {"from_id": my_id() or "", "to": to, "id": rid}).get("removed", [])
    except BusError as e:
        sys.stderr.write("[romp mail] %s\n" % e); return 1
    if not removed:
        print("[romp mail] nothing to recall (already read, or none queued to '%s')" % to)
    else:
        print("[romp mail] recalled %d message(s) to '%s' before they were read" % (len(removed), to))
    return 0

def cli_find(argv):
    q = " ".join(argv)
    ranked, fb = _find_sessions(q)
    print(format_find(ranked, q, fb, my_id()))
    return 0

def cli_revive(argv):
    if not argv:
        sys.stderr.write("usage: romp --mail revive <name|uuid> [message...]\n"); return 2
    target, msg = argv[0], " ".join(argv[1:])
    ok, sid, rname, already, detail = _revive(target)
    if not ok:
        sys.stderr.write("[romp mail] %s\n" % detail); return 1
    if msg:
        ensure()
        try:
            _http("POST", "/send", {"to": rname, "from": my_name() or "unknown",
                                    "from_id": my_id() or "", "body": msg})
        except BusError as e:
            sys.stderr.write("[romp mail] revived, but message failed: %s\n" % e)
    if already:
        print("[romp mail] '%s' is already running%s" % (rname, " (message sent)" if msg else ""))
    else:
        print("[romp mail] reviving '%s' (%s) in the background%s"
              % (rname, sid[:8], " — message will reach it on load" if msg else ""))
    return 0

def cli_wake(argv):
    # For the SessionStart revive hook: ask the bus to force-deliver pending mail
    # once this reviving session's prompt is live. Non-blocking (bus does the wait).
    sid = None
    if "--id" in argv:
        i = argv.index("--id")
        sid = argv[i + 1] if i + 1 < len(argv) else None
    sid = sid or my_id()
    if not sid or not ensure():
        return 0
    try:
        _http("POST", "/wake", {"id": sid})
    except Exception:
        pass
    return 0

def _argval(argv, flag):
    if flag in argv:
        i = argv.index(flag)
        return argv[i + 1] if i + 1 < len(argv) else None
    return None

def cli_picker_check(argv):
    """Backgrounded by `romp` on RESUME (romp-postal picker-check --name N --id S).
    Claude's "resume as-is / from summary" PICKER blocks before the session starts,
    so NO Claude hook fires while it's up — an external watcher is the only way to
    surface it. Poll up to PICKER_GRACE: if the session reaches a normal @claude-state
    or a real ❯ prompt, it's fine (past/no picker). If the picker is visibly up
    (no ❯ + mentions a summary), set @claude-state=picker and append a 'picker'
    state event so the feed shows it as NEEDS INPUT. We deliberately do NOT answer
    the picker (guessing keys / 'from summary' loses context); the user clears it and
    the normal hooks overwrite the state on the next transition."""
    name, sid = _argval(argv, "--name"), _argval(argv, "--id")
    if not name or not sid:
        return 0
    deadline = time.time() + PICKER_GRACE
    while time.time() < deadline:
        if tmux("show", "-t", name, "-v", "@claude-state").strip() in _NORMAL_STATES:
            return 0                                  # real state reached -> past/no picker
        cap = _capture(name)
        if _is_prompt_box(cap):
            return 0                                  # real prompt up -> fine
        tier = _picker_tier(cap)
        if tier:                                      # confirmed blocking picker -> surface it
            tmux("set", "-t", name, "@claude-state", "picker")
            try:
                STATESDIR.mkdir(parents=True, exist_ok=True)
                with open(STATESDIR / (sid + ".jsonl"), "a") as fh:
                    # tier is additive to tmux-status.sh's {t,state} schema (consumers
                    # ignore it); lets us spot CLI label drift (only-loose-ever-fires).
                    fh.write(json.dumps({"t": int(time.time()), "state": "picker", "tier": tier}) + "\n")
            except Exception as e:
                _log("picker-check log failed for %s: %s" % (name, e))
            return 0
        time.sleep(0.5)
    return 0                                           # never confirmed a picker (slow load / unknown) -> leave it

def cli_drain(argv):
    # For the Stop hook. --id is authoritative (from Claude's hook payload).
    sid = None
    if "--id" in argv:
        i = argv.index("--id")
        sid = argv[i + 1] if i + 1 < len(argv) else None
    sid = sid or my_id()
    if not sid:
        return 0
    if not ensure():
        return 0
    try:
        res = _http("GET", "/drain?id=%s" % urllib.parse.quote(sid))
    except Exception:
        return 0
    text = format_inbox(res.get("messages", []))
    if text:
        print(text)
    return 0

def setup_remote(force=False):
    """Point THIS machine at the laptop's Romp Postal Service over an SSH reverse
    tunnel: configure the client side automatically, then guide + verify the one
    manual step (the tunnel, which can only be opened from the laptop)."""
    if not force and not looks_remote():
        print("This looks like your Romp Postal Service host (no SSH session detected);")
        print("the bus runs here automatically, so there's nothing to set up.")
        print("")
        print("On a REMOTE machine, run `romp --mail remote` there instead.")
        print("To make every SSH hop auto-tunnel, add to your ~/.ssh/config:")
        print("    Host <remote-host>      # or: Host *")
        print("        RemoteForward %d 127.0.0.1:%d" % (PORT, PORT))
        print("(re-run with --force if this really is a remote machine.)")
        return 0
    import signal as _sig
    if PIDFILE.exists():
        try:
            os.kill(int(PIDFILE.read_text().strip()), _sig.SIGTERM)
            print("Stopped the local-only bus that was running here (frees the port for the tunnel).")
        except Exception:
            pass
    CLIENT_ONLY.parent.mkdir(parents=True, exist_ok=True)
    CLIENT_ONLY.touch()
    print("Configured this machine as a Romp Postal Service client (it won't run its own bus).")
    if ping():
        print("Already connected to your laptop's bus at %s." % BASE)
        return cli_agents()
    host = socket.gethostname()
    print("")
    print("Now open a reverse tunnel FROM YOUR LAPTOP so this machine can reach the bus:")
    print("")
    print("  - Already SSH'd in? In that terminal press Enter, then type:  ~C")
    print("      at the `ssh>` prompt enter:  -R %d:127.0.0.1:%d" % (PORT, PORT))
    print("      (the ~ escape only works right after a newline)")
    print("  - Or reconnect with:  ssh -R %d:127.0.0.1:%d %s" % (PORT, PORT, host))
    print("  - Permanent (never again): on your LAPTOP add to ~/.ssh/config:")
    print("        Host %s" % host)
    print("            RemoteForward %d 127.0.0.1:%d" % (PORT, PORT))
    print("")
    waits = int(os.environ.get("ROMP_POSTAL_REMOTE_WAIT", "120"))
    print("Waiting for the tunnel... (Ctrl-C to stop; you can re-run anytime)")
    for _ in range(waits):
        if ping():
            print("\nConnected! You can message now:")
            return cli_agents()
        time.sleep(0.5)
    print("\nStill not connected. Open the tunnel above, then run `romp --mail remote` again.")
    return 1

USAGE = """romp-postal — the Romp Postal Service
  romp --mail send <session> <text>   message a romp session (parks a handoff if it's dead but revivable)
  romp --mail inbox                   read + clear messages sent to this session
  romp --mail peek                    show messages without clearing them
  romp --mail agents                  list romp sessions (with branch + what they're working on)
  romp --mail working <text>          publish what you're working on (empty to clear)
  romp --mail sent                    show your sent messages + whether each was read
  romp --mail recall <to> [id]        unsend an unread/parked message you sent to <to>
  romp --mail find [query]            search past+present sessions by their saved summaries
  romp --mail revive <name> [msg]     revive a dead session (resumes it; optional wake message)
  romp --mail remote                  connect this (remote) machine to your laptop's bus
(internal: serve | ensure | mcp | drain --id <id> | wake --id <id> | picker-check --name <n> --id <id>)"""

def main(argv):
    if not argv:
        print(USAGE); return 0
    cmd, rest = argv[0], argv[1:]
    if cmd == "serve":   return serve()
    if cmd == "ensure":  return 0 if ensure() else 1
    if cmd == "mcp":     return mcp()
    if cmd == "remote":  return setup_remote(force=("--force" in rest or "-f" in rest))
    if cmd == "drain":   return cli_drain(rest)
    if cmd == "wake":    return cli_wake(rest)        # SessionStart revive hook: force-deliver on resume
    if cmd == "picker-check": return cli_picker_check(rest)   # romp resume: surface a session stuck on the resume picker
    if cmd == "prune":   _reconcile_peers(); return 0   # tmux session-closed + after-rename hooks
    if cmd == "sweep":   _sweep_orphans(); return 0      # bounce orphaned mail (also runs in the monitor)
    if cmd == "retry":   _retry_pending(); return 0      # re-deliver deferred/stranded mail (also runs every RETRY_INTERVAL)
    if cmd in ("-h", "--help", "help"):
        print(USAGE); return 0
    if cmd == "send":              rc = cli_send(rest)
    elif cmd in ("inbox", "recv"): rc = cli_inbox(peek=False)
    elif cmd == "peek":            rc = cli_inbox(peek=True)
    elif cmd in ("agents", "ls"):  rc = cli_agents()
    elif cmd == "working":         rc = cli_working(rest)
    elif cmd == "sent":            rc = cli_sent()
    elif cmd == "find":            rc = cli_find(rest)
    elif cmd == "revive":          rc = cli_revive(rest)
    elif cmd == "recall":          rc = cli_recall(rest)
    else:
        sys.stderr.write("unknown command: %s\n%s\n" % (cmd, USAGE)); return 2
    _remote_nudge()
    return rc

if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
