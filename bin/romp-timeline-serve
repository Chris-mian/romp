#!/usr/bin/env python3
"""romp-timeline-serve — live server behind `romp -g`.

Serves the timeline UI at / and a freshly-built JSON payload at /data (rebuilt
per request from build_data() in prototypes/romp-timeline-data). The page polls
/data every few seconds, so the chart auto-updates and the "now" edge scrolls
forward in real time — no manual regenerate/reload.
"""
import sys, json, argparse, subprocess
import importlib.machinery, importlib.util
from pathlib import Path
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer

HERE  = Path(__file__).resolve().parent
PROTO = HERE.parent / "prototypes"
HTML  = PROTO / "romp-timeline.html"
GEN   = PROTO / "romp-timeline-data"

# Load build_data() from the (extension-less) generator. Importing it only DEFINES
# functions — the file-writing path is guarded under `if __name__ == "__main__"`.
_loader = importlib.machinery.SourceFileLoader("romp_timeline_data", str(GEN))
_spec   = importlib.util.spec_from_loader("romp_timeline_data", _loader)
_mod    = importlib.util.module_from_spec(_spec)
_loader.exec_module(_mod)
build_data = _mod.build_data

class Handler(BaseHTTPRequestHandler):
    def _send(self, code, body, ctype):
        if isinstance(body, str): body = body.encode()
        self.send_response(code)
        self.send_header("Content-Type", ctype)
        self.send_header("Content-Length", str(len(body)))
        self.send_header("Cache-Control", "no-store")
        self.end_headers()
        self.wfile.write(body)

    def do_GET(self):
        p = self.path.split("?")[0]
        if p in ("/", "/index.html"):
            try: self._send(200, HTML.read_text(), "text/html; charset=utf-8")
            except Exception as e: self._send(500, str(e), "text/plain")
        elif p == "/data":
            try: self._send(200, json.dumps(build_data()), "application/json")
            except Exception as e: self._send(500, json.dumps({"error": str(e)}), "application/json")
        else:
            self._send(404, "not found", "text/plain")

    def log_message(self, *a):
        pass  # quiet

def main():
    ap = argparse.ArgumentParser(description="Live server for the romp timeline (romp -g).")
    ap.add_argument("--port", type=int, default=8765)
    ap.add_argument("--no-open", action="store_true")
    a = ap.parse_args()
    httpd = ThreadingHTTPServer(("127.0.0.1", a.port), Handler)
    url = "http://127.0.0.1:%d/" % a.port
    print("romp timeline → %s   (live; ^C to stop)" % url)
    if not a.no_open and sys.platform == "darwin":
        try: subprocess.Popen(["open", url], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        except Exception: pass
    try: httpd.serve_forever()
    except KeyboardInterrupt: print("\nstopped.")

if __name__ == "__main__":
    main()
