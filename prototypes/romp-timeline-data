#!/usr/bin/env python3
# romp-timeline-data — dump REAL romp state for the timeline prototype.
#
# Writes prototypes/romp-timeline-data.js (window.ROMP_DATA = {...}) which the
# prototype HTML loads (a sibling <script>, so it works from file://). Re-run it
# and reload the page to refresh.
#
#   sessions : live romp tmux sessions (name, identity colour, current state)
#   turns    : working stretches — currently only the IN-PROGRESS one per session
#              ([state_since, now]); full history needs a state-transition log
#              (TODO, see activity.log).
#   messages : joined from the postal-service log (romp/timeline/messages.jsonl:
#              a "sent" + an "exec" event per id) → real sent/exec times. Falls
#              back to the maildir (exec≈sent) for anything not in the log.
#
# Only messages whose BOTH ends are live sessions are kept (they need lanes).

import json, os, re, subprocess, time
import importlib.machinery, importlib.util
from datetime import datetime
from pathlib import Path

# The ONE boundary extractor + summary binder (shared with the backfill and the vault-code JS).
# We no longer parse transcripts or bind summaries by time window here — events_for() gives the
# work-period events and attach_summaries() binds each event's request/reply phrase by id.
_evld = importlib.machinery.SourceFileLoader("romp_events", str(Path(__file__).resolve().parent.parent/"bin"/"romp-events"))
_evsp = importlib.util.spec_from_loader("romp_events", _evld)
romp_events = importlib.util.module_from_spec(_evsp); _evld.exec_module(romp_events)

HORIZON = 48 * 3600          # how far back to read transcripts (matches the slider max)
ACTIVE_STATES = ("working", "permission", "awaiting")   # active = working OR awaiting-your-input
ACTIVE_ALL = set(ACTIVE_STATES) | {"compacting"}        # + compaction (work-in-progress, not idle)
ACTIVE_LAG = 10   # s; fold a sub-blip gap into the live turn rather than splitting (see JS builder)
# Max wall-clock age for a message to still count as "in flight" (riding the live `now` edge). Older
# than this and it isn't in flight, it's stale — usually because the machine SLEPT between send and
# now. Without the cap, on WAKE the `now` jump snaps such a message's connector to the new now, drawing
# a phantom "just landed" line from a now-idle sender (the recipient's @claude-state is a stale
# 'working' across sleep, so the in-flight test passes). Mirrors the JS builder; the sleep/wake guard.
MSG_INFLIGHT_MAX = 1800   # 30 min

STATE   = Path(os.environ.get("XDG_STATE_HOME", str(Path.home()/".local/state")))/"romp"
NAMES   = STATE/"names"
MAIL    = STATE/"postal"/"mail"
MSGLOG  = STATE/"timeline"/"messages.jsonl"
MSGSUM  = STATE/"timeline"/"message-summaries.jsonl"   # Haiku summaries of message bodies
SUMMARY = STATE/"summaries"                  # per-session Haiku-summary history (romp-summarize.sh)
OUT     = Path(__file__).resolve().parent/"romp-timeline-data.js"

def tmux(*a):
    try: return subprocess.run(["tmux", *a], capture_output=True, text=True, timeout=5).stdout
    except Exception: return ""

def parse_iso(s):
    try: return int(datetime.strptime(s.strip(), "%Y-%m-%dT%H:%M:%S%z").timestamp())
    except Exception: return None

def parse_z(s):                              # transcript timestamps: ISO-8601 UTC ("…Z")
    if not s: return None
    s = s.strip().replace("Z", "+0000")
    for fmt in ("%Y-%m-%dT%H:%M:%S.%f%z", "%Y-%m-%dT%H:%M:%S%z"):
        try: return int(datetime.strptime(s, fmt).timestamp())
        except Exception: pass
    return None


_title_cache = {}   # path -> (key, title)
def custom_title(p, st):
    """The romp session NAME stamped into a transcript (custom-title line), read from a
    bounded head and cached by mtime+size. A single romp session can span several Claude
    UUIDs (a skill like the IDE / install-vscode-extension, or /clear, forks a new id);
    grouping by customTitle aggregates them instead of trusting the stale @romp-session-id."""
    key = (st.st_mtime, st.st_size)
    hit = _title_cache.get(p)
    if hit and hit[0] == key:
        return hit[1]
    title = None
    try:
        with open(p, "rb") as f:
            head = f.read(65536).decode("utf-8", "replace")
        for line in head.split("\n"):
            if not line or "custom-title" not in line:
                continue
            try:
                r = json.loads(line)
            except Exception:
                continue
            if r.get("type") == "custom-title" and r.get("customTitle"):
                title = r["customTitle"]; break
    except Exception:
        pass
    _title_cache[p] = (key, title)
    return title

def session_sids(work_dir, sid, name, now):
    """Every transcript UUID belonging to romp session `name`: its @romp-session-id plus
    any other transcript in the same project dir with the matching customTitle (a forked
    UUID). Used for both turn aggregation and summary lookup."""
    sids = [sid] if sid else []
    if not work_dir:
        return sids
    enc = re.sub(r"[/.]", "-", work_dir)
    proj = Path.home()/".claude"/"projects"/enc
    cutoff = now - HORIZON
    try:
        entries = list(proj.iterdir())
    except Exception:
        entries = []
    for fp in entries:
        if fp.suffix != ".jsonl":
            continue
        fsid = fp.stem
        if fsid == sid:
            continue
        try:
            st = fp.stat()
        except Exception:
            continue
        if st.st_mtime < cutoff:
            continue
        if name and custom_title(fp, st) == name:
            sids.append(fsid)
    return sids




def awaiting_intervals(sid, now):
    """Every [start,end] the session sat in 'permission' (AWAITING your input), from the
    state-transition log tmux-status.sh writes. A permission entry runs until the next
    transition (or now, if still awaiting). Forward-only — periods predating the log
    don't appear. Lets the timeline candy-stripe historical awaiting spans, not just now."""
    if not sid:
        return []
    p = STATE/"states"/(sid + ".jsonl")
    try:
        lines = p.read_text(errors="replace").splitlines()
    except OSError:
        return []
    ev = []
    for line in lines:
        if not line:
            continue
        try:
            o = json.loads(line)
        except Exception:
            continue
        if o.get("t") and o.get("state"):
            ev.append((int(o["t"]), o["state"]))
    ev.sort()
    cutoff = now - HORIZON
    out = []
    for i, (t, st) in enumerate(ev):
        if st != "permission":
            continue
        end = ev[i+1][0] if i + 1 < len(ev) else now
        if end < cutoff:
            continue
        out.append([max(t, cutoff), end])
    return out

def live_sessions(now):
    """Currently-running romp tmux sessions → ({name: session}, {sid: name})."""
    sessions, id2name = {}, {}
    fmt = "#{@romp}|#{session_name}|#{@romp-session-id}|#{@claude-state}|#{@claude-state-since}|#{@identity-bg}|#{@claude-summary}|#{@claude-dir}|#{@claude-context}|#{@claude-model}|#{@claude-effort}"
    for line in tmux("list-sessions", "-F", fmt).splitlines():
        p = line.split("|")
        if len(p) < 7 or p[0] != "1" or not p[1]:
            continue
        name, sid, state, since, idbg, summary = p[1], p[2], p[3], p[4], p[5], p[6]
        claude_dir = p[7] if len(p) > 7 else ""    # @claude-dir = current cwd; can drift into a subdir
        cdir = ""                                  # names-file (launch) dir = where the transcript lives
        ctxRaw = p[8] if len(p) > 8 else ""
        context = int(ctxRaw) if ctxRaw.isdigit() else None        # context-window fill %
        model = (p[9] if len(p) > 9 else "").strip()    # @claude-model e.g. "Opus 4.8" (statusline.sh publishes it)
        effort = (p[10] if len(p) > 10 else "").strip() # @claude-effort e.g. "xhigh"; may be empty for some models
        color = idbg if idbg.startswith("#") else "#888888"
        try:
            parts = (NAMES/sid).read_text().rstrip("\n").split("\t")
            if len(parts) > 2 and parts[2].startswith("#"): color = parts[2]
            if len(parts) > 1 and parts[1]: cdir = parts[1]
        except Exception:
            pass
        if not cdir: cdir = claude_dir             # fall back to @claude-dir only if names dir missing
        sessions[name] = {"name": name, "color": color, "state": state or "",
                          "since": int(since) if since.isdigit() else None, "summary": summary,
                          "id": sid, "dir": cdir, "context": context,
                          "model": model, "effort": effort, "live": True}
        if sid: id2name[sid] = name
    return sessions, id2name

def _session_turns(cdir, sids, now):
    """A session's work-period turns (across its fork UUIDs), from the SHARED extractor — each
    event already bound to its request/reply summary by id. Maps romp-events' {events, pending}
    into the turn shape the renderer reads. This replaces the old transcript_turns +
    time-window attach_summaries (no re-parsing, no _pick — id-binding is exact)."""
    out = []
    for fsid in sids:
        tp = Path.home()/".claude"/"projects"/re.sub(r"[/.]", "-", cdir)/(fsid + ".jsonl")
        ev = romp_events.events_for(fsid, str(tp), now)
        romp_events.attach_summaries(fsid, ev["events"])
        for e in ev["events"]:
            out.append({"id": e.get("id"), "start": e["t"], "end": e["end"], "prompt": e["text"], "src": e["kind"],
                        "mids": e["mids"], "pending": False,
                        "summary": e.get("summary"), "reply": e.get("reply")})
        for e in ev["pending"]:
            out.append({"id": e.get("id"), "start": e["t"], "end": e["t"], "prompt": e["text"], "src": "enqueue",
                        "mids": [], "pending": True, "summary": None, "reply": None})
    out.sort(key=lambda x: x["start"])
    return out

def _clip_turns_to_work(t, sid, now):
    """Clip each completed bar to when the session actually STOPPED working that turn. romp-events
    ends a turn at the next prompt boundary, so a session that died mid-turn and was later REVIVED
    gets its dead turn's bar stretched to the revive prompt (the next boundary, ~an hour later) —
    painting the whole dead/idle gap as one working bar. The state-transition log is ground truth for
    when the session left WORKING: cap each bar's end at the first transition out of an active state
    after the turn started. (Forward-only log: a turn predating it is left uncapped.) Mirrors the JS
    builder's firstIdleAfter clip so `romp -g` and the Obsidian/VS Code timeline agree."""
    if not sid or not t:
        return t
    try:
        lines = (STATE/"states"/(sid + ".jsonl")).read_text(errors="replace").splitlines()
    except OSError:
        return t
    ev = []
    for line in lines:
        if not line:
            continue
        try:
            o = json.loads(line)
        except Exception:
            continue
        if o.get("t") and o.get("state"):
            ev.append((int(o["t"]), o["state"]))
    ev.sort()
    if not ev:
        return t
    def first_idle_after(start):
        for ts, st in ev:
            if ts <= start:
                continue
            if st not in ACTIVE_ALL:
                return ts
        return None
    for turn in t:
        if turn["end"] <= turn["start"]:
            continue
        idle = first_idle_after(turn["start"])
        if idle is not None and idle < turn["end"]:
            turn["end"] = max(turn["start"], idle)
    return t

def _last_active_start(sid):
    """Start of the session's CURRENT contiguous active run (most recent transition INTO an active
    state from a non-active one, walking back over consecutive active states), or None if the log says
    it isn't currently active. Anchors a live bar at WHEN work resumed so a finished-then-idle turn
    never stretches across the gap to a later active run (compaction / not-yet-logged prompt). Mirrors
    the JS builder's lastActiveStart."""
    if not sid:
        return None
    try:
        lines = (STATE/"states"/(sid + ".jsonl")).read_text(errors="replace").splitlines()
    except OSError:
        return None
    ev = []
    for line in lines:
        if not line:
            continue
        try:
            o = json.loads(line)
        except Exception:
            continue
        if o.get("t") and o.get("state"):
            ev.append((int(o["t"]), o["state"]))
    ev.sort()
    if not ev or ev[-1][1] not in ACTIVE_ALL:
        return None
    i = len(ev) - 1
    while i > 0 and ev[i - 1][1] in ACTIVE_ALL:
        i -= 1
    return ev[i][0]

def _message_bodies():
    """Clean structured peer-message bodies keyed by romp-msg-id, from messages.jsonl (postal's source
    of truth). Used to replace a peer-message TURN PROMPT — extracted verbatim from the transcript by
    romp-events, banner-and-all ("####… 📬 from X · time ####…") — with the clean body, joined by the
    turn's mids. Mirrors the JS builder; the documented id-join, NOT banner-prose parsing."""
    out = {}
    try:
        for line in MSGLOG.read_text(errors="replace").splitlines():
            if not line:
                continue
            try:
                e = json.loads(line)
            except Exception:
                continue
            if e.get("ev") == "sent" and e.get("id") and isinstance(e.get("body"), str):
                out[e["id"]] = e["body"]
    except OSError:
        pass
    return out

def historical_sessions(now, live_names):
    """romp sessions (from the names/ registry) that were ACTIVE within HORIZON but
    are NOT live now — so scrolling the window back reveals them. Keyed by name;
    a name that's live, or seen more recently, wins. Turns are precomputed here."""
    cutoff = now - HORIZON
    out = {}
    if not NAMES.is_dir():
        return out
    for f in NAMES.iterdir():
        sid = f.name
        try:
            parts = f.read_text().rstrip("\n").split("\t")
        except Exception:
            continue
        name = parts[0] if parts and parts[0] else sid[:6]
        if name in live_names:
            continue
        cdir  = parts[1] if len(parts) > 1 else ""
        color = parts[2] if len(parts) > 2 and parts[2].startswith("#") else "#888888"
        if not cdir:
            continue
        # aggregate across the session's transcript UUIDs (customTitle group) — a closed
        # session whose conversation lived in a forked UUID (skill/`/ide`) has no turns in
        # its @romp-session-id transcript, so resolving by sid alone would drop it.
        sids = session_sids(cdir, sid, name, now)
        t = _session_turns(cdir, sids, now)
        if not t:
            continue
        last = max(x["end"] for x in t)
        prev = out.get(name)
        if prev and prev["_last"] >= last:
            continue
        out[name] = {"name": name, "color": color, "state": "", "since": None,
                     "summary": "", "id": sid, "dir": cdir, "live": False,
                     "_turns": t, "_last": last}
    return out

def build_data():
    """The full timeline payload — live + recently-active sessions, their turns
    (with bound summaries), and the inter-session messages. Reused by the live
    server (romp -g) and by the file generator below."""
    now = int(time.time())

    sessions, id2name = live_sessions(now)
    for name, s in historical_sessions(now, set(sessions.keys())).items():
        sessions[name] = s
        if s["id"]: id2name[s["id"]] = name

    turns = {}
    body_by_id = _message_bodies()   # clean peer-message bodies (id → body) for prompt cleanup
    for n, s in sessions.items():
        sids = session_sids(s["dir"], s["id"], n, now)
        t = s.get("_turns")
        if t is None:
            t = _session_turns(s["dir"], sids, now)
            if not t and s.get("state") == "working" and s.get("since"):
                # cap how far back the fallback bar starts — a stale state-since must not paint
                # phantom activity hours into the past (flashed a far-back bar until real turns loaded)
                t = [{"start": max(s["since"], now - 1800), "end": now, "prompt": s["summary"] or "(working…)",
                      "pending": False, "summary": None, "reply": None}]
        # clip bars to real work BEFORE the live extension below (revived-session dead-gap fix; mirrors the JS builder)
        t = _clip_turns_to_work(t, s["id"], now)
        # peer-message turns carry the raw push (banner + body) as prompt; swap in the clean structured
        # body keyed by the turn's romp-msg-id(s). No banner-prose parsing (see _message_bodies).
        for turn in t:
            for mid in (turn.get("mids") or []):
                if mid in body_by_id:
                    turn["prompt"] = body_by_id[mid]; break
        # summaries are already bound by event id inside _session_turns — no time-window attach
        # a live ACTIVE session is busy now even if its last transcript line lags — run its CURRENT
        # turn's bar to now so it matches the chip, but only when the last recorded turn IS that
        # in-progress turn. If it finished, went idle, then went active again (a /compact or a prompt
        # not yet in the transcript), the last turn ended before this run began; stretching it paints
        # the idle gap as work (the compaction / lagging-reply bug). Anchor a fresh bar at the run
        # start instead — only for real WORK; compaction/awaiting carry their own stripe. Mirrors JS.
        if s.get("live") and s.get("state") in ACTIVE_ALL:
            a_start = _last_active_start(s["id"])
            last = next((tt for tt in reversed(t) if tt["end"] > tt["start"]), None)
            if last is not None and (a_start is None or last["end"] >= a_start - ACTIVE_LAG):
                last["end"] = now
            elif s.get("state") == "working" and a_start is not None:
                t.append({"start": max(a_start, now - 1800), "end": now, "prompt": s["summary"] or "(working…)",
                          "pending": False, "summary": None, "reply": None})
        turns[n] = t

    # messages: join sent+exec from the log (real latency), maildir fallback
    sent_ev, exec_ev = {}, {}
    if MSGLOG.exists():
        for line in MSGLOG.read_text(errors="replace").splitlines():
            try: e = json.loads(line)
            except Exception: continue
            if e.get("ev") == "sent": sent_ev[e["id"]] = e
            elif e.get("ev") == "exec": exec_ev[e["id"]] = e["t"]

    msgsum = {}                                   # message id -> Haiku summary
    if MSGSUM.exists():
        for line in MSGSUM.read_text(errors="replace").splitlines():
            try: o = json.loads(line)
            except Exception: continue
            if o.get("id") and o.get("summary"): msgsum[o["id"]] = o["summary"]

    messages, seen = [], set()
    for mid, e in sent_ev.items():
        frm = id2name.get(e.get("from_id", "")) or e.get("from")
        to  = id2name.get(e.get("to_id", ""))
        if frm not in sessions or to not in sessions:   # both ends need a lane
            continue
        seen.add(mid)
        # a session messaging itself isn't a meaningful connector — drop it (a
        # renamed test session with from_id == to_id resolves both ends to one name)
        if frm == to: continue
        ex = exec_ev.get(mid)
        # exec falls back to the SEND time (never the live `now`) and hasExec records
        # whether the log actually delivered it — a delivered message must never be
        # re-derived into a fake pending-at-now state.
        messages.append({"id": mid, "from": frm, "to": to, "fromOrig": e.get("from") or frm, "sent": e["t"],
                         "exec": ex if ex else e["t"], "hasExec": ex is not None,
                         "text": (e.get("body") or "").strip()[:240],
                         "summary": msgsum.get(mid), "pending": ex is None})

    if MAIL.is_dir():
        for box in MAIL.iterdir():
            to = id2name.get(box.name)
            if not to: continue
            for sub in ("cur", "new"):
                d = box/sub
                if not d.is_dir(): continue
                for f in d.iterdir():
                    if not f.is_file() or f.name in seen: continue
                    try: txt = f.read_text(errors="replace")
                    except Exception: continue
                    head, _, body = txt.partition("\n\n")
                    meta = {}
                    for ln in head.splitlines():
                        k, _, v = ln.partition(": "); meta[k.lower()] = v
                    frm = id2name.get(meta.get("from-id", "")) or meta.get("from", "?")
                    if frm not in sessions: continue
                    if frm == to: continue   # self-message (renamed test session) — not a real connector
                    sent = parse_iso(meta.get("date", "")) or now
                    messages.append({"id": f.name, "from": frm, "to": to, "fromOrig": meta.get("from") or frm,
                                     "sent": sent, "exec": sent, "hasExec": False,
                                     "text": body.strip()[:240], "pending": sub == "new" and (now - sent) < MSG_INFLIGHT_MAX})

    # postal logs "exec" at DELIVERY (consume/paste-time); for a busy recipient that's
    # QUEUE time, NOT when the message was worked on. So a logged exec (hasExec) means
    # "landed in the recipient's input", NOT "processed". The true PROCESS-START — when
    # the message began affecting the workflow — is the recipient TURN that picked it up:
    #   1. exact id-join: its `<!-- romp-msg-id -->` marker in a typed/queued user line, OR
    #   2. text-heuristic: a turn (<=1h after send) whose prompt names the sender.
    # A message with NEITHER is only "in-flight" (rides `now`) if it PLAUSIBLY hasn't
    # been worked yet — which is true ONLY when the recipient is live + actively busy
    # AND the message arrived during/after the recipient's CURRENT turn (not overtaken
    # by a later turn it has clearly already moved past). Otherwise it was processed-
    # but-unbindable (absorbed mid-turn / a pre-marker message) or is an orphan, and
    # must NOT ride `now` (that was the old "perpetual just-landing" bug): pin it at the
    # log exec if delivered, else at its send time. hasExec alone NEVER implies pending
    # either way; pending is POSITION only (never a summary).
    # EXACT id-join: postal stamps `<!-- romp-msg-id: <id> -->` in each delivered banner, so the
    # recipient turn carries the id → its start is the true processed time. Keyed by (id, recipient)
    # so a quoted id in another session's transcript can't be mistaken for the real delivery.
    id_turn = {}
    for n, tlist in turns.items():
        for t in tlist:
            for mid in (t.get("mids") or []):
                k = (mid, n)
                if k not in id_turn or t["start"] < id_turn[k]:
                    id_turn[k] = t["start"]
    # Fallback for messages delivered before the marker existed: bounded text heuristic, <=1h after
    # send, so a prompt merely mentioning the sender can't yank exec a day forward.
    MSG_MAX_LAG = 3600
    # Each recipient's latest HANDLED moment: a real turn's process-start, or a resolved
    # enqueue's resolution time (when an absorbed/dequeued prompt was folded in). A message
    # that arrived BEFORE this has been overtaken — the recipient already moved past it, so
    # it's not pending. (Turn END is unusable here: a live turn's end is `now`, which would
    # mark everything overtaken; START + enqueue-resolution is the true "last handled".)
    latest_act = {}
    for n, tlist in turns.items():
        vals = [(t["proc"] if t.get("src") == "enqueue" else t["start"])
                for t in tlist if t.get("src") != "enqueue" or t.get("proc")]
        latest_act[n] = max(vals) if vals else 0
    matched = set()
    for mm in sorted(messages, key=lambda m: m["sent"]):
        exact = id_turn.get((mm.get("id"), mm["to"]))
        if exact is not None:
            mm["exec"] = exact; mm["pending"] = False; continue   # exact id-join → done
        rturns = [t for t in turns.get(mm["to"], []) if t.get("src") != "enqueue"]
        exec_t = None
        for t in rturns:
            key = (mm["to"], t["start"])
            if key in matched:
                continue
            if t["start"] > mm["sent"] + MSG_MAX_LAG:   # turns sorted; nothing further can match
                break
            if t["start"] >= mm["sent"] - 5 and t.get("prompt") and (mm.get("fromOrig", "") in t["prompt"] or mm["from"] in t["prompt"]):
                exec_t = t["start"]; matched.add(key); break
        if exec_t is not None:
            mm["exec"] = exec_t; mm["pending"] = False        # matched the processing turn → true process-start
            continue
        rs = sessions.get(mm["to"]) or {}
        # rides `now` only if the recipient is GENUINELY working — its active state must be FRESH, not a
        # 'working' frozen across a sleep (stale @claude-state-since), which is what snaps an old
        # message to the wake `now`.
        recip_fresh = rs.get("since") is not None and (now - rs["since"]) < MSG_INFLIGHT_MAX
        recip_busy = rs.get("live") and rs.get("state") in ACTIVE_STATES and recip_fresh
        if recip_busy and mm["sent"] >= latest_act.get(mm["to"], 0) and (now - mm["sent"]) < MSG_INFLIGHT_MAX:
            mm["exec"] = mm["sent"]; mm["pending"] = True      # genuinely in-flight (busy recipient, not overtaken) → rides `now` (but not across a sleep/wake jump)
        elif mm.get("hasExec"):
            mm["pending"] = False                              # delivered earlier but unbindable/overtaken → pin at log exec, never `now`
        else:
            mm["exec"] = mm["sent"]; mm["pending"] = False     # never delivered + not in-flight → pin at send, never `now`

    out = [{"name": s["name"], "color": s["color"], "state": s["state"],
            "live": s.get("live", True), "context": s.get("context"),
            "model": s.get("model", ""), "effort": s.get("effort", ""),  # → lane label "Opus 4.8 xhigh"
            "since": s.get("since"),                          # current awaiting stripe fallback
            "awaiting": awaiting_intervals(s.get("id"), now)} # historical AWAITING spans → candy stripes
           for s in sessions.values()]
    # Lane order: working on top, idle live below, closed (historical) at the
    # bottom; within each tier most-recently-active first.
    # STABLE order (first-seen / launch-ish) so it doesn't reshuffle as sessions
    # flip working↔idle; only grayed-out sessions (no activity in over an hour, like
    # the dashboard) sink to the bottom. Active sessions' bars run to now → never stale.
    STALE = 3600
    last_act, first_act = {}, {}
    for n, ts in turns.items():
        last_act[n] = max([t["end"] for t in ts] + [t["start"] for t in ts] + [0])
        first_act[n] = min([t["start"] for t in ts]) if ts else 9e15
    for m in messages:
        last_act[m["from"]] = max(last_act.get(m["from"], 0), m["sent"], m.get("exec", 0))
        last_act[m["to"]] = max(last_act.get(m["to"], 0), m["sent"], m.get("exec", 0))
    # A LIVE session's own state-change time counts as activity, so a freshly-started
    # session with no transcript turns yet (e.g. one that's only run /ide) isn't
    # mistaken for stale — matching the dashboard, which uses since, not turns.
    for n, s in sessions.items():
        if s.get("live") and s.get("since"):
            last_act[n] = max(last_act.get(n, 0), s["since"])
    def _stale(name): return (now - last_act.get(name, 0)) > STALE
    # three tiers (each then stable first-seen): ACTIVE live (0) on top, then ENDED sessions
    # (closed but still in-window, 1) faded in the middle, then IDLE live (>1h quiet, 2) faded
    # at the bottom. Ended + idle both dim (faded) but KEEP their identity color.
    def _tier(s):
        if not s.get("live", True): return 1
        return 2 if _stale(s["name"]) else 0
    out.sort(key=lambda s: (_tier(s), first_act.get(s["name"], 9e15)))
    for s in out:
        st = _stale(s["name"])
        s["stale"] = st
        s["faded"] = (not s.get("live", True)) or st
    return {"now": now, "sessions": out, "turns": turns, "messages": messages}

if __name__ == "__main__":
    data = build_data()
    OUT.write_text("window.ROMP_DATA = " + json.dumps(data) + ";\n")
    print("wrote %s — %d sessions, %d messages" % (OUT, len(data["sessions"]), len(data["messages"])))
